## Ignore Visual Studio temporary files, build results, and
## files generated by popular Visual Studio add-ons.

# User-specific files
*.suo
*.user
*.userosscache
*.sln.docstates

# Build results
[Dd]ebug/
[Dd]ebugPublic/
[Rr]elease/
[Rr]eleases/
x64/
x86/
bld/
[Bb]in/
[Oo]bj/
[Ll]og/

# Visual Studio cache/options directory
.vs/

# MSTest test Results
[Tt]est[Rr]esult*/
[Bb]uild[Ll]og.*

# NuGet Packages
*.nupkg


# ReSharper
_ReSharper*/
*.[Rr]e[Ss]harper
*.DotSettings.user

# JetBrains Rider
.idea/
*.sln.iml

# VS Code
.vscode/

# macOS
.DS_Store

# Windows
Thumbs.db
ehthumbs.db

# Web
**/node_modules/
**/.svelte-kit/

# Grasshopper definitions (except in example-definitions)
*.gh
*.ghx
!packages/compute-app/example-definitions/*.gh
!packages/compute-app/example-definitions/*.ghx

# Definitions config files (production, not checked in)
definitions-config.json
!packages/compute-app/example-definitions/definitions-config.json
!packages/compute-app/definitions-config.example.json
