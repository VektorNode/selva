## Ignore Visual Studio temporary files, build results, and
## files generated by popular Visual Studio add-ons.

# User-specific files
*.suo
*.user
*.userosscache
*.sln.docstates

# Build results
[Dd]ebug/
[Dd]ebugPublic/
[Rr]elease/
[Rr]eleases/
# Plugin/Releases/ is no longer committed. Release .yak/.gha artifacts are
# published to GitHub Releases + the Yak registry by
# .github/workflows/plugin-release.yml. (Previously force-included here via
# "!/Plugin/Releases/".)
x64/
x86/
bld/
[Bb]in/
!packages/cli/bin/
[Oo]bj/
[Ll]og/
*.lscache

# Visual Studio cache/options directory
.vs/

# MSTest test Results
[Tt]est[Rr]esult*/
[Bb]uild[Ll]og.*

# NuGet Packages
*.nupkg


# ReSharper
_ReSharper*/
*.[Rr]e[Ss]harper
*.DotSettings.user

# Needs to be deleted
*/**/Selva_UI/

# JetBrains Rider
.idea/
*.sln.iml

# VS Code
.vscode/

# macOS
.DS_Store

# Windows
Thumbs.db
ehthumbs.db

# Claude Code & agent config (personal/local)
.claude/*
.agents/
skills-lock.json

# ...except project skills, which are shared tooling and belong in the repo.
# Git never descends into an excluded directory, so each level must be
# re-included before the leaf negation can match.
!.claude/skills/
.claude/skills/*
!.claude/skills/rhino-mcp/

# Local environment & config files
.env
.env.local
*.local.json
fixtures/meshes/local/

# Generated by scripts/dev-provider.mjs — regenerated from scripts/dev-personas.json
scripts/.dev-caddyfile

# Local provider data directory (user-specific runtime data)
# Holds users.json, orgs/projects/definitions JSON, compute.config.json,
# and uploaded .gh files. Path matches DATA_PATH default in
# packages/selva/.env.example.
.selva-data/

# Deployment-specific PM2 process files, wherever they get dropped.
# The shipped runtime template is source, not deployment config.
**/ecosystem.config.cjs
!packages/selva/templates/ecosystem.config.cjs

# Web
**/node_modules/
**/.svelte-kit/
**/*.svelte.d.ts
**/dist/

# pnpm pack output
**/*.tgz

# Turborepo cache
.turbo/
**/.turbo/

# Test coverage + TS incremental build info
coverage/
**/coverage/
*.tsbuildinfo
**/*.tsbuildinfo

# Grasshopper definitions
*.gh
*.ghx
!examples/*.gh
!examples/*.ghx
# Unignore the Selva.GH plugin directory (case-insensitive match on Windows)
!Plugin/Selva.GH/
!Plugin/Selva.GH/**
Plugin/Selva.GH/bin/
Plugin/Selva.GH/obj/
Plugin/Selva.GH/*.lscache
!fixtures/**/*.gh
!fixtures/**/*.ghx

# Definitions config files (production, not checked in)
definitions-config.json

# Shared assets synced into each app's static/ by scripts/sync-shared-assets.js
# (canonical copy lives in assets/shared/ — see assets/shared/README.md)
packages/plugin-ui/static/baseHDR.hdr
packages/ui/static/baseHDR.hdr

# TypeDoc output — regenerate with `pnpm --filter @selvajs/compute build-docs`
packages/compute/docs/api/
packages/website/static/docs/


# Terraform
infra/terraform.tfvars
infra/.terraform/
infra/*.tfstate
infra/*.tfstate.backup
infra/.terraform.lock.hcl
**/dist/
.DS_Store

# Generated API reference (typedoc) — rebuilt by packages/website/scripts/build-api-docs.mjs
packages/compute/docs/api/
packages/website/static/docs/api/
