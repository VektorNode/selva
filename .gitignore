## Ignore Visual Studio temporary files, build results, and
## files generated by popular Visual Studio add-ons.

# User-specific files
*.suo
*.user
*.userosscache
*.sln.docstates

# Build results
[Dd]ebug/
[Dd]ebugPublic/
[Rr]elease/
[Rr]eleases/
x64/
x86/
bld/
[Bb]in/
[Oo]bj/
[Ll]og/

# Visual Studio cache/options directory
.vs/

# MSTest test Results
[Tt]est[Rr]esult*/
[Bb]uild[Ll]og.*

# NuGet Packages
*.nupkg


# ReSharper
_ReSharper*/
*.[Rr]e[Ss]harper
*.DotSettings.user

# Needs to be deleted
*/**/Selva_UI/

# JetBrains Rider
.idea/
*.sln.iml

# VS Code
.vscode/

# macOS
.DS_Store

# Windows
Thumbs.db
ehthumbs.db

# Claude Code & agent config (personal/local)
.claude/
.agents/
skills-lock.json

# Local environment & config files
.env
.env.local
*.local.json

# Local provider data directory (user-specific runtime data)
# Holds users.json, orgs/projects/definitions JSON, compute.config.json,
# and uploaded .gh files. Path matches DATA_PATH default in
# packages/compute-app/.env.example.
.selva-data/

**/ecosystem.config.cjs
# Web
**/node_modules/
**/.svelte-kit/
**/*.svelte.d.ts
**/dist/

# Turborepo cache
.turbo/
**/.turbo/

# Grasshopper definitions
*.gh
*.ghx
# Unignore the Selva.GH plugin directory (case-insensitive match on Windows)
!Plugin/Selva.GH/
!Plugin/Selva.GH/**
Plugin/Selva.GH/bin/
Plugin/Selva.GH/obj/

# Definitions config files (production, not checked in)
definitions-config.json


# Terraform
infra/terraform.tfvars
infra/.terraform/
infra/*.tfstate
infra/*.tfstate.backup
infra/.terraform.lock.hcl
**/dist/
