{
	"$schema": "https://turborepo.com/schema.json",
	"ui": "stream",
	"globalDependencies": [
		"pnpm-workspace.yaml",
		"pnpm-lock.yaml",
		"tsconfig.base.json",
		"tsconfig.node.json",
		"docs/**"
	],
	"tasks": {
		"generate": {
			"outputs": [
				"src/generated/**",
				"../../Plugin/Selva.Schema/Models/UISchema.Generated.cs",
				"../../Plugin/Selva.Schema/Constants/SchemaVersion.cs"
			],
			"inputs": ["ui-schema.json", "preset-schema.json", "scripts/**"],
			"env": ["SCHEMA_GUARD_BASE_REF"]
		},
		"build": {
			"dependsOn": ["^build"],
			"outputs": ["dist/**", "build/**", ".svelte-kit/output/**"],
			"inputs": [
				"src/**",
				"static/**",
				"package.json",
				"tsconfig.json",
				"svelte.config.js",
				"vite.config.ts",
				"vite.config.js"
			],
			"env": ["ADAPTER", "NODE_ENV", "SELVA_HMAC_KEY", "SELVA_AT_REST_KEY", "DATA_PATH"]
		},
		"check": {
			"dependsOn": ["^build"],
			"outputs": [],
			"inputs": ["src/**", "tsconfig.json", "svelte.config.js"]
		},
		"type-check": {
			"dependsOn": ["^build"],
			"outputs": [],
			"inputs": ["src/**", "tsconfig.json"]
		},
		"test": {
			"dependsOn": ["^build"],
			"outputs": [],
			"inputs": ["src/**", "tests/**", "vitest.config.ts", ".env.test"]
		},
		"test:e2e": {
			"dependsOn": ["build"],
			"outputs": ["playwright-report/**"],
			"inputs": ["src/**", "e2e/**", "playwright.config.ts"],
			"env": ["CI", "E2E_PORT"]
		},
		"dev": {
			"cache": false,
			"persistent": true,
			"dependsOn": ["^build"]
		}
	}
}
