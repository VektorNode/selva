{
  "name": "selva-monorepo",
  "version": "1.0.0",
  "description": "Selva - TypeScript/Rhino integration monorepo",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=18.0.0",
    "pnpm": ">=9.0.0"
  },
  "scripts": {
    "dev": "pnpm --filter @selva/web dev",
    "build": "pnpm --filter @selva/core build && pnpm --filter @selva/svelte-ui build && pnpm --filter @selva/web build",
    "build:all": "pnpm --filter @selva/core build && pnpm --filter @selva/svelte-ui build && pnpm --filter @selva/web build",
    "build:watch": "pnpm --filter @selva/core --parallel run dev",
    "build:web": "pnpm --filter @selva/web build",
    "preview": "pnpm --filter @selva/web preview",
    "check": "pnpm --filter ./packages --recursive run check",
    "type-check": "pnpm --filter ./packages --recursive run type-check",
    "test": "pnpm --filter ./packages --recursive run test",
    "test:watch": "pnpm --filter ./packages --recursive run test:watch",
    "lint": "eslint . --max-warnings 4000",
    "lint:fix": "eslint . --fix --max-warnings 4000",
    "format": "prettier --write \"**/*.{ts,tsx,svelte,json,yaml,md}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,svelte,json,yaml,md}\"",
    "clean:all": "pnpm clean && pnpm install && pnpm build",
    "clean": "node scripts/clean.js"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.1",
    "@typescript-eslint/eslint-plugin": "^8.47.0",
    "@typescript-eslint/parser": "^8.47.0",
    "eslint": "^9.39.1",
    "eslint-config-prettier": "^10.1.8",
    "prettier": "^3.6.2",
    "prettier-plugin-svelte": "^3.4.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.47.0"
  }
}
