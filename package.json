{
	"name": "selva-monorepo",
	"version": "1.0.0",
	"description": "Selva - TypeScript/Rhino integration monorepo",
	"private": true,
	"type": "module",
	"repository": {
		"type": "git",
		"url": "https://github.com/vektornode/selva.git"
	},
	"bugs": "https://github.com/vektornode/selva/issues",
	"homepage": "https://github.com/vektornode/selva",
	"engines": {
		"node": ">=18.0.0",
		"pnpm": ">=9.0.0"
	},
	"scripts": {
		"dev": "pnpm --filter @selvajs/builder-app dev",
		"dev:builder": "pnpm --filter @selvajs/builder-app dev",
		"dev:compute": "pnpm --filter @selvajs/compute-app dev",
		"dev:shared": "pnpm --filter @selvajs/shared dev",
		"generate": "pnpm --filter @selvajs/schemas generate:all",
		"build:platform": "pnpm --filter @selvajs/platform build && pnpm --filter @selvajs/local-provider build && pnpm --filter @selvajs/supabase-provider build",
		"build:shared": "pnpm --filter @selvajs/shared build",
		"build:builder": "pnpm --filter @selvajs/builder-app build",
		"build:compute": "pnpm --filter @selvajs/compute-app build",
		"build:all": "pnpm build:platform && pnpm build:shared && pnpm build:builder && pnpm build:compute",
		"build:plugin": "pnpm build:shared && pnpm build:builder && node scripts/build-production.js",
		"check": "pnpm -r run check",
		"type-check": "pnpm -r run type-check",
		"lint": "eslint .",
		"lint:fix": "eslint . --fix",
		"format": "prettier --write \"**/*.{ts,tsx,svelte,json,yaml,md}\"",
		"format:check": "prettier --check \"**/*.{ts,tsx,svelte,json,yaml,md}\"",
		"clean": "node scripts/clean.js",
		"rebuild": "pnpm clean && pnpm install && pnpm build:all",
		"test": "pnpm -r run test",
		"changeset": "changeset",
		"release": "pnpm build:all && changeset publish"
	},
	"devDependencies": {
		"@changesets/cli": "^2.30.0",
		"@selvajs/platform": "workspace:*",
		"@selvajs/supabase-provider": "workspace:*",
		"@selvajs/local-provider": "workspace:*",
		"@eslint/compat": "^2.0.5",
		"@eslint/js": "^9.39.4",
		"@sveltejs/adapter-auto": "catalog:",
		"@sveltejs/kit": "catalog:",
		"@sveltejs/package": "^2.5.7",
		"@sveltejs/vite-plugin-svelte": "catalog:",
		"@tailwindcss/vite": "catalog:",
		"@types/node": "catalog:",
		"@types/three": "catalog:",
		"@typescript-eslint/eslint-plugin": "^8.58.1",
		"@typescript-eslint/parser": "^8.58.1",
		"eslint": "catalog:",
		"eslint-config-prettier": "^10.1.8",
		"eslint-plugin-svelte": "^3.17.0",
		"globals": "^17.5.0",
		"prettier": "catalog:",
		"prettier-plugin-svelte": "^3.5.1",
		"prettier-plugin-tailwindcss": "^0.7.2",
		"publint": "^0.3.18",
		"svelte": "catalog:",
		"svelte-check": "catalog:",
		"tailwindcss": "catalog:",
		"three": "catalog:",
		"typescript": "catalog:",
		"typescript-eslint": "^8.58.1",
		"vite": "catalog:"
	}
}
