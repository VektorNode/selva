{
	"name": "selva-monorepo",
	"version": "1.0.0",
	"description": "Selva - TypeScript/Rhino integration monorepo",
	"private": true,
	"type": "module",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/vektornode/selva.git"
	},
	"bugs": "https://github.com/vektornode/selva/issues",
	"homepage": "https://github.com/vektornode/selva",
	"engines": {
		"node": ">=22.0.0",
		"pnpm": ">=10.0.0"
	},
	"packageManager": "pnpm@10.33.0",
	"scripts": {
		"dev:plugin": "pnpm --filter @selvajs/plugin-ui dev",
		"dev:selva": "pnpm --filter @selvajs/selva dev",
		"dev:ui": "pnpm --filter @selvajs/ui dev",
		"dev:website": "pnpm --filter @selvajs/website dev",
		"watch:ui": "pnpm --filter @selvajs/ui build:watch",
		"generate": "turbo run generate",
		"build": "turbo run build --concurrency=20",
		"build:ui": "pnpm --filter @selvajs/ui build",
		"build:plugin-ui": "turbo run build --filter=@selvajs/plugin-ui",
		"build:selva": "turbo run build --filter=@selvajs/selva",
		"build:website": "turbo run build --filter=@selvajs/website",
		"build:plugin": "turbo run build --filter=@selvajs/plugin-ui && node scripts/build-production.js",
		"release:plugin": "node scripts/release-plugin.js",
		"check": "turbo run check --concurrency=20",
		"type-check": "turbo run type-check --concurrency=20",
		"lint": "eslint . --cache --cache-location node_modules/.cache/eslint/ && pnpm --filter @selvajs/compute lint",
		"lint:fix": "eslint . --fix --cache --cache-location node_modules/.cache/eslint/ && pnpm --filter @selvajs/compute lint:fix",
		"test": "turbo run test --concurrency=20",
		"test:e2e": "turbo run test:e2e",
		"format": "prettier --write \"**/*.{ts,tsx,svelte,json,yaml,md}\"",
		"format:check": "prettier --check \"**/*.{ts,tsx,svelte,json,yaml,md}\"",
		"clean": "node scripts/clean.js",
		"rebuild": "pnpm clean && pnpm install && pnpm build",
		"changeset": "changeset",
		"release": "pnpm build && changeset publish",
		"prepare": "husky"
	},
	"pnpm": {
		"overrides": {
			"@sveltejs/kit": "2.69.1",
			"svelte": "5.56.4",
			"cookie@<0.7.0": "^0.7.2"
		},
		"peerDependencyRules": {
			"allowedVersions": {
				"@sveltejs/kit": "2.69.1"
			}
		}
	},
	"lint-staged": {
		"*.{ts,tsx,svelte}": [
			"eslint --fix",
			"prettier --write"
		],
		"packages/compute/**/*.{ts,svelte}": [
			"eslint --fix --config packages/compute/eslint.config.mjs"
		],
		"*.{json,yaml,yml,md}": [
			"prettier --write"
		]
	},
	"devDependencies": {
		"@changesets/cli": "^2.31.0",
		"@eslint/compat": "^2.0.5",
		"@eslint/js": "^10.0.1",
		"@selvajs/header-auth-provider": "workspace:*",
		"@selvajs/local-provider": "workspace:*",
		"@selvajs/platform": "workspace:*",
		"@selvajs/supabase-provider": "workspace:*",
		"@sveltejs/adapter-auto": "catalog:",
		"@sveltejs/kit": "catalog:",
		"@sveltejs/package": "^2.5.7",
		"@sveltejs/vite-plugin-svelte": "catalog:",
		"@tailwindcss/vite": "catalog:",
		"@types/node": "catalog:",
		"@types/three": "catalog:",
		"@typescript-eslint/eslint-plugin": "^8.64.0",
		"@typescript-eslint/parser": "^8.64.0",
		"eslint": "catalog:",
		"eslint-config-prettier": "^10.1.8",
		"eslint-plugin-svelte": "^3.20.0",
		"globals": "^17.5.0",
		"husky": "^9.1.7",
		"lint-staged": "^17.0.4",
		"prettier": "catalog:",
		"prettier-plugin-svelte": "^3.5.1",
		"prettier-plugin-tailwindcss": "^0.7.3",
		"publint": "^0.3.18",
		"svelte": "catalog:",
		"svelte-check": "catalog:",
		"tailwindcss": "catalog:",
		"three": "catalog:",
		"turbo": "^2.9.6",
		"typescript": "catalog:",
		"typescript-eslint": "^8.64.0",
		"vite": "catalog:"
	}
}
