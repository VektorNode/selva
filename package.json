{
	"name": "selva-monorepo",
	"version": "1.0.0",
	"description": "Selva - TypeScript/Rhino integration monorepo",
	"private": true,
	"type": "module",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/VektorNode/selva.git"
	},
	"bugs": "https://github.com/VektorNode/selva/issues",
	"homepage": "https://github.com/VektorNode/selva",
	"engines": {
		"node": ">=24.0.0",
		"pnpm": ">=11.0.0"
	},
	"packageManager": "pnpm@11.18.0+sha512.33d83c77da82f49fba836925c6f1b841181ec3132b670639bd012f7075f5c7cf634c5f870147c19aae7478fac01df09d8892e880454896edd23ee9b33757563c",
	"scripts": {
		"dev:plugin": "pnpm --filter @selvajs/plugin-ui dev",
		"dev:selva": "pnpm --filter @selvajs/selva dev",
		"dev:ui": "pnpm --filter @selvajs/ui dev",
		"dev:website": "pnpm --filter @selvajs/website dev",
		"watch:ui": "pnpm --filter @selvajs/ui build:watch",
		"generate": "turbo run generate",
		"build": "turbo run build --concurrency=20 --filter=!@selvajs/website",
		"build:ui": "pnpm --filter @selvajs/ui build",
		"build:plugin-ui": "turbo run build --filter=@selvajs/plugin-ui",
		"build:selva": "turbo run build --filter=@selvajs/selva",
		"build:website": "turbo run build --filter=@selvajs/website",
		"check:website": "turbo run check type-check --filter=@selvajs/website",
		"build:plugin": "turbo run build --filter=@selvajs/plugin-ui && node scripts/build-production.js",
		"release:plugin": "node scripts/release-plugin.js",
		"check": "turbo run check --concurrency=20 --filter=!@selvajs/website",
		"type-check": "turbo run type-check --concurrency=20 --filter=!@selvajs/website",
		"lint": "eslint . --cache --cache-strategy content --cache-location node_modules/.cache/eslint/ && pnpm --filter @selvajs/compute lint && pnpm --filter @selvajs/visualization lint",
		"lint:fix": "eslint . --fix --cache --cache-strategy content --cache-location node_modules/.cache/eslint/ && pnpm --filter @selvajs/compute lint:fix && pnpm --filter @selvajs/visualization lint:fix",
		"test": "turbo run test --concurrency=20",
		"test:e2e": "turbo run test:e2e",
		"format": "prettier --write \"**/*.{ts,tsx,svelte,json,yaml,md}\"",
		"format:check": "prettier --check \"**/*.{ts,tsx,svelte,json,yaml,md}\"",
		"clean": "node scripts/clean.js",
		"rebuild": "pnpm clean && pnpm install && pnpm build",
		"changeset": "changeset",
		"release": "turbo run build --concurrency=20 --filter=!@selvajs/website && node scripts/verify-pack.mjs && node scripts/changeset-publish.mjs",
		"prepare": "husky",
		"test:pack": "node scripts/verify-pack.mjs"
	},
	"lint-staged": {
		"*.{ts,tsx,svelte}": [
			"eslint --fix",
			"prettier --write"
		],
		"packages/compute/**/*.{ts,svelte}": [
			"eslint --fix --config packages/compute/eslint.config.mjs"
		],
		"packages/visualization/**/*.ts": [
			"eslint --fix --config packages/visualization/eslint.config.mjs"
		],
		"*.{json,yaml,yml,md}": [
			"prettier --write"
		]
	},
	"devDependencies": {
		"@changesets/cli": "^2.31.1",
		"@eslint/compat": "^2.0.5",
		"@eslint/js": "^10.0.1",
		"@selvajs/header-auth-provider": "workspace:*",
		"@selvajs/local-provider": "workspace:*",
		"@selvajs/platform": "workspace:*",
		"@selvajs/supabase-provider": "workspace:*",
		"@sveltejs/adapter-auto": "catalog:",
		"@sveltejs/kit": "catalog:",
		"@sveltejs/package": "^2.5.7",
		"@sveltejs/vite-plugin-svelte": "catalog:",
		"@tailwindcss/vite": "catalog:",
		"@types/node": "catalog:",
		"@types/three": "catalog:",
		"@typescript-eslint/eslint-plugin": "^8.65.0",
		"@typescript-eslint/parser": "^8.65.0",
		"eslint": "catalog:",
		"eslint-config-prettier": "^10.1.8",
		"eslint-plugin-svelte": "^3.22.0",
		"globals": "^17.8.0",
		"husky": "^9.1.7",
		"lint-staged": "^17.2.0",
		"prettier": "catalog:",
		"prettier-plugin-svelte": "^4.1.1",
		"prettier-plugin-tailwindcss": "^0.8.1",
		"publint": "^0.3.22",
		"svelte": "catalog:",
		"svelte-check": "catalog:",
		"tailwindcss": "catalog:",
		"three": "catalog:",
		"turbo": "^2.10.7",
		"typescript": "catalog:",
		"typescript-eslint": "^8.65.0",
		"vite": "catalog:"
	}
}
