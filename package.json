{
  "name": "selva-monorepo",
  "version": "1.0.0",
  "description": "Selva - TypeScript/Rhino integration monorepo",
  "private": true,
  "type": "module",
  "repository": {
    "type": "git",
    "url": "https://github.com/vektornode/selva.git"
  },
  "bugs": "https://github.com/vektornode/selva/issues",
  "homepage": "https://github.com/vektornode/selva",
  "engines": {
    "node": ">=18.0.0",
    "pnpm": ">=9.0.0"
  },
  "scripts": {
    "dev": "pnpm --filter @selva/frontend dev",
    "build:all": "pnpm --filter @selva/core build && pnpm --filter @selva/svelte-ui build &&  pnpm --filter @selva/frontend build",
    "build:frontend": "pnpm --filter @selva/frontend build",
    "build:plugin": "node scripts/build-production.js",
    "check": "pnpm --filter ./packages --recursive run check",
    "type-check": "pnpm --filter ./packages --recursive run type-check",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write \"**/*.{ts,tsx,svelte,json,yaml,md}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,svelte,json,yaml,md}\"",
    "clean:reinstall": "pnpm clean && pnpm install && pnpm build:all",
    "clean": "node scripts/clean.js"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.1",
    "@types/node": "^22.18.10",
    "@typescript-eslint/eslint-plugin": "^8.48.1",
    "@typescript-eslint/parser": "^8.48.1",
    "eslint": "^9.39.1",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-svelte": "^3.12.4",
    "globals": "^16.4.0",
    "prettier": "^3.7.4",
    "prettier-plugin-svelte": "^3.4.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.48.1"
  }
}
