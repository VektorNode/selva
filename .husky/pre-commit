#!/usr/bin/env sh

# Some git clients (VS Code, GitHub Desktop) launch hooks with a minimal PATH
# that lacks node/pnpm. Try to restore it before running lint-staged.
if ! command -v pnpm >/dev/null 2>&1; then
	# nvm (Windows + Unix) typically lives here
	export PATH="$HOME/.nvm/versions/node/$(ls "$HOME/.nvm/versions/node" 2>/dev/null | tail -1)/bin:$PATH"
	# Common Windows nodejs install
	[ -d "/c/Program Files/nodejs" ] && export PATH="/c/Program Files/nodejs:$PATH"
fi

# Prefer corepack-managed pnpm if available
if ! command -v pnpm >/dev/null 2>&1 && command -v corepack >/dev/null 2>&1; then
	corepack enable >/dev/null 2>&1
fi

if ! command -v pnpm >/dev/null 2>&1; then
	echo "pre-commit: pnpm not found on PATH; skipping lint-staged." >&2
	echo "  Commit from a terminal where 'pnpm' works, or add node/pnpm to your git client's PATH." >&2
	exit 0
fi

pnpm lint-staged
