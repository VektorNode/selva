# GUI git clients (VS Code, GitHub Desktop) launch hooks with a minimal PATH
# that often lacks node. Add the usual install dirs before giving up.
if ! command -v pnpm >/dev/null 2>&1; then
	for dir in "/c/Program Files/nodejs" "$HOME/.local/share/pnpm" "/usr/local/bin"; do
		[ -d "$dir" ] && PATH="$dir:$PATH"
	done
	export PATH
fi

# Fail rather than skip: silently waving a commit through defeats the hook,
# and the message is easy to miss in a GUI client.
if ! command -v pnpm >/dev/null 2>&1; then
	echo "pre-commit: pnpm not found on PATH." >&2
	echo "  Commit from a terminal where 'pnpm' works, or add node to your git client's PATH." >&2
	echo "  To bypass deliberately: git commit --no-verify" >&2
	exit 1
fi

# pnpm 11 runs an implicit install before any script when node_modules drifts
# from the lockfile. In a hook there is no TTY, so if that install wants to
# purge node_modules it aborts and takes the commit with it. Formatting staged
# files doesn't need fresh deps — run lint-staged against what's on disk.
pnpm --config.verify-deps-before-run=false lint-staged
