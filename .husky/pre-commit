. .husky/ensure-pnpm.sh

# pnpm 11 runs an implicit install before any script when node_modules drifts
# from the lockfile. In a hook there is no TTY, so if that install wants to
# purge node_modules it aborts and takes the commit with it. Formatting staged
# files doesn't need fresh deps — run lint-staged against what's on disk.
# lint-staged chunks file lists at cmd.exe's 8191-char limit, but on Windows the
# eslint.CMD/prettier.CMD shims re-expand the args with their own long node
# command line, so a full chunk overflows. Leave headroom for the shim.
pnpm --config.verify-deps-before-run=false lint-staged --max-arg-length 4000

# A malformed changeset (mixing `ignore`d and publishable packages, naming a
# package that doesn't exist) only surfaces when the release workflow runs
# `changeset version` — one CI round-trip after the commit that caused it.
# Same script CI runs, so local and CI can't disagree. Node directly rather
# than through pnpm: it's dependency-free and needs no install.
if git diff --cached --name-only --diff-filter=d \
	| grep -E '^\.changeset/[^/]+\.md$' \
	| grep -qv '^\.changeset/README\.md$'; then
	if ! node scripts/release/validate-changesets.mjs; then
		echo "pre-commit: fix the changeset above, or 'git commit --no-verify' to bypass." >&2
		exit 1
	fi
fi
