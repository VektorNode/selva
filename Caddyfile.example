# Selva Compute App - Caddy Configuration Example
# Copy this file to /etc/caddy/Caddyfile and customize for your setup

# Development / Testing (HTTP only, IP address)
:80 {
    reverse_proxy localhost:3000 {
        header_up X-Forwarded-For {http.request.remote.host}
        header_up X-Forwarded-Proto {http.request.proto}
        header_up X-Forwarded-Host {http.request.host}
        header_down Set-Cookie "(.*)" "$1; SameSite=Strict"
    }
}

# Production (HTTPS with custom domain)
# Uncomment and customize for your domain:
#
# example.com {
#     reverse_proxy localhost:3000 {
#         header_up X-Forwarded-For {http.request.remote.host}
#         header_up X-Forwarded-Proto {http.request.proto}
#         header_up X-Forwarded-Host {http.request.host}
#         header_down Set-Cookie "(.*)" "$1; SameSite=Strict"
#     }
# }
#
# Caddy will automatically obtain and renew SSL certificates via Let's Encrypt
