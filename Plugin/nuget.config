<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <!--
    <clear/> drops any sources inherited from the machine or user config. Central
    package management (Directory.Packages.props) fails restore with NU1507 as soon
    as more than one source is defined without source mapping, so a private feed in
    a contributor's ~/.nuget config would otherwise break the build for them alone.
    Every package in Directory.Packages.props comes from nuget.org.
  -->
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" protocolVersion="3" />
  </packageSources>
</configuration>
