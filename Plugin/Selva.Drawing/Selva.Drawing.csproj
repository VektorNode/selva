<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<TargetFramework>netstandard2.0</TargetFramework>
		<RootNamespace>Selva.Drawing</RootNamespace>
	</PropertyGroup>

	<ItemGroup>
		<!--
                        Release: PrivateAssets="all" stops PdfSharpCore + SharpZipLib from flowing to
                        consumers as separate sibling DLLs — they're merged into Selva.Drawing.dll by the
                        ILRepack target below. GeneratePathProperty exposes $(Pkg…) so the merge target can
                        locate the source DLLs in the NuGet cache.

                        Debug: no PrivateAssets, so the DLLs flow through the project reference to
                        Selva.GH's output and are available when Grasshopper loads the plugin. ILRepack is
                        skipped in Debug, so the separate DLLs must be present at runtime.
                        Note: on net48 (Rhino 8) a SharpZipLib version conflict with Rhino's bundled
                        v1.3.3.11 may surface in Debug — this is accepted for development builds.
                -->
                <PackageReference Include="PdfSharpCore" GeneratePathProperty="true" PrivateAssets="all" Condition="'$(Configuration)' == 'Release'" />
                <PackageReference Include="SharpZipLib" GeneratePathProperty="true" PrivateAssets="all" Condition="'$(Configuration)' == 'Release'" />
                <PackageReference Include="PdfSharpCore" Condition="'$(Configuration)' == 'Debug'" />
                <PackageReference Include="SharpZipLib" Condition="'$(Configuration)' == 'Debug'" />
                <PackageReference Include="System.Drawing.Common" />
                <!-- Provides the <ILRepack> MSBuild task used by the Release merge target below. -->
                <PackageReference Include="ILRepack.Lib.MSBuild.Task" PrivateAssets="all" Condition="'$(Configuration)' == 'Release'" />
	</ItemGroup>

	<ItemGroup>
		<EmbeddedResource Include="Fonts\Resources\*.ttf"/>
	</ItemGroup>

	<ItemGroup>
		<InternalsVisibleTo Include="Selva.Drawing.Tests" />
	</ItemGroup>

	<!--
		Release-only ILRepack: merge PdfSharpCore + ICSharpCode.SharpZipLib into
		Selva.Drawing.dll and internalize them. Rhino 8 ships an older SharpZipLib
		(v1.3.3.11) in its app base which collides with PdfSharpCore's required
		v1.4.2.13, producing intermittent FileLoadException (0x80131621) at runtime.
		Internalized types live in this assembly under their original namespaces but
		are inaccessible to other plugins, so the assembly-identity match never fires.
		Debug builds skip the merge so tests/iteration stay fast.
	-->
	<Target Name="ILRepackMergePdfSharpCore"
	        AfterTargets="Build"
	        Condition="'$(Configuration)' == 'Release'">
		<PropertyGroup>
			<_RepackOutDir>$([System.IO.Path]::GetFullPath('$(OutputPath)'))</_RepackOutDir>
			<_RepackStageDir>$([System.IO.Path]::GetFullPath('$(IntermediateOutputPath)ilrepack-stage'))\</_RepackStageDir>
			<_RepackOutput>$(_RepackOutDir)$(AssemblyName).dll</_RepackOutput>
		</PropertyGroup>
		<!--
			Stage only what we want merged. Anything in the stage dir is available to
			ILRepack as both an input and a search target; nothing from the broader NuGet
			cache leaks in, so the merge stays tight: just our primary + PdfSharpCore +
			SharpZipLib. PdfSharpCore's *other* dependencies (SixLabors.*, System.Memory,
			System.Drawing.Common, etc.) remain as plain references that consumers resolve
			the normal way.
		-->
		<ItemGroup>
			<_RepackToStage Include="$(_RepackOutDir)$(AssemblyName).dll" />
			<_RepackToStage Include="$(PkgPdfSharpCore)\lib\netstandard2.0\PdfSharpCore.dll" />
			<_RepackToStage Include="$(PkgSharpZipLib)\lib\netstandard2.0\ICSharpCode.SharpZipLib.dll" />
		</ItemGroup>

		<RemoveDir Directories="$(_RepackStageDir)" />
		<MakeDir Directories="$(_RepackStageDir)" />
		<Copy SourceFiles="@(_RepackToStage)" DestinationFolder="$(_RepackStageDir)" />

		<ItemGroup>
			<_RepackInputPrimary Include="$(_RepackStageDir)$(AssemblyName).dll" />
			<_RepackInputMerge Include="$(_RepackStageDir)PdfSharpCore.dll" />
			<_RepackInputMerge Include="$(_RepackStageDir)ICSharpCode.SharpZipLib.dll" />
			<!-- Search the stage dir first; fall back to the main bin/ for sibling reference assemblies. -->
			<_RepackSearchDirs Include="$(_RepackStageDir);$(_RepackOutDir)" />
		</ItemGroup>

		<ILRepack
			Parallel="true"
			Internalize="true"
			InputAssemblies="@(_RepackInputPrimary);@(_RepackInputMerge)"
			LibraryPath="@(_RepackSearchDirs)"
			TargetKind="Dll"
			OutputFile="$(_RepackOutput)" />
	</Target>

</Project>
