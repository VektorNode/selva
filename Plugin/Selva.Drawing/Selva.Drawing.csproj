<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<TargetFramework>netstandard2.0</TargetFramework>
		<SelvaIsExternalInit>true</SelvaIsExternalInit>
		<RootNamespace>Selva.Drawing</RootNamespace>
	</PropertyGroup>

	<ItemGroup>
		<!--
			Release: PrivateAssets="all" keeps PDFsharp and its closure out of consumers as sibling
			DLLs; the ILRepack target below merges them into Selva.Drawing.dll. GeneratePathProperty
			exposes $(Pkg…) so the merge can find them in the NuGet cache. The closure is referenced
			directly because PrivateAssets severs transitive deps, and the merge needs their paths.
			Debug: plain references, so the DLLs flow to Selva.GH's output unmerged.
		-->
		<PackageReference Include="PDFsharp" GeneratePathProperty="true" PrivateAssets="all" Condition="'$(Configuration)' == 'Release'"/>
		<PackageReference Include="Microsoft.Extensions.Logging.Abstractions" GeneratePathProperty="true" PrivateAssets="all" Condition="'$(Configuration)' == 'Release'"/>
		<PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" GeneratePathProperty="true" PrivateAssets="all" Condition="'$(Configuration)' == 'Release'"/>
		<PackageReference Include="Microsoft.Bcl.AsyncInterfaces" GeneratePathProperty="true" PrivateAssets="all" Condition="'$(Configuration)' == 'Release'"/>
		<PackageReference Include="PDFsharp" Condition="'$(Configuration)' != 'Release'"/>
		<!-- PDFsharp's package depends on Pkcs 8.0.1, which has advisories, for PdfSharp.Cryptography
		     (signing), which is neither merged nor loaded. Referencing a patched Pkcs lifts the resolved
		     version; ExcludeAssets keeps it out of the build. In Debug PDFsharp flows to consumers, so
		     this must flow too, or their restore resolves 8.0.1 again. -->
		<PackageReference Include="System.Security.Cryptography.Pkcs" ExcludeAssets="all" PrivateAssets="all" Condition="'$(Configuration)' == 'Release'"/>
		<PackageReference Include="System.Security.Cryptography.Pkcs" Condition="'$(Configuration)' != 'Release'"/>
		<!-- Not merged: PDFsharp needs System.Memory, which net48 hosts get from Selva.GH's own
		     reference and .NET hosts from the framework. -->
		<PackageReference Include="System.Memory"/>
		<PackageReference Include="System.Drawing.Common"/>
		<!-- Provides the <ILRepack> MSBuild task used by the Release merge target below. -->
		<PackageReference Include="ILRepack.Lib.MSBuild.Task" PrivateAssets="all" Condition="'$(Configuration)' == 'Release'"/>
	</ItemGroup>

	<ItemGroup>
		<EmbeddedResource Include="Fonts\Resources\*.ttf"/>
	</ItemGroup>

	<ItemGroup>
		<InternalsVisibleTo Include="Selva.Drawing.Tests" />
	</ItemGroup>

	<!--
		Release-only ILRepack: merge PDFsharp and its closure into Selva.Drawing.dll and internalize
		them. Internalized types keep their namespaces but are invisible to other plugins, so a
		different Microsoft.Extensions.Logging.Abstractions (or an older PdfSharp) loaded by Rhino or
		another plugin can never bind against ours. Debug skips the merge so iteration stays fast.
		PdfSharp.Cryptography (signing) is left out: PdfSharp.dll doesn't reference it.
	-->
	<Target Name="ILRepackMergePdfSharp"
	        AfterTargets="Build"
	        Condition="'$(Configuration)' == 'Release'">
		<PropertyGroup>
			<_RepackOutDir>$([System.IO.Path]::GetFullPath('$(OutputPath)'))</_RepackOutDir>
			<_RepackStageDir>$([System.IO.Path]::GetFullPath('$(IntermediateOutputPath)ilrepack-stage'))\</_RepackStageDir>
			<_RepackOutput>$(_RepackOutDir)$(AssemblyName).dll</_RepackOutput>
		</PropertyGroup>
		<!-- Only what is staged gets merged; nothing else from the NuGet cache leaks in. -->
		<ItemGroup>
			<_RepackMerge Include="$(PkgPDFsharp)\lib\netstandard2.0\PdfSharp.dll" />
			<_RepackMerge Include="$(PkgPDFsharp)\lib\netstandard2.0\PdfSharp.System.dll" />
			<_RepackMerge Include="$(PkgPDFsharp)\lib\netstandard2.0\PdfSharp.Shared.dll" />
			<_RepackMerge Include="$(PkgMicrosoft_Extensions_Logging_Abstractions)\lib\netstandard2.0\Microsoft.Extensions.Logging.Abstractions.dll" />
			<_RepackMerge Include="$(PkgMicrosoft_Extensions_DependencyInjection_Abstractions)\lib\netstandard2.0\Microsoft.Extensions.DependencyInjection.Abstractions.dll" />
			<_RepackMerge Include="$(PkgMicrosoft_Bcl_AsyncInterfaces)\lib\netstandard2.0\Microsoft.Bcl.AsyncInterfaces.dll" />
		</ItemGroup>

		<RemoveDir Directories="$(_RepackStageDir)" />
		<MakeDir Directories="$(_RepackStageDir)" />
		<Copy SourceFiles="$(_RepackOutDir)$(AssemblyName).dll;@(_RepackMerge)" DestinationFolder="$(_RepackStageDir)" />

		<ItemGroup>
			<_RepackInputPrimary Include="$(_RepackStageDir)$(AssemblyName).dll" />
			<_RepackInputMerge Include="@(_RepackMerge->'$(_RepackStageDir)%(Filename)%(Extension)')" />
			<!-- Search the stage dir first; fall back to the main bin/ for sibling reference assemblies. -->
			<_RepackSearchDirs Include="$(_RepackStageDir);$(_RepackOutDir)" />
		</ItemGroup>

		<!-- PdfSharp.dll and PdfSharp.Shared carry their own IsExternalInit polyfill. Left alone,
		     ILRepack renames our copy, every init setter's modreq then names an unknown type, and
		     consumers fail with CS0570. Allowing duplicates in this namespace merges the copies into
		     one; everything else in it is compiler polyfill too. -->
		<ILRepack
			Parallel="true"
			Internalize="true"
			AllowedDuplicateNamespaces="System.Runtime.CompilerServices"
			InputAssemblies="@(_RepackInputPrimary);@(_RepackInputMerge)"
			LibraryPath="@(_RepackSearchDirs)"
			TargetKind="Dll"
			OutputFile="$(_RepackOutput)" />
	</Target>

</Project>
