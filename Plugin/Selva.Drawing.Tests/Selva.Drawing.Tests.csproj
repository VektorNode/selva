<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<TargetFramework>net10.0</TargetFramework>
		<ImplicitUsings>enable</ImplicitUsings>
		<Nullable>enable</Nullable>

		<IsPackable>false</IsPackable>
		<IsTestProject>true</IsTestProject>
	</PropertyGroup>

	<!-- Release merges PDFsharp into Selva.Drawing.dll, and InternalsVisibleTo then exposes its
	     internal RuntimeHelpers polyfill here beside the BCL's. The compiler picks the BCL one. -->
	<PropertyGroup Condition="'$(Configuration)' == 'Release'">
		<NoWarn>$(NoWarn);CS1685</NoWarn>
	</PropertyGroup>

	<ItemGroup>
		<PackageReference Include="coverlet.collector"/>
		<PackageReference Include="Microsoft.NET.Test.Sdk"/>
		<PackageReference Include="Verify.Xunit"/>
		<PackageReference Include="xunit"/>
		<PackageReference Include="xunit.runner.visualstudio"/>
		<!-- No PDFsharp reference: in Debug it flows from Selva.Drawing; in Release it is
		     internalized there and visible through InternalsVisibleTo, so a direct reference
		     would make every type ambiguous (CS0433). -->
	</ItemGroup>

	<ItemGroup>
		<Using Include="Xunit"/>
	</ItemGroup>

	<ItemGroup>
		<ProjectReference Include="..\Selva.Drawing\Selva.Drawing.csproj"/>
	</ItemGroup>

	<ItemGroup>
		<None Update="Rendering\Snapshots\*.svg">
			<CopyToOutputDirectory>Always</CopyToOutputDirectory>
		</None>
	</ItemGroup>

</Project>
