<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<!-- Same split as Selva.GH: the .rhp ships in each TFM folder beside Selva.gha. -->
		<TargetFrameworks>$(SelvaTargetFrameworks)</TargetFrameworks>
		<SelvaIsExternalInit>true</SelvaIsExternalInit>
		<Nullable>enable</Nullable>
		<TargetExt>.rhp</TargetExt>
		<EnableDynamicLoading>true</EnableDynamicLoading>
		<NoWarn>NU1701</NoWarn>
		<!-- Not Selva.Panel: inside Selva.GH's namespaces that would shadow every Eto/WinForms Panel. -->
		<RootNamespace>Selva.RhinoPanel</RootNamespace>
		<Title>Selva Panel</Title>
		<Description>Hosts the Selva UI in a Rhino panel that floats or docks</Description>
	</PropertyGroup>

	<ItemGroup>
		<!-- RhinoCommon only (Eto comes with it): this plug-in must load before Grasshopper does. -->
		<PackageReference Include="RhinoCommon" VersionOverride="$(RhinoRefVersion)" ExcludeAssets="runtime"/>
	</ItemGroup>

	<ItemGroup>
		<EmbeddedResource Include="..\Selva.GH\Resources\Icons\UIBridge.png" LogicalName="Selva.Panel.Icon.png"/>
	</ItemGroup>

</Project>
