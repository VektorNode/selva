<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<TargetFrameworks>net48;net7.0;net9.0</TargetFrameworks>
		<AssemblyName>Selva</AssemblyName>
		<EnableDynamicLoading>true</EnableDynamicLoading>
		<TargetExt>.gha</TargetExt>
		<NoWarn>NU1701</NoWarn>
		<LangVersion>latest</LangVersion>
		<GenerateResourceUsePreserializedResources>true</GenerateResourceUsePreserializedResources>
		<AssemblyName>Selva</AssemblyName>
	</PropertyGroup>

	<PropertyGroup>
		<!-- Specifies information for Assembly and Yak -->
		<Version>0.10.0-beta</Version>
		<AssemblyVersion>0.10.0.0</AssemblyVersion>
		<FileVersion>0.10.0.0</FileVersion>
		<InformationalVersion>0.10.0-beta</InformationalVersion>
		<Title>Selva</Title>
		<Company>VektorNode</Company>
		<Description>Web-based UI builder for Grasshopper with real-time parameter interaction</Description>
		<Authors>Felix Brunold, VektorNode</Authors>
		<Copyright>Copyright © 2025 Selva Authors</Copyright>
	</PropertyGroup>

	<ItemGroup>
		<PackageReference Include="Grasshopper" Version="9.0.25266.10145-wip" Condition="'$(TargetFramework)' == 'net9.0'" ExcludeAssets="runtime"/>
		<PackageReference Include="Grasshopper" Version="8.0.23304.9001" Condition="'$(TargetFramework)' == 'net7.0'" ExcludeAssets="runtime"/>
		<PackageReference Include="Grasshopper" Version="8.0.23304.9001" Condition="'$(TargetFramework)' == 'net48'" ExcludeAssets="runtime"/>
		<PackageReference Include="Newtonsoft.Json" Version="13.0.3"/>
		<PackageReference Include="System.Drawing.Common" Version="8.0.0" Condition="'$(TargetFramework)' != 'net48'"/>
		<PackageReference Include="System.Net.Http" Version="4.3.4" Condition="'$(TargetFramework)' == 'net48'"/>
		<PackageReference Include="System.Resources.Extensions" Version="7.0.0"/>
		<PackageReference Include="System.Windows.Forms" Version="4.0.0"/>
		<ProjectReference Include="..\Selva.Schema\Selva.Schema.csproj"/>
		<ProjectReference Include="..\Selva.Drawing\Selva.Drawing.csproj"/>
	</ItemGroup>

	<!-- Embed web assets from the build output -->
	<ItemGroup>
		<EmbeddedResource Include="EmbeddedAssets/web/**/*" Condition="Exists('EmbeddedAssets/web/index.html')">
			<!-- Use forward slashes for cross-platform consistency -->
			<LogicalName>Selva.EmbeddedAssets.web.$([System.String]::Copy('%(RecursiveDir)').Replace('\','/'))%(Filename)%(Extension)</LogicalName>
		</EmbeddedResource>
	</ItemGroup>

	<ItemGroup>
		<Folder Include="Features/"/>
	</ItemGroup>

	<ItemGroup Condition="'$(TargetFramework)' == 'net9.0'">
		<None Update="Resources\manifest-rh9.yml">
			<CopyToOutputDirectory>Always</CopyToOutputDirectory>
			<Link>manifest.yml</Link>
		</None>
	</ItemGroup>
	<ItemGroup Condition="'$(TargetFramework)' != 'net9.0'">
		<None Update="Resources\manifest-rh8.yml">
			<CopyToOutputDirectory>Always</CopyToOutputDirectory>
			<Link>manifest.yml</Link>
		</None>
	</ItemGroup>

	<ItemGroup>
		<None Update="Resources\Icons\Icon.png">
			<CopyToOutputDirectory>Always</CopyToOutputDirectory>
			<Link>icon.png</Link>
		</None>
		<None Update="Resources\Icons\BlockToFile.png">
			<CopyToOutputDirectory>Always</CopyToOutputDirectory>
		</None>
		<None Update="Resources\Icons\DataToFile.png">
			<CopyToOutputDirectory>Always</CopyToOutputDirectory>
		</None>
		<None Update="Resources\Icons\GetValueList.png">
			<CopyToOutputDirectory>Always</CopyToOutputDirectory>
		</None>
		<None Update="Resources\Icons\ThreeMaterial.png">
			<CopyToOutputDirectory>Always</CopyToOutputDirectory>
		</None>
		<None Update="Resources\Icons\UIBridge.png">
			<CopyToOutputDirectory>Always</CopyToOutputDirectory>
		</None>
		<None Update="Resources\Icons\WebDisplay.png">
			<CopyToOutputDirectory>Always</CopyToOutputDirectory>
		</None>
		<None Update="Resources\Icons\IconPluginF4R.png">
			<CopyToOutputDirectory>Always</CopyToOutputDirectory>
		</None>
	</ItemGroup>
</Project>
