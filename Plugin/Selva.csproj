<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- Select the framework(s) you wish to target.
        Rhino 6: net45
        Rhino 7: net48
        Rhino 8 Windows: net48, net7.0, net7.0-windows, net7.0-windows10.0.22000.0, etc
        Rhino 8 Mac: net7.0, net7.0-macos, net7.0-macos12.0, etc
    -->
    <TargetFrameworks>net7.0;net48</TargetFrameworks>
    <EnableDynamicLoading>true</EnableDynamicLoading>
    <TargetExt>.gha</TargetExt>
    <NoWarn>NU1701</NoWarn>
    <LangVersion>latest</LangVersion>
  </PropertyGroup>

  <PropertyGroup>
    <!-- Specifies information for Assembly and Yak -->
    <Version>1.0.0</Version>
    <Title>Selva</Title>
    <Company>Selva Authors</Company>
    <Description>Web-based UI builder for Grasshopper with real-time parameter interaction</Description>
    <Authors>Selva Authors</Authors>
    <Copyright>Copyright © 2025 Selva Authors</Copyright>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Grasshopper" Version="8.0.23304.9001" ExcludeAssets="runtime"/>
    <PackageReference Include="Newtonsoft.Json" Version="13.0.3"/>
    <PackageReference Include="System.Drawing.Common" Version="8.0.0" Condition="'$(TargetFramework)' == 'net7.0'"/>
    <PackageReference Include="System.Windows.Forms" Version="4.0.0"/>
  </ItemGroup>

  <!-- Embed web assets from the build output -->
  <ItemGroup>
    <EmbeddedResource Include="EmbeddedAssets/web/**/*" Condition="Exists('EmbeddedAssets/web/index.html')">
      <!-- Use forward slashes for cross-platform consistency -->
      <LogicalName>Selva.EmbeddedAssets.web.$([System.String]::Copy('%(RecursiveDir)').Replace('\','/'))%(Filename)%(Extension)</LogicalName>
    </EmbeddedResource>
  </ItemGroup>

  <ItemGroup>
    <Folder Include="Features/"/>
  </ItemGroup>
</Project>
