<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<!-- .NET Framework, not Rhino's .NET: every Windows 10 and 11 has 4.8, while Rhino brings a
		     private runtime this exe couldn't start on. Nothing here loads into Rhino. -->
		<TargetFramework>net48</TargetFramework>
		<OutputType>WinExe</OutputType>
		<PlatformTarget>x64</PlatformTarget>
		<AssemblyName>SelvaApp</AssemblyName>
		<RootNamespace>Selva.App</RootNamespace>
		<Nullable>enable</Nullable>
		<ApplicationIcon>selva.ico</ApplicationIcon>
		<ApplicationManifest>app.manifest</ApplicationManifest>
		<Title>Selva</Title>
		<Description>Runs Grasshopper definitions with a Selva UI as apps, with Rhino out of sight</Description>
	</PropertyGroup>

	<ItemGroup>
		<PackageReference Include="Microsoft.Web.WebView2"/>
	</ItemGroup>

	<ItemGroup>
		<Reference Include="System.Windows.Forms"/>
		<Reference Include="System.Web.Extensions"/>
	</ItemGroup>

	<ItemGroup>
		<!-- AES-GCM doesn't exist on .NET Framework, and only the plug-in opens a definition. -->
		<Compile Remove="Format\AppFileCipher.cs"/>
		<EmbeddedResource Include="shell.html" LogicalName="Selva.App.shell.html"/>
		<EmbeddedResource Include="selva.ico" LogicalName="Selva.selva.ico"/>
		<EmbeddedResource Include="..\..\packages\plugin-ui\static\favicon\favicon.svg" LogicalName="Selva.App.logo.svg"/>
	</ItemGroup>

</Project>
