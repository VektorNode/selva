<Project>

	<!--
		Central package management: every NuGet version for Plugin/ is declared here once,
		and csprojs carry bare <PackageReference Include="..."/> with no Version.

		This exists because a split version is otherwise invisible until restore. A
		Dependabot bump (b2997c68) raised System.Drawing.Common in Selva.Drawing alone and
		left Selva.GH / Selva.Rhino behind; the result was NU1605 and a solution that would
		not restore at all. With one declaration per package that particular break cannot
		be expressed.

		Where a package genuinely needs different versions per target framework, use
		VersionOverride on the reference itself (see Grasshopper below) rather than adding
		a second entry here.
	-->
	<PropertyGroup>
		<ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
	</PropertyGroup>

	<ItemGroup>
		<!--
			Rhino 8 and Rhino 9 ship different SDKs, so these are the packages with a
			legitimate per-TFM split. References carry VersionOverride="$(RhinoRefVersion)",
			which Directory.Build.props resolves per TFM; the default here is the Rhino 8 SDK.
		-->
		<PackageVersion Include="Grasshopper" Version="$(Rhino8RefVersion)"/>
		<!-- Direct reference in Selva.Panel and Selva.PluginVerifier (elsewhere it flows
		     transitively via Grasshopper). -->
		<PackageVersion Include="RhinoCommon" Version="$(Rhino8RefVersion)"/>

		<!-- Rhino 8 loads its own 8.0; a 10.0.0.0 reference fails the whole .gha to load.
		     Rhino 9 legs override via $(DrawingCommonRefVersion). -->
		<PackageVersion Include="System.Drawing.Common" Version="8.0.0"/>

		<PackageVersion Include="Newtonsoft.Json" Version="13.0.4"/>
		<PackageVersion Include="System.Memory" Version="4.6.3"/>
		<PackageVersion Include="System.Resources.Extensions" Version="7.0.0"/>
		<PackageVersion Include="System.Windows.Forms" Version="4.0.0"/>

		<!--
			6.2.4 is the last MIT release: 6.5.0 relicensed to AGPL-3.0, which would force the whole
			plugin onto AGPL. Pinned and on Dependabot's ignore list; never raise it past 6.2.x.
		-->
		<PackageVersion Include="PDFsharp" Version="6.2.4"/>
		<!-- PDFsharp's netstandard2.0 closure, declared so Selva.Drawing can stage and merge it
		     (see the ILRepack target there). Versions are what PDFsharp 6.2.4 resolves to. -->
		<PackageVersion Include="Microsoft.Extensions.Logging.Abstractions" Version="8.0.3"/>
		<PackageVersion Include="Microsoft.Extensions.DependencyInjection.Abstractions" Version="8.0.2"/>
		<PackageVersion Include="Microsoft.Bcl.AsyncInterfaces" Version="8.0.0"/>
		<!-- Not shipped: lifts PDFsharp's transitive 8.0.1 (two advisories) to a patched release.
		     See the reference in Selva.Drawing.csproj. -->
		<PackageVersion Include="System.Security.Cryptography.Pkcs" Version="8.0.2"/>
		<PackageVersion Include="ILRepack.Lib.MSBuild.Task" Version="2.0.34"/>

		<PackageVersion Include="coverlet.collector" Version="10.1.0"/>
		<PackageVersion Include="Microsoft.NET.Test.Sdk" Version="18.11.0"/>
		<PackageVersion Include="Verify.Xunit" Version="31.12.5"/>
		<PackageVersion Include="xunit" Version="2.9.3"/>
		<PackageVersion Include="xunit.runner.visualstudio" Version="4.0.1"/>
	</ItemGroup>

</Project>
