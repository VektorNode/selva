<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<TargetFrameworks>$(SelvaTargetFrameworks)</TargetFrameworks>
		<Nullable>enable</Nullable>
		<NoWarn>NU1701</NoWarn>
		<RootNamespace>Selva.Drawing.RhinoInterop</RootNamespace>
	</PropertyGroup>

	<ItemGroup>
		<PackageReference Include="Grasshopper" VersionOverride="$(RhinoRefVersion)" ExcludeAssets="runtime"/>
		<PackageReference Include="System.Drawing.Common" Condition="'$(TargetFramework)' != 'net48'"/>
		<ProjectReference Include="..\Selva.Drawing\Selva.Drawing.csproj"/>
	</ItemGroup>

</Project>
