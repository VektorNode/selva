# Deploy settings for the Azure Compute server (gitignored copy: infra/compute/azure/.env).
# COMPUTE_ENV=infra/compute/azure/.env pnpm run compute:deploy. Variables: ../.env.example.

DEPLOY_HOST=selva-compute-az         # ssh alias (terraform output -raw ssh_config)
DEPLOY_TLS_DOMAIN=                   # terraform output -raw tls_domain
DEPLOY_PACKAGES=packages.json        # relative to this file
DEPLOY_PLUGINS=Plugin/Selva.GH/bin/Release/net10.0
DEPLOY_BUILD=dotnet build Plugin/Selva.GH/Selva.GH.csproj -c Release -f net10.0
RHINO_TOKEN=                         # Rhino licence token
SERVER_RHINO_COMPUTE_KEY=            # the key the server enforces; Selva's Compute settings must match
SERVER_IDLE_SPAN=300
SERVER_MEMORY=12g
SERVER_CACHE_LIMIT_PERCENT=60
