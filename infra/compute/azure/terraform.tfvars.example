# Copy to terraform.tfvars (gitignored).
subscription_id = "00000000-0000-0000-0000-000000000000"   # az account show --query id -o tsv
ssh_allowed_ips = ["203.0.113.7/32"]                        # your public IP
# name          = "selva-compute-az"   # resource prefix, ssh alias and DNS label
# location      = "swedencentral"
# vm_size       = "Standard_D4s_v4"
# Every deploy machine's public key, so an apply from one machine doesn't revoke another's.
ssh_public_keys = []
