# Deploy settings for Selva's own Rhino.Compute server (gitignored copy: infra/compute/.env).
# Read by `pnpm run compute:deploy` through compute.rhino3d's setup/deploy-server.sh.
# SERVER_<NAME> is the server's value for NAME, so local Compute runs are unaffected.

DEPLOY_HOST=selva-compute            # ssh alias (terraform output -raw ssh_config)
DEPLOY_TLS_DOMAIN=                   # sslip_domain output, with public_https = true
DEPLOY_PACKAGES=packages.json        # this server's Yak packages (none), relative to this file
# Selva ships as this repo's Rhino 9 build, not from Yak. Paths are relative to the repo root,
# where `pnpm run compute:deploy` runs; the build runs first and a failure aborts the deploy.
DEPLOY_PLUGINS=Plugin/Selva.GH/bin/Release/net10.0
DEPLOY_BUILD=dotnet build Plugin/Selva.GH/Selva.GH.csproj -c Release -f net10.0
RHINO_TOKEN=                         # Rhino licence token
SERVER_RHINO_COMPUTE_KEY=            # the key the server enforces; Selva's Compute settings must match
SERVER_IDLE_SPAN=300
SERVER_MEMORY=6g
SERVER_CACHE_LIMIT_PERCENT=60
