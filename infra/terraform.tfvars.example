# Copy this to terraform.tfvars and fill in your values.
# terraform.tfvars is gitignored — never commit it.

project_id   = "your-gcp-project-id"
region       = "europe-west1"
zone         = "europe-west1-d"
machine_type = "e2-medium"

ssh_user = "selva"

# ============================================================================
# GitHub PAT (required)
# ============================================================================
# Fine-grained personal access token used by the VM to:
#   1. Fetch scripts/setup.sh + scripts/setup-caddy.sh via the GitHub
#      Contents API (raw.githubusercontent.com doesn't authenticate)
#   2. Clone the private VektorNode/selva repo over HTTPS
#
# Org-level deploy keys are disabled at VektorNode, so a PAT is currently
# the only viable option for both.
#
# Create at: https://github.com/settings/personal-access-tokens/new
#   Resource owner:        VektorNode
#   Repository access:     Only select repositories → VektorNode/selva
#   Repository permissions: Contents = Read-only
#   Expiration:             90 days (only used at VM boot)
#
# An org admin may need to approve the token at
# https://github.com/organizations/VektorNode/settings/personal-access-tokens-requests
github_token = "github_pat_…"

# ============================================================================
# Domain (optional)
# ============================================================================
# Leave commented out for testing — the module auto-derives a free
# `<dashed-ip>.sslip.io` domain from the reserved static IP. Caddy gets
# a real Let's Encrypt cert. Zero DNS setup.
#
# For production, set this to a domain you own and add an A record
# pointing at the `static_ip` output after `terraform apply`.
# domain     = "app.example.dev"
# acme_email = "you@example.dev"

# Git ref to deploy (branch / tag / commit). Defaults to "main".
# Override to deploy a feature branch, e.g. "9x".
# branch = "main"
