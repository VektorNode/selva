# Selva: Caddy reference config
#
# Copy to /etc/caddy/Caddyfile and replace app.example.dev with your domain.
# Check, then reload:
#   sudo caddy validate --config /etc/caddy/Caddyfile && sudo systemctl reload caddy

# Global ACME email applies to every site below.
# Behind a CDN or load balancer, also add `servers { trusted_proxies static <ranges> }` here
# (see docs/self-hosting/deployment/reverse-proxy.md).
{
	email you@example.dev
}

app.example.dev {
	encode gzip

	# Header auth: put the forward_auth wiring and the strip-then-set SELVA-* lines here.
	# Working example: docs/self-hosting/providers/header-auth-entra.md. Leave empty otherwise.

	reverse_proxy 127.0.0.1:3000

	# The app sets nosniff, Referrer-Policy, Permissions-Policy and (in production) HSTS.
	# Caddy adds `Server: Caddy` unless removed.
	header -Server

	# Overrides the app's one-hour cache on /api/files images. Drop the rule to keep it.
	@api path /api/*
	header @api Cache-Control "no-cache, no-store, must-revalidate"

	# Caddy rejects before the app does, so this must clear COMPUTE_REQUEST_MAX_BYTES and
	# BODY_SIZE_LIMIT (both 256 MiB). A lower value caps every upload.
	request_body {
		max_size 256MiB
	}

	log {
		output file /var/log/caddy/access.log
		format json
	}
}

# Apex domains only: add `www.example.dev { redir https://example.dev{uri} permanent }`.
# For a subdomain like app.example.dev, nobody points www.app.example.dev at you and Caddy
# fails to issue its certificate on every retry.
