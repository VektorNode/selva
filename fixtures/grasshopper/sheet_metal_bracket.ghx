                <item name="Lib" type_name="gh_guid" type_code="9">6416577b-17ae-4953-8103-cf00936edbb1</item>
                <item name="Name" type_name="gh_string" type_code="10">Set Tolerances</item>
              </items>
              <chunks count="1">
                <chunk name="Container">
                  <items count="4">
                    <item name="Description" type_name="gh_string" type_code="10">Sets the tolerances SheepMetal uses. Meant for headless Rhino (for example rhino.compute), where there are no document tolerances. Place at most one per document; it applies to every SheepMetal operation in that document. Without it, the Rhino document's tolerances are used, or 1° and 0.001 when there is no document.</item>
                    <item name="InstanceGuid" type_name="gh_guid" type_code="9">2a64ea4a-cc3d-4f68-acd4-e60a90db0b4e</item>
                    <item name="Name" type_name="gh_string" type_code="10">Set Tolerances</item>
                    <item name="NickName" type_name="gh_string" type_code="10">STol</item>
                  </items>
                  <chunks count="4">
                    <chunk name="Attributes">
                      <items count="2">
                        <item name="Bounds" type_name="gh_drawing_rectanglef" type_code="35">
                          <X>434</X>
                          <Y>-172</Y>
                          <W>79</W>
                          <H>44</H>
                        </item>
                        <item name="Pivot" type_name="gh_drawing_pointf" type_code="31">
                          <X>480</X>
                          <Y>-150</Y>
                        </item>
                      </items>
                    </chunk>
                    <chunk name="param_input" index="0">
                      <items count="6">
                        <item name="Description" type_name="gh_string" type_code="10">Angle tolerance in degrees for geometric calculations. Defaults to 1°.</item>
                        <item name="InstanceGuid" type_name="gh_guid" type_code="9">95551333-4df5-40cb-bd63-7f1f74c057e3</item>
                        <item name="Name" type_name="gh_string" type_code="10">Angle Tolerance</item>
                        <item name="NickName" type_name="gh_string" type_code="10">ATol</item>
