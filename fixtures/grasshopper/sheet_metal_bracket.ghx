                    <item name="Description" type_name="gh_string" type_code="10">Build and interact with your UI - WebSocket-only communication</item>
                    <item name="InstanceGuid" type_name="gh_guid" type_code="9">d658c210-8537-41a7-b15d-7db8367f0549</item>
                    <item name="Name" type_name="gh_string" type_code="10">UI Bridge</item>
                    <item name="NickName" type_name="gh_string" type_code="10">UI Bridge</item>
                    <item name="Schema" type_name="gh_string" type_code="10">{"id":"7f3c2a10-5b8e-4d21-9c6a-2e1f0b9d8a41","name":"Sheet Metal L Bracket","description":"Parametric L bracket built with SheepMetal: bent part, hole rows and an unrolled flat pattern with DXF export.","projectFileName":"sheet_metal_bracket.ghx","documentId":"44414418-3730-4aa6-a12b-afc9ca991b3e","pluginVersion":"0.21.0.0","tags":["sheet metal","bracket","SheepMetal"],"schemaVersion":"2.15.0","created":"2026-10-07T12:52:19.875Z","lastModified":"2026-10-07T13:12:53.1608367Z","viewerOptions":{"enableLocal":true,"enableRemote":true,"backgroundColor":"#f3f3f3"},"instanceSolve":true,"inputs":[{"id":"65839a85-cf3d-4127-bffe-06554f9cb03e","nickname":"Width","paramType":"number","description":"Depth of the part along the bend line, mm.","default":60,"inputStructure":"item"},{"id":"6bd65b67-272a-4da3-b50a-a261cfc6c433","nickname":"Base flange","paramType":"number","description":"Base flange length to the bend, mm.","default":80,"inputStructure":"item"},{"id":"5c9de946-38b4-4d2f-b9c7-45636b96d730","nickname":"Upright flange","paramType":"number","description":"Upright flange length to the bend, mm.","default":60,"inputStructure":"item"},{"id":"6c3b1410-e3e1-4f15-9bf1-f621e62214e3","nickname":"Bend angle","paramType":"number","description":"Bend angle in degrees; 90 is a right-angle bracket.","default":90,"inputStructure":"item"},{"id":"94a44046-d4b5-41e0-8a8b-edb5431e51f1","nickname":"Thickness","paramType":"number","description":"Sheet thickness, mm.","default":2,"inputStructure":"item"},{"id":"08196fdb-a8cf-404f-b820-0a4a0737868d","nickname":"Bend radius","paramType":"number","description":"Inner bend radius, mm.","default":2,"inputStructure":"item"},{"id":"97db35ba-5d7c-40d3-b3d3-c4271fd6090d","nickname":"K-factor","paramType":"number","description":"Neutral-axis position used for the flat pattern.","default":0.33,"inputStructure":"item"},{"id":"edf2ed14-f6ac-4170-aafd-57ae3177cca4","nickname":"Holes per flange","paramType":"integer","description":"Holes in one row on each flange.","default":2,"inputStructure":"item"},{"id":"01617c77-a2ad-41e2-8198-6eb2d731888e","nickname":"Hole diameter","paramType":"number","description":"Hole diameter, mm. Shrunk automatically to fit the flange.","default":6.5,"inputStructure":"item"},{"id":"564a0441-99fe-4968-a49d-45e0ffb45ca4","nickname":"Material","paramType":"valueList","description":"Sets colour and density for the weight.","default":"Steel","inputStructure":"item"}],"outputs":[{"id":"a15e9a0c-153a-4e68-8dcc-6d889cabdb55","nickname":"Weight (g)","description":"","type":"number"},{"id":"663f13f2-6f47-4c40-8a1f-0e6602cca4a8","nickname":"Flat size","description":"","type":"text"},{"id":"b635584f-7394-4127-8654-0a72a1e9bfca","nickname":"Summary","description":"","type":"text"},{"id":"66fa7c18-0dfc-4a9a-a93f-9940d29ed2c6","nickname":"Flat pattern DXF","description":"","type":"file"}],"layout":{"type":"tabbed","tabs":[{"id":"tab-bracket","label":"Bracket","icon":"","order":0,"groups":[{"id":"grp-geometry","label":"Geometry","description":"","order":0,"collapsed":false,"columns":1,"items":[{"type":"input","widgetType":"number","config":{"minimum":10.0,"maximum":300.0,"stepSize":1.0,"renderAsSlider":true},"id":"it-1","paramId":"65839a85-cf3d-4127-bffe-06554f9cb03e","displayName":"Width","description":"","order":0,"span":1,"visible":true},{"type":"input","widgetType":"number","config":{"minimum":20.0,"maximum":300.0,"stepSize":1.0,"renderAsSlider":true},"id":"it-2","paramId":"6bd65b67-272a-4da3-b50a-a261cfc6c433","displayName":"Base flange","description":"","order":1,"span":1,"visible":true},{"type":"input","widgetType":"number","config":{"minimum":20.0,"maximum":300.0,"stepSize":1.0,"renderAsSlider":true},"id":"it-3","paramId":"5c9de946-38b4-4d2f-b9c7-45636b96d730","displayName":"Upright flange","description":"","order":2,"span":1,"visible":true},{"type":"input","widgetType":"number","config":{"minimum":30.0,"maximum":150.0