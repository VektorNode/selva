              <chunks count="1">
                <chunk name="Container">
                  <items count="4">
                    <item name="Description" type_name="gh_string" type_code="10">Builds a Sheet from a 2D polyline profile: the polyline becomes the folded cross-section, each corner becomes a bend of the given radius, and the profile is extruded by the depth to give the part its length. A quick way to make brackets, channels, and box-like parts. The input must be an open polyline.</item>
                    <item name="InstanceGuid" type_name="gh_guid" type_code="9">20294ce2-6fd2-428e-a4b5-f06dd3e041b9</item>
                    <item name="Name" type_name="gh_string" type_code="10">Polyline To Sheet</item>
