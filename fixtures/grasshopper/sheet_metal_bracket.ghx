                              <H>20</H>
                            </item>
                            <item name="Pivot" type_name="gh_drawing_pointf" type_code="31">
                              <X>1572</X>
                              <Y>20</Y>
                            </item>
                          </items>
                        </chunk>
                        <chunk name="PersistentData">
                          <items count="1">
                            <item name="Count" type_name="gh_int32" type_code="3">1</item>
                          </items>
                          <chunks count="1">
                            <chunk name="Branch" index="0">
                              <items count="2">
                                <item name="Count" type_name="gh_int32" type_code="3">1</item>
                                <item name="Path" type_name="gh_string" type_code="10">{0}</item>
                              </items>
                              <chunks count="1">
                                <chunk name="Item" index="0">
                                  <items count="1">
                                    <item name="boolean" type_name="gh_bool" type_code="1">false</item>
                                  </items>
                                </chunk>
                              </chunks>
                            </chunk>
                          </chunks>
                        </chunk>
                      </chunks>
                    </chunk>
                    <chunk name="param_output" index="0">
                      <items count="6">
                        <item name="Description" type_name="gh_string" type_code="10">The resulting structured Sheet object.</item>
                        <item name="InstanceGuid" type_name="gh_guid" type_code="9">19dc83a4-7a0e-4afb-8eee-97a90e2eb250</item>
                        <item name="Name" type_name="gh_string" type_code="10">Sheet</item>
                        <item name="NickName" type_name="gh_string" type_code="10">S</item>
                        <item name="Optional" type_name="gh_bool" type_code="1">false</item>
                        <item name="SourceCount" type_name="gh_int32" type_code="3">0</item>
                      </items>
                      <chunks count="1">
                        <chunk name="Attributes">
                          <items count="2">
                            <item name="Bounds" type_name="gh_drawing_rectanglef" type_code="35">
                              <X>1615</X>
                              <Y>-30</Y>
                              <W>16</W>
                              <H>60</H>
                            </item>
                            <item name="Pivot" type_name="gh_drawing_pointf" type_code="31">
                              <X>1623</X>
                              <Y>0</Y>
                            </item>
                          </items>
                        </chunk>
                      </chunks>
                    </chunk>
                  </chunks>
                </chunk>
              </chunks>
            </chunk>
            <chunk name="Object" index="27">
              <items count="3">
                <item name="GUID" type_name="gh_guid" type_code="9">625d3143-1764-41ee-a712-e49a1e9b87ef</item>
                <item name="Lib" type_name="gh_guid" type_code="9">6416577b-17ae-4953-8103-cf00936edbb1</item>
                <item name="Name" type_name="gh_string" type_code="10">Sheet Properties</item>
              </items>
              <chunks count="1">
                <chunk name="Container">
                  <items count="4">
                    <item name="Description" type_name="gh_string" type_code="10">Reads and sets the things a sheet cannot work out from its own shape: what it is made of, how many are needed, what it is called, its part number, the finish on each face, which way its grain runs, and how much room it needs when nested. Connect an input to set that value; leave it unconnected to keep whatever is already there. Everything comes out again on the right, so you can use this to look at a sheet as well as to change one. Thickness and bend radius are measured from the shape itself and cannot be set here. See Sheet Info for those.</item>
                    <item name="InstanceGuid" type_name="gh_guid" type_code="9">480b7d74-d97e-47e7-8908-a7509dc921bb</item>
                    <item name="Name" type_name="gh_string" type_code="10">Sheet Properties</item>
                    <item name="NickName" type_name="gh_string" type_code="10">SProp</item>
                  </items>
                  <chunks count="19">
                    <chunk name="Attributes">
                      <items count="2">
                        <item name="Bounds" type_name="gh_drawing_rectanglef" type_code="35">
                          <X>1782</X>
                          <Y>-92</Y>
                          <W>79</W>
                          <H>184</H>
                        </item>
                        <item name="Pivot" type_name="gh_drawing_pointf" type_code="31">
                          <X>1820</X>
                          <Y>0</Y>
                        </item>
                      </items>
                    </chunk>
                    <chunk name="param_input" index="0">
                      <items count="7">
                        <item name="Description" type_name="gh_string" type_code="10">The sheet whose details you want to read or change.</item>
                        <item name="InstanceGuid" type_name="gh_guid" type_code="9">1c09b616-6f3a-4c88-9768-efb73955d2ad</item>
                        <item name="Name" type_name="gh_string" type_code="10">Sheet</item>
                        <item name="NickName" type_name="gh_string" type_code="10">S</item>
                        <item name="Optional" type_name="gh_bool" type_code="1">false</item>
                        <item name="Source" index="0" type_name="gh_guid" type_code="9">19dc83a4-7a0e-4afb-8eee-97a90e2eb250</item>
                        <item name="SourceCount" type_name="gh_int32" type_code="3">1</item>
                      </items>
                      <chunks count="1">
                        <chunk name="Attributes">
                          <items count="2">
                            <item name="Bounds" type_name="gh_drawing_rectanglef" type_code="35">
                              <X>1784</X>
                              <Y>-90</Y>
                              <W>21</W>
                              <H>20</H>
                            </item>
                            <item name="Pivot" type_name="gh_drawing_pointf" type_code="31">
                              <X>1796</X>
                              <Y>-80</Y>
                            </item>
                          </items>
                        </chunk>
                      </chunks>
                    </chunk>
                    <chunk name="param_input" index="1">
                      <items count="7">
                        <item name="Description" type_name="gh_string" type_code="10">What the part is made of, for example "S235" or "AlMg3". Together with the thickness this decides which parts may share a stock sheet, so parts of different materials are never nested together. Spelling has to match the stock sheets and the other parts exactly, ignoring capitals and spaces at the ends: "Aluminium" and "alu_1.0" count as two different materials. Any text works, so a code from your own materials list is as good as a name.</item>
                        <item name="InstanceGuid" type_name="gh_guid" type_code="9">d251d53b-53f1-463d-829f-3365ca885a3a</item>
                        <item name="Name" type_name="gh_string" type_code="10">Material</item>
                        <item name="NickName" type_name="gh_string" type_code="10">M</item>
                        <item name="Optional" type_name="gh_bool" type_code="1">true</item>
                        <item name="Source" index="0" type_name="gh_guid" type_code="9">564a0441-99fe-4968-a49d-45e0ffb45ca4</item>
                        <item name="SourceCount" type_name="gh_int32" type_code="3">1</item>
                      </items>
                      <chunks count="1">
                        <chunk name="Attributes">
                          <items count="2">
                            <item name="Bounds" type_name="gh_drawing_rectanglef" type_code="35">
                              <X>1784</X>
                              <Y>-70</Y>
                              <W>21</W>
                              <H>20</H>
                            </item>
                            <item name="Pivot" type_name="gh_drawing_pointf" type_code="31">
                              <X>1796</X>
                              <Y>-60</Y>
                            </item>
                          </items>
                        </chunk>
                      </chunks>
                    </chunk>
                    <chunk name="param_input" index="2">
                      <items count="6">
                        <item name="Description" type_name="gh_string" type_code="10">How many of this part the job needs. The nester makes this many copies, so the count stays with the part and you do not have to feed it a separate list. Quantities wired into Nest Parts win over this value.</item>
                        <item name="InstanceGuid" type_name="gh_guid" type_code="9">6d87ec39-e2d8-4952-93da-bf59653cb901</item>
                        <item name="Name" type_name="gh_string" type_code="10">Quantity</item>
                        <item name="NickName" type_name="gh_string" type_code="10">Q</item>
                        <item name="Optional" type_name="gh_bool" type_code="1">true</item>
                        <item name="SourceCount" type_name="gh_int32" type_code="3">0</item>
                      </items>
                      <chunks count="1">
                        <chunk name="Attributes">
                          <items count="2">
                            <item name="Bounds" type_name="gh_drawing_rectanglef" type_code="35">
                              <X>1784</X>
                              <Y>-50</Y>
                              <W>21</W>
                              <H>20</H>
                            </item>
                            <item name="Pivot" type_name="gh_drawing_pointf" type_code="31">
                              <X>1796</X>
                              <Y>-40</Y>
                            </item>
                          </items>
                        </chunk>
                      </chunks>
                    </chunk>
                    <chunk name="param_input" index="3">
                      <items count="6">
                        <item name="Description" type_name="gh_string" type_code="10">What to call this part, for example in the nester's Unplaced list. Part Number is used there when this is empty.</item>
                        <item name="InstanceGuid" type_name="gh_guid" type_code="9">adfc170c-c9f5-4a75-aa29-58756e38e06a</item>
                        <item name="Name" type_name="gh_string" type_code="10">Name</item>
                        <item name="NickName" type_name="gh_string" type_code="10">N</item>
                        <item name="Optional" type_name="gh_bool" type_code="1">true</item>
                        <item name="SourceCount" type_name="gh_int32" type_code="3">0</item>
                      </items>
                      <chunks count="2">
                        <chunk name="Attributes">
                          <items count="2">
                            <item name="Bounds" type_name="gh_drawing_rectanglef" type_code="35">
                              <X>1784</X>
                              <Y>-30</Y>
                              <W>21</W>
                              <H>20</H>
                            </item>
                            <item name="Pivot" type_name="gh_drawing_pointf" type_code="31">
                              <X>1796</X>
                              <Y>-20</Y>
                            </item>
                          </items>
                        </chunk>
                        <chunk name="PersistentData">
                          <items count="1">
                            <item name="Count" type_name="gh_int32" type_code="3">1</item>
                          </items>
                          <chunks count="1">
                            <chunk name="Branch" index="0">
                              <items count="2">
                                <item name="Count" type_name="gh_int32" type_code="3">1</item>
                                <item name="Path" type_name="gh_string" type_code="10">{0}</item>
                              </items>
                              <chunks count="1">
                                <chunk name="Item" index="0">
                                  <items count="2">
                                    <item name="null_string" type_name="gh_bool" type_code="1">false</item>
                                    <item name="string" type_name="gh_string" type_code="10">L bracket</item>
                                  </items>
                                </chunk>
                              </chunks>
                            </chunk>
                          </chunks>
                        </chunk>
                      </chunks>
                    </chunk>
                    <chunk name="param_input" index="4">
                      <items count="6">
                        <item name="Description" type_name="gh_string" type_code="10">The part's shop or drawing number, for example "A-1042/B". Treated as text, so dashes, slashes and leading zeros all survive.</item>
                        <item name="InstanceGuid" type_name="gh_guid" type_code="9">6dc87e25-6387-4cb2-988e-1ff72f8a8332</item>
                        <item name="Name" type_name="gh_string" type_code="10">Part Number</item>
                        <item name="NickName" type_name="gh_string" type_code="10">PN</item>
                        <item name="Optional" type_name="gh_bool" type_code="1">true</item>
                        <item name="SourceCount" type_name="gh_int32" type_code="3">0</item>
                      </items>
                      <chunks count="1">
                        <chunk name="Attributes">
                          <items count="2">
                            <item name="Bounds" type_name="gh_drawing_rectanglef" type_code="35">
                              <X>1784</X>
                              <Y>-10</Y>
                              <W>21</W>
                              <H>20</H>
                            </item>
                            <item name="Pivot" type_name="gh_drawing_pointf" type_code="31">
                              <X>1796</X>
                              <Y>0</Y>
                            </item>
                          </items>
                        </chunk>
                      </chunks>
                    </chunk>
                    <chunk name="param_input" index="5">
                      <items count="6">
                        <item name="Description" type_name="gh_string" type_code="10">Surface finish on the front of the part, for example "brushed" or "RAL 7016". Free text: it is carried through to the flat pattern and the shop paperwork, not interpreted. Front here means the side the sheet's Root Face is on, the face it was anchored on when it was built. Leave both finishes empty for a bare part.</item>
                        <item name="InstanceGuid" type_name="gh_guid" type_code="9">ca20259e-8cff-4fc8-ac8e-5ca287f9e251</item>
                        <item name="Name" type_name="gh_string" type_code="10">Finish Side 0</item>
                        <item name="NickName" type_name="gh_string" type_code="10">F0</item>
                        <item name="Optional" type_name="gh_bool" type_code="1">true</item>
                        <item name="SourceCount" type_name="gh_int32" type_code="3">0</item>
                      </items>
                      <chunks count="1">
                        <chunk name="Attributes">
                          <items count="2">
                            <item name="Bounds" type_name="gh_drawing_rectanglef" type_code="35">
                              <X>1784</X>
                              <Y>10</Y>
                              <W>21</W>
                              <H>20</H>
                            </item>
                            <item name="Pivot" type_name="gh_drawing_pointf" type_code="31">
                              <X>1796</X>
                              <Y>20</Y>
                            </item>
                          </items>
                        </chunk>
                      </chunks>
                    </chunk>
                    <chunk name="param_input" index="6">
                      <items count="6">
                        <item name="Description" type_name="gh_string" type_code="10">Surface finish on the back of the part: the other side from Finish Side 0. Fill in just one of the two for a part coated on one side only. If the two differ, which one ends up facing up in the flat pattern depends on the unroll, so read Finish Up and Finish Down on the Unroller rather than assuming.</item>
                        <item name="InstanceGuid" type_name="gh_guid" type_code="9">9b735222-407b-4ca4-9e96-1907be9309f2</item>
                        <item name="Name" type_name="gh_string" type_code="10">Finish Side 1</item>
                        <item name="NickName" type_name="gh_string" type_code="10">F1</item>
                        <item name="Optional" type_name="gh_bool" type_code="1">true</item>
                        <item name="SourceCount" type_name="gh_int32" type_code="3">0</item>
                      </items>
                      <chunks count="1">
                        <chunk name="Attributes">
                          <items count="2">
                            <item name="Bounds" type_name="gh_drawing_rectanglef" type_code="35">
                              <X>1784</X>
                              <Y>30</Y>
                              <W>21</W>
                              <H>20</H>
                            </item>
                            <item name="Pivot" type_name="gh_drawing_pointf" type_code="31">
                              <X>1796</X>
                              <Y>40</Y>
                            </item>
                          </items>
                        </chunk>
                      </chunks>
                    </chunk>
                    <chunk name="param_input" index="7">
                      <items count="6">
                        <item name="Description" type_name="gh_string" type_code="10">How much room to leave around this part when nesting, in document units. Leave it empty to use the Gap on Nest Parts, or its automatic gap from the thickness. Set a larger value for a part that needs more clearance than its thickness suggests, such as one with long thin fingers that would distort from cutting heat. Between two parts with different spacing, the gap is the average of the two.</item>
                        <item name="InstanceGuid" type_name="gh_guid" type_code="9">9b302aee-6abe-4ded-91f4-1f02394a38f1</item>
                        <item name="Name" type_name="gh_string" type_code="10">Spacing</item>
                        <item name="NickName" type_name="gh_string" type_code="10">SP</item>
                        <item name="Optional" type_name="gh_bool" type_code="1">true</item>
                        <item name="SourceCount" type_name="gh_int32" type_code="3">0</item>
                      </items>
                      <chunks count="1">
                        <chunk name="Attributes">
                          <items count="2">
                            <item name="Bounds" type_name="gh_drawing_rectanglef" type_code="35">
                              <X>1784</X>
                              <Y>50</Y>
                              <W>21</W>
                              <H>20</H>
                            </item>
                            <item name="Pivot" type_name="gh_drawing_pointf" type_code="31">
