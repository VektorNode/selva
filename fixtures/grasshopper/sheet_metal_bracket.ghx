            <chunk name="Object" index="26">
              <items count="3">
                <item name="GUID" type_name="gh_guid" type_code="9">118c9285-eba4-40dd-b8b3-aedc1002bea5</item>
                <item name="Lib" type_name="gh_guid" type_code="9">6416577b-17ae-4953-8103-cf00936edbb1</item>
                <item name="Name" type_name="gh_string" type_code="10">Manifold To Sheet</item>
              </items>
              <chunks count="1">
                <chunk name="Container">
                  <items count="4">
                    <item name="Description" type_name="gh_string" type_code="10">Turns a closed solid BREP that already looks like sheet metal into a structured Sheet object, classifying its faces into flanges, bends, hems, holes, and thickness faces. The input must be a watertight solid of consistent thickness with no branching walls or T-junctions. Use Non-Manifold To Sheet instead if you are starting from a surface without thickness.</item>
                    <item name="InstanceGuid" type_name="gh_guid" type_code="9">5515be40-185c-402d-9559-bea4446154ce</item>
                    <item name="Name" type_name="gh_string" type_code="10">Manifold To Sheet</item>
                    <item name="NickName" type_name="gh_string" type_code="10">MTS</item>
                  </items>
                  <chunks count="5">
                    <chunk name="Attributes">
                      <items count="2">
                        <item name="Bounds" type_name="gh_drawing_rectanglef" type_code="35">
                          <X>1554</X>
                          <Y>-32</Y>
                          <W>79</W>
                          <H>64</H>
                        </item>
                        <item name="Pivot" type_name="gh_drawing_pointf" type_code="31">
                          <X>1600</X>
                          <Y>0</Y>
                        </item>
                      </items>
                    </chunk>
                    <chunk name="param_input" index="0">
                      <items count="7">
                        <item name="Description" type_name="gh_string" type_code="10">A closed, manifold solid BREP of consistent thickness that represents valid sheet metal.</item>
                        <item name="InstanceGuid" type_name="gh_guid" type_code="9">924f261a-307e-4479-be75-2d3445435cd1</item>
                        <item name="Name" type_name="gh_string" type_code="10">Brep</item>
                        <item name="NickName" type_name="gh_string" type_code="10">B</item>
                        <item name="Optional" type_name="gh_bool" type_code="1">false</item>
                        <item name="Source" index="0" type_name="gh_guid" type_code="9">00855b61-0bb4-4506-99a5-969a5e4be5a5</item>
                        <item name="SourceCount" type_name="gh_int32" type_code="3">1</item>
                      </items>
                      <chunks count="1">
                        <chunk name="Attributes">
                          <items count="2">
                            <item name="Bounds" type_name="gh_drawing_rectanglef" type_code="35">
                              <X>1556</X>
                              <Y>-30</Y>
                              <W>29</W>
                              <H>20</H>
                            </item>
                            <item name="Pivot" type_name="gh_drawing_pointf" type_code="31">
                              <X>1572</X>
                              <Y>-20</Y>
                            </item>
                          </items>
                        </chunk>
                      </chunks>
                    </chunk>
                    <chunk name="param_input" index="1">
                      <items count="6">
                        <item name="Description" type_name="gh_string" type_code="10">Index of the face the sheet is anchored on: it stays put while the rest unfolds. -1 picks the largest face (the lowest index on a tie). Required, because face 0 of a solid is often a poor anchor. With Merge Coplanar Faces on, the index counts the merged faces.</item>
                        <item name="InstanceGuid" type_name="gh_guid" type_code="9">b3d4360c-307b-430d-b135-8de9782cf47a</item>
                        <item name="Name" type_name="gh_string" type_code="10">Root Face</item>
                        <item name="NickName" type_name="gh_string" type_code="10">RF</item>
                        <item name="Optional" type_name="gh_bool" type_code="1">false</item>
                        <item name="SourceCount" type_name="gh_int32" type_code="3">0</item>
                      </items>
                      <chunks count="2">
                        <chunk name="Attributes">
                          <items count="2">
                            <item name="Bounds" type_name="gh_drawing_rectanglef" type_code="35">
                              <X>1556</X>
                              <Y>-10</Y>
                              <W>29</W>
                              <H>20</H>
                            </item>
                            <item name="Pivot" type_name="gh_drawing_pointf" type_code="31">
                              <X>1572</X>
                              <Y>0</Y>
                            </item>
                          </items>
                        </chunk>
                        <chunk name="PersistentData">
                          <items count="1">
                            <item name="Count" type_name="gh_int32" type_code="3">1</item>
                          </items>
                          <chunks count="1">
                            <chunk name="Branch" index="0">
                              <items count="2">
                                <item name="Count" type_name="gh_int32" type_code="3">1</item>
                                <item name="Path" type_name="gh_string" type_code="10">{0}</item>
                              </items>
                              <chunks count="1">
                                <chunk name="Item" index="0">
                                  <items count="1">
                                    <item name="number" type_name="gh_int32" type_code="3">-1</item>
                                  </items>
                                </chunk>
                              </chunks>
                            </chunk>
                          </chunks>
                        </chunk>
                      </chunks>
                    </chunk>
                    <chunk name="param_input" index="2">
                      <items count="6">
                        <item name="Description" type_name="gh_string" type_code="10">If true, adjacent faces that lie in the same plane are merged before analysis, which can fix classification on geometry that was split into extra faces. Leave off unless you need it, as it adds processing time.</item>
                        <item name="InstanceGuid" type_name="gh_guid" type_code="9">cc6d6374-023f-4c02-94b7-e6cdd481c5f9</item>
                        <item name="Name" type_name="gh_string" type_code="10">Merge Coplanar Faces</item>
                        <item name="NickName" type_name="gh_string" type_code="10">MCF</item>
                        <item name="Optional" type_name="gh_bool" type_code="1">false</item>
                        <item name="SourceCount" type_name="gh_int32" type_code="3">0</item>
                      </items>
                      <chunks count="2">
                        <chunk name="Attributes">
                          <items count="2">
                            <item name="Bounds" type_name="gh_drawing_rectanglef" type_code="35">
                              <X>1556</X>
