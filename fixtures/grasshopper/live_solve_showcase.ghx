                    <item name="Schema" type_name="gh_string" type_code="10">{"id":"2c593302-56db-43bf-b1ce-9139d1bc9155","name":"Live Solve Showcase","description":"Test bench for the live solve channel. Spheres or Voronoi cells from random points; messages at every level (remark, warning, blocking error, Notify=Log); incidental Grasshopper noise; a dynamic value list; and four slow stages to abort mid-solve (and, later, to report progress).","projectFileName":"live_solve_showcase.ghx","documentId":"e122c3f9-f787-44b7-bd4b-03f725d47640","pluginVersion":"0.24.0.0","tags":["test","live-events"],"schemaVersion":"2.18.0","created":"2026-09-22T11:22:49.7140573Z","lastModified":"2026-10-28T11:22:33.788945Z","viewerOptions":{"enableLocal":true,"enableRemote":true,"backgroundColor":"#f3f3f3"},"instanceSolve":true,"inputs":[{"id":"03398815-8e1e-40eb-9f6e-f773c9296a65","nickname":"Sphere count","paramType":"integer","description":"","default":60,"inputStructure":"item"},{"id":"b727a278-8586-4e3e-a57f-8fd189003cea","nickname":"Radius scale","paramType":"number","description":"","default":1,"inputStructure":"item"},{"id":"be715bd1-c593-4954-9a1b-529d4056d0df","nickname":"Mode","paramType":"valueList","description":"Spheres solve in ~100 ms; Voronoi cells take ~2 s and raise a remark.","default":"Spheres","inputStructure":"item"},{"id":"7830acd3-605c-4c43-8f2e-5653d701fe68","nickname":"Palette","paramType":"dynamicValueList","description":"Options come from the solve: Rainbow appears above 100 points.","default":"warm","inputStructure":"item"},{"id":"ccd23254-11da-4761-8e69-9b892de180d8","nickname":"Stage delay (s)","paramType":"number","description":"","default":0,"inputStructure":"item"},{"id":"819cb5c6-bdd5-4580-aac8-441d410bb4ae","nickname":"Incidental message","paramType":"valueList","description":"","default":"none","inputStructure":"item"},{"id":"6f7d10dc-35d7-4fb3-b651-0d3201d570f8","nickname":"Get Geometry","paramType":"geometry","description":"","inputStructure":"item"},{"id":"94e379ae-b9e2-4fa0-ab77-20ebec5b5bbd","nickname":"StateTest","paramType":"number","description":"","inputStructure":"item"},{"id":"52d4f5f8-2f8d-474c-8bc1-7d8efa6e5d55","nickname":"Get Color","paramType":"color","description":"Select a color","inputStructure":"item"}],"outputs":[{"id":"0fd6ae9d-8c74-4a4d-8a39-7b4d2233c806","nickname":"Sphere count","description":"","type":"number"},{"id":"639c0bf3-56e6-47fd-8714-a13d2246f8f3","nickname":"Mode","description":"","type":"text"},{"id":"c34a160f-812d-4008-80ca-525fa77eba40","nickname":"Palette options","description":"","type":"dynamicValueList","targetInputId":"7830acd3-605c-4c43-8f2e-5653d701fe68"},{"id":"cd404c4d-25a5-4adb-8e64-6d9342edd0e4","nickname":"Text","description":"","type":"text"}],"layout":{"type":"tabbed","tabs":[{"id":"tab-design","label":"Design","icon":"","order":0,"groups":[{"id":"grp-geometry","label":"Geometry","description":"","order":0,"collapsed":false,"columns":2,"items":[{"type":"input","widgetType":"color","config":{},"id":"381d47ba","paramId":"52d4f5f8-2f8d-474c-8bc1-7d8efa6e5d55","displayName":"Get Color","description":"Select a color","order":5,"span":1,"visible":true},{"type":"input","widgetType":"text","config":{"placeholder":"Enter Get Geometry"},"id":"80482731","paramId":"6f7d10dc-35d7-4fb3-b651-0d3201d570f8","displayName":"Get Geometry","description":"","order":4,"span":1,"visible":true},{"type":"input","widgetType":"number","config":{"minimum":0.0,"maximum":250.0,"stepSize":1.0,"renderAsSlider":true},"id":"it-count","paramId":"03398815-8e1e-40eb-9f6e-f773c9296a65","displayName":"Sphere count","description":"","order":0,"span":1,"visible":true},{"type":"input","widgetType":"number","config":{"minimum":0.2,"maximum":3.0,"stepSize":0.01,"renderAsSlider":true},"id":"it-scale","paramId":"b727a278-8586-4e3e-a57f-8fd189003cea","displayName":"Radius scale","description":"","order":1,"span":1,"visible":true},{"type":"input","widgetType":"dropdown","config":{"options":{"Spheres":"Spheres","Voronoi cells":"Voronoi cells"},"displayAs":"dropdown"},"id":"it-mode","paramId":"be715bd1-c593-4954-9a1b-529d4056d0df","displayName":"Mode","description":"","order":2,"span":1,"visible":true},{"type":"input","widgetType":"dynamicValueList","config":{"defaultOptions":{"Warm":"warm","Cool":"cool","Mono":"mono"},"emptyBehavior":"show-empty","displayAs":"dropdown"},"id":"it-palette","paramId":"7830acd3-605c-4c43-8f2e-5653d701fe68","displayName":"Palette","description":"","order":3,"span":1,"visible":true}]},{"id":"70398135","label":"Group 4","description":"","order":1,"collapsed":false,"columns":1,"items":[{"type":"input","widgetType":"number","config":{"minimum":10.0,"maximum":30.0,"stepSize":1.0,"renderAsSlider":true},"id":"23ac8f4e","paramId":"94e379ae-b9e2-4fa0-ab77-20ebec5b5bbd","displayName":"State Test","description":"","order":1,"span":1,"visible":true},{"type":"output","widgetType":"text","id":"b0bc3986","paramId":"cd404c4d-25a5-4adb-8e64-6d9342edd0e4","displayName":"Text","description":"","order":0,"span":1,"visible":true}]},{"id":"grp-behaviour","label":"Solve behaviour","description":"Abort, incidental messages, and (later) progress.","order":2,"collapsed":false,"columns":1,"items":[{"type":"input","widgetType":"number","config":{"minimum":0.0,"maximum":3.0,"stepSize":0.1,"renderAsSlider":true},"id":"it-delay","paramId":"ccd23254-11da-4761-8e69-9b892de180d8","displayName":"Stage delay (s)","description":"","order":0,"span":1,"visible":true},{"type":"input","widgetType":"dropdown","config":{"options":{"none":"none","warning":"warning","error":"error","exception":"exception"},"displayAs":"dropdown"},"id":"it-noise","paramId":"819cb5c6-bdd5-4580-aac8-441d410bb4ae","displayName":"Incidental message","description":"","order":1,"span":1,"visible":true}]},{"id":"grp-results","label":"Results","description":"","order":3,"collapsed":false,"columns":1,"items":[{"type":"output","widgetType":"number","id":"it-out-count","paramId":"0fd6ae9d-8c74-4a4d-8a39-7b4d2233c8