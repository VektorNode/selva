{
	"name": "@selvajs/builder-app",
	"description": "Selva Schema Builder and Preview Application",
	"private": true,
	"version": "0.9.0",
	"type": "module",
	"scripts": {
		"dev": "vite dev",
		"build": "vite build",
		"preview": "vite preview",
		"prepare": "svelte-kit sync || echo ''",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"type-check": "tsc --noEmit",
		"lint": "eslint . --ext .js,.ts,.svelte"
	},
	"devDependencies": {
		"@lucide/svelte": "catalog:",
		"@selvajs/config": "workspace:*",
		"@sveltejs/adapter-static": "^3.0.10",
		"@types/three": "catalog:",
		"tw-animate-css": "catalog:"
	},
	"dependencies": {
		"@iconify/svelte": "catalog:",
		"@selvajs/compute": "catalog:",
		"@selvajs/ui": "workspace:*",
		"bits-ui": "^2.18.0",
		"mode-watcher": "catalog:",
		"svelte-dnd-action": "^0.9.69",
		"tailwind-variants": "^3.2.2",
		"three": "catalog:"
	}
}
