{
	"name": "@selvajs/mcp",
	"version": "0.1.0",
	"description": "MCP server machinery for Selva hosts: tools over a host's /api/v1, with key auth, error mapping and annotations from its OpenAPI document",
	"license": "MIT",
	"author": "VektorNode",
	"homepage": "https://selva.dev",
	"bugs": "https://github.com/VektorNode/selva/issues",
	"keywords": [
		"selva",
		"mcp",
		"model-context-protocol",
		"openapi"
	],
	"repository": {
		"type": "git",
		"url": "git+https://github.com/VektorNode/selva.git",
		"directory": "packages/mcp"
	},
	"publishConfig": {
		"access": "public"
	},
	"engines": {
		"node": ">=24.0.0"
	},
	"type": "module",
	"main": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"exports": {
		".": {
			"selva-source": "./src/index.ts",
			"types": "./dist/index.d.ts",
			"import": "./dist/index.js"
		},
		"./view": {
			"selva-source": "./src/view/index.ts",
			"types": "./dist/view/index.d.ts",
			"import": "./dist/view/index.js"
		}
	},
	"files": [
		"dist",
		"!**/__tests__/**",
		"!**/*.test.*",
		"!**/*.spec.*"
	],
	"scripts": {
		"build": "tsc && tsc -p src/view && vite build --config views/vite.config.ts",
		"dev": "tsc --watch",
		"type-check": "tsc --noEmit && tsc -p src/view --noEmit && tsc -p views",
		"prepack": "publint --strict",
		"test": "vitest run",
		"test:watch": "vitest",
		"lint": "eslint .",
		"lint:types": "eslint . --config eslint.typed.config.js"
	},
	"dependencies": {
		"@modelcontextprotocol/server": "^2.4.0",
		"zod": "catalog:"
	},
	"devDependencies": {
		"@modelcontextprotocol/client": "catalog:",
		"@modelcontextprotocol/ext-apps": "catalog:",
		"@selvajs/config": "workspace:*",
		"@selvajs/server": "workspace:*",
		"@selvajs/visualization": "workspace:*",
		"@types/node": "catalog:",
		"@types/three": "catalog:",
		"three": "catalog:",
		"typescript": "catalog:",
		"vite": "catalog:",
		"vite-plugin-singlefile": "catalog:",
		"vitest": "catalog:"
	},
	"peerDependencies": {
		"@modelcontextprotocol/ext-apps": "^2.0.4",
		"@selvajs/visualization": "workspace:^",
		"three": ">=0.179.0"
	},
	"peerDependenciesMeta": {
		"@modelcontextprotocol/ext-apps": {
			"optional": true
		},
		"@selvajs/visualization": {
			"optional": true
		},
		"three": {
			"optional": true
		}
	}
}
