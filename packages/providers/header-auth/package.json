{
	"name": "@selvajs/header-auth-provider",
	"version": "0.11.1",
	"description": "Forward-auth provider for Selva: trusts identity headers from an upstream reverse proxy (Caddy forward_auth, oauth2-proxy, …). Auth-only — pair with any data/storage/permissions provider.",
	"license": "MIT",
	"private": true,
	"engines": {
		"node": ">=24.0.0"
	},
	"type": "module",
	"main": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"exports": {
		".": {
			"selva-source": "./src/index.ts",
			"types": "./dist/index.d.ts",
			"import": "./dist/index.js"
		}
	},
	"files": [
		"dist",
		"src"
	],
	"scripts": {
		"build": "tsc",
		"dev": "tsc --watch",
		"type-check": "tsc --noEmit",
		"test": "vitest run",
		"test:watch": "vitest"
	},
	"dependencies": {
		"@selvajs/platform": "workspace:*"
	},
	"devDependencies": {
		"@selvajs/config": "workspace:*",
		"@types/node": "catalog:",
		"typescript": "catalog:",
		"vitest": "catalog:"
	}
}
