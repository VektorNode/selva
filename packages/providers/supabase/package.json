{
	"name": "@selvajs/supabase-provider",
	"version": "0.17.0",
	"description": "Supabase (Auth + Postgres + Storage) implementations of @selvajs/platform interfaces",
	"license": "MIT",
	"author": "VektorNode",
	"homepage": "https://github.com/VektorNode/selva#readme",
	"bugs": "https://github.com/VektorNode/selva/issues",
	"keywords": [
		"selva",
		"provider",
		"supabase",
		"auth",
		"postgres"
	],
	"publishConfig": {
		"access": "public"
	},
	"repository": {
		"type": "git",
		"url": "git+https://github.com/VektorNode/selva.git",
		"directory": "packages/providers/supabase"
	},
	"engines": {
		"node": ">=24.0.0"
	},
	"type": "module",
	"main": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"bin": {
		"selva-supabase": "./dist/cli/sync-migrations.js"
	},
	"exports": {
		".": {
			"selva-source": "./src/index.ts",
			"types": "./dist/index.d.ts",
			"import": "./dist/index.js"
		},
		"./auth": {
			"selva-source": "./src/auth/index.ts",
			"types": "./dist/auth/index.d.ts",
			"import": "./dist/auth/index.js"
		},
		"./data": {
			"selva-source": "./src/data/index.ts",
			"types": "./dist/data/index.d.ts",
			"import": "./dist/data/index.js"
		},
		"./storage": {
			"selva-source": "./src/storage/index.ts",
			"types": "./dist/storage/index.d.ts",
			"import": "./dist/storage/index.js"
		},
		"./permissions": {
			"selva-source": "./src/permissions/index.ts",
			"types": "./dist/permissions/index.d.ts",
			"import": "./dist/permissions/index.js"
		},
		"./userProfile": {
			"selva-source": "./src/userProfile/index.ts",
			"types": "./dist/userProfile/index.d.ts",
			"import": "./dist/userProfile/index.js"
		}
	},
	"files": [
		"dist",
		"supabase",
		"!**/__tests__/**",
		"!**/*.test.*",
		"!**/*.spec.*"
	],
	"scripts": {
		"build": "tsc",
		"dev": "tsc --watch",
		"type-check": "tsc --noEmit",
		"prepack": "publint --strict",
		"test": "vitest run",
		"test:watch": "vitest",
		"supabase:start": "supabase start",
		"supabase:stop": "supabase stop",
		"supabase:reset": "supabase db reset"
	},
	"dependencies": {
		"@selvajs/platform": "workspace:^",
		"@supabase/supabase-js": "^2.112.2",
		"sharp": "catalog:"
	},
	"devDependencies": {
		"@selvajs/config": "workspace:*",
		"@types/node": "catalog:",
		"supabase": "^2.112.0",
		"typescript": "catalog:",
		"vitest": "catalog:"
	}
}
