{
	"name": "@selvajs/website",
	"description": "Selva marketing website (selva.dev)",
	"private": true,
	"version": "0.0.1",
	"type": "module",
	"scripts": {
		"dev": "vite dev",
		"prebuild": "playwright install chromium-headless-shell",
		"build": "node scripts/build-api-docs.mjs && vite build",
		"preview": "vite preview",
		"deploy": "vite build && firebase deploy --only hosting",
		"deploy:preview": "vite build && firebase hosting:channel:deploy preview",
		"prepare": "svelte-kit sync || echo ''",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"type-check": "tsc --noEmit",
		"test": "vitest run",
		"test:watch": "vitest watch"
	},
	"devDependencies": {
		"@selvajs/config": "workspace:*",
		"@selvajs/ui": "workspace:*",
		"@sveltejs/adapter-static": "^3.0.10",
		"@sveltejs/kit": "catalog:",
		"@sveltejs/vite-plugin-svelte": "catalog:",
		"@tailwindcss/typography": "^0.5.20",
		"@tailwindcss/vite": "catalog:",
		"firebase-tools": "^15.27.0",
		"hast-util-to-html": "^9.0.5",
		"mdsvex": "^0.12.8",
		"playwright": "^1.62.1",
		"rehype-autolink-headings": "^7.1.0",
		"rehype-mermaid": "^3.0.0",
		"rehype-raw": "^7.0.0",
		"rehype-slug": "^6.0.0",
		"shiki": "^4.4.2",
		"svelte": "catalog:",
		"svelte-check": "catalog:",
		"tailwindcss": "catalog:",
		"tw-animate-css": "catalog:",
		"typescript": "catalog:",
		"unist-util-visit": "^5.0.0",
		"vite": "catalog:",
		"vitest": "catalog:"
	},
	"dependencies": {
		"@fontsource-variable/familjen-grotesk": "^5.3.0",
		"@lucide/svelte": "catalog:"
	}
}
