{
	"name": "@selva/shared",
	"version": "1.2.0",
	"description": "Shared UI components and utilities for Selva applications",
	"private": true,
	"type": "module",
	"svelte": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"svelte": "./dist/index.js"
		},
		"./styles/base.css": "./src/lib/styles/base.css",
		"./styles/themes/*": "./src/lib/styles/themes/*"
	},
	"files": [
		"dist",
		"src/lib",
		"!dist/**/*.test.*",
		"!dist/**/*.spec.*",
		"!src/lib/**/*.test.*",
		"!src/lib/**/*.spec.*"
	],
	"sideEffects": [
		"**/*.css"
	],
	"scripts": {
		"dev": "vite dev",
		"build": "vite build && pnpm prepack",
		"preview": "vite preview",
		"prepack": "svelte-kit sync && svelte-package && publint",
		"prepare": "svelte-kit sync || echo ''",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"format": "prettier --write .",
		"lint": "prettier --check . && eslint ."
	},
	"peerDependencies": {
		"@selva/core": "workspace:*",
		"@sveltejs/kit": "^2.0.0",
		"svelte": "^5.0.0",
		"three": ">=0.179.0"
	},
	"peerDependenciesMeta": {
		"three": {
			"optional": true
		}
	},
	"dependencies": {
		"@selva/core": "workspace:*",
		"@lucide/svelte": "^0.561.0",
		"bits-ui": "^2.14.4",
		"clsx": "^2.1.1",
		"mode-watcher": "^1.1.0",
		"svelte-sonner": "^1.0.6",
		"tailwind-merge": "^3.4.0",
		"tailwind-variants": "^3.2.2",
		"tw-animate-css": "^1.4.0"
	},
	"devDependencies": {
		"@selva/config": "workspace:*"
	}
}
