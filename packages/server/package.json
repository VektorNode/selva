{
	"name": "@selvajs/server",
	"version": "1.0.0-beta.0",
	"description": "Transport-agnostic server building blocks for apps built on the Selva engine (limits, rate limiting, SSRF guard, remote-definition fetch, definition service + render loader); the solve core lives in @selvajs/solve/server",
	"license": "MIT",
	"author": "VektorNode",
	"homepage": "https://github.com/VektorNode/selva#readme",
	"bugs": "https://github.com/VektorNode/selva/issues",
	"keywords": [
		"selva",
		"rhino-compute",
		"grasshopper",
		"rate-limiting",
		"ssrf"
	],
	"publishConfig": {
		"access": "public"
	},
	"repository": {
		"type": "git",
		"url": "git+https://github.com/VektorNode/selva.git",
		"directory": "packages/server"
	},
	"engines": {
		"node": ">=22.0.0"
	},
	"type": "module",
	"exports": {
		"./compute": {
			"source": "./src/compute/index.ts",
			"types": "./dist/compute/index.d.ts",
			"import": "./dist/compute/index.js"
		},
		"./definitions": {
			"source": "./src/definitions/index.ts",
			"types": "./dist/definitions/index.d.ts",
			"import": "./dist/definitions/index.js"
		},
		"./providers": {
			"source": "./src/providers/index.ts",
			"types": "./dist/providers/index.d.ts",
			"import": "./dist/providers/index.js"
		},
		"./tokens": {
			"source": "./src/tokens/index.ts",
			"types": "./dist/tokens/index.d.ts",
			"import": "./dist/tokens/index.js"
		},
		"./errors": {
			"source": "./src/errors/index.ts",
			"types": "./dist/errors/index.d.ts",
			"import": "./dist/errors/index.js"
		},
		"./logging": {
			"source": "./src/logging/index.ts",
			"types": "./dist/logging/index.d.ts",
			"import": "./dist/logging/index.js"
		},
		"./http": {
			"source": "./src/http/index.ts",
			"types": "./dist/http/index.d.ts",
			"import": "./dist/http/index.js"
		},
		"./access": {
			"source": "./src/access/index.ts",
			"types": "./dist/access/index.d.ts",
			"import": "./dist/access/index.js"
		},
		"./ops": {
			"source": "./src/ops/index.ts",
			"types": "./dist/ops/index.d.ts",
			"import": "./dist/ops/index.js"
		}
	},
	"files": [
		"dist",
		"src",
		"!**/__tests__/**",
		"!**/*.test.*",
		"!**/*.spec.*"
	],
	"scripts": {
		"build": "tsc",
		"dev": "tsc --watch",
		"type-check": "tsc --noEmit",
		"prepack": "node ../../scripts/prepack.js",
		"postpack": "node ../../scripts/prepack.js --restore",
		"test": "vitest run",
		"test:watch": "vitest"
	},
	"dependencies": {
		"@selvajs/compute": "workspace:^",
		"@selvajs/platform": "workspace:^",
		"@selvajs/schemas": "workspace:^"
	},
	"peerDependencies": {
		"@sentry/node": ">=8",
		"pino": ">=9"
	},
	"peerDependenciesMeta": {
		"@sentry/node": {
			"optional": true
		},
		"pino": {
			"optional": true
		}
	},
	"devDependencies": {
		"@types/node": "catalog:",
		"typescript": "catalog:",
		"vitest": "catalog:"
	}
}
