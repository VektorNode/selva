{
	"name": "@selvajs/server",
	"version": "0.2.0-beta.1",
	"description": "Transport-agnostic compute/solve/definitions server building blocks for apps built on the Selva engine (limits, rate limiting, SSRF guard, input transform, solve pipeline, definition service + render loader)",
	"license": "MIT",
	"publishConfig": {
		"access": "public"
	},
	"repository": {
		"type": "git",
		"url": "https://github.com/VektorNode/selva.git",
		"directory": "packages/server"
	},
	"type": "module",
	"main": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"exports": {
		".": {
			"source": "./src/index.ts",
			"types": "./dist/index.d.ts",
			"import": "./dist/index.js"
		},
		"./compute": {
			"source": "./src/compute/index.ts",
			"types": "./dist/compute/index.d.ts",
			"import": "./dist/compute/index.js"
		},
		"./definitions": {
			"source": "./src/definitions/index.ts",
			"types": "./dist/definitions/index.d.ts",
			"import": "./dist/definitions/index.js"
		},
		"./providers": {
			"source": "./src/providers/index.ts",
			"types": "./dist/providers/index.d.ts",
			"import": "./dist/providers/index.js"
		},
		"./tokens": {
			"source": "./src/tokens/index.ts",
			"types": "./dist/tokens/index.d.ts",
			"import": "./dist/tokens/index.js"
		},
		"./errors": {
			"source": "./src/errors/index.ts",
			"types": "./dist/errors/index.d.ts",
			"import": "./dist/errors/index.js"
		},
		"./http": {
			"source": "./src/http/index.ts",
			"types": "./dist/http/index.d.ts",
			"import": "./dist/http/index.js"
		},
		"./access": {
			"source": "./src/access/index.ts",
			"types": "./dist/access/index.d.ts",
			"import": "./dist/access/index.js"
		},
		"./ops": {
			"source": "./src/ops/index.ts",
			"types": "./dist/ops/index.d.ts",
			"import": "./dist/ops/index.js"
		}
	},
	"files": [
		"dist",
		"src"
	],
	"scripts": {
		"build": "tsc",
		"dev": "tsc --watch",
		"type-check": "tsc --noEmit",
		"test": "vitest run",
		"test:watch": "vitest"
	},
	"dependencies": {
		"@selvajs/compute": "catalog:",
		"@selvajs/platform": "workspace:*",
		"@selvajs/schemas": "workspace:*"
	},
	"peerDependencies": {
		"@sentry/node": ">=8"
	},
	"peerDependenciesMeta": {
		"@sentry/node": {
			"optional": true
		}
	},
	"devDependencies": {
		"@types/node": "catalog:",
		"typescript": "catalog:",
		"vitest": "catalog:"
	}
}
