{
	"name": "@selvajs/server",
	"version": "1.3.0",
	"description": "Transport-agnostic server building blocks for apps built on the Selva engine (limits, rate limiting, SSRF guard, remote-definition fetch, definition service + render loader); the solve core lives in @selvajs/solve/server",
	"license": "MIT",
	"author": "VektorNode",
	"homepage": "https://selva.dev",
	"bugs": "https://github.com/VektorNode/selva/issues",
	"keywords": [
		"selva",
		"rhino-compute",
		"grasshopper",
		"rate-limiting",
		"ssrf"
	],
	"publishConfig": {
		"access": "public"
	},
	"repository": {
		"type": "git",
		"url": "git+https://github.com/VektorNode/selva.git",
		"directory": "packages/server"
	},
	"engines": {
		"node": ">=24.0.0"
	},
	"type": "module",
	"exports": {
		"./compute": {
			"selva-source": "./src/compute/index.ts",
			"types": "./dist/compute/index.d.ts",
			"import": "./dist/compute/index.js"
		},
		"./definitions": {
			"selva-source": "./src/definitions/index.ts",
			"types": "./dist/definitions/index.d.ts",
			"import": "./dist/definitions/index.js"
		},
		"./providers": {
			"selva-source": "./src/providers/index.ts",
			"types": "./dist/providers/index.d.ts",
			"import": "./dist/providers/index.js"
		},
		"./tokens": {
			"selva-source": "./src/tokens/index.ts",
			"types": "./dist/tokens/index.d.ts",
			"import": "./dist/tokens/index.js"
		},
		"./errors": {
			"selva-source": "./src/errors/index.ts",
			"types": "./dist/errors/index.d.ts",
			"import": "./dist/errors/index.js"
		},
		"./logging": {
			"selva-source": "./src/logging/index.ts",
			"types": "./dist/logging/index.d.ts",
			"import": "./dist/logging/index.js"
		},
		"./http": {
			"selva-source": "./src/http/index.ts",
			"types": "./dist/http/index.d.ts",
			"import": "./dist/http/index.js"
		},
		"./access": {
			"selva-source": "./src/access/index.ts",
			"types": "./dist/access/index.d.ts",
			"import": "./dist/access/index.js"
		},
		"./api": {
			"selva-source": "./src/api/index.ts",
			"types": "./dist/api/index.d.ts",
			"import": "./dist/api/index.js"
		},
		"./handlers": {
			"selva-source": "./src/handlers/index.ts",
			"types": "./dist/handlers/index.d.ts",
			"import": "./dist/handlers/index.js"
		},
		"./ops": {
			"selva-source": "./src/ops/index.ts",
			"types": "./dist/ops/index.d.ts",
			"import": "./dist/ops/index.js"
		},
		"./projects": {
			"selva-source": "./src/projects/index.ts",
			"types": "./dist/projects/index.d.ts",
			"import": "./dist/projects/index.js"
		},
		"./organizations": {
			"selva-source": "./src/organizations/index.ts",
			"types": "./dist/organizations/index.d.ts",
			"import": "./dist/organizations/index.js"
		},
		"./notifications": {
			"selva-source": "./src/notifications/index.ts",
			"types": "./dist/notifications/index.d.ts",
			"import": "./dist/notifications/index.js"
		},
		"./testing": {
			"selva-source": "./src/testing/index.ts",
			"types": "./dist/testing/index.d.ts",
			"import": "./dist/testing/index.js"
		}
	},
	"files": [
		"dist",
		"!**/__tests__/**",
		"!**/*.test.*",
		"!**/*.spec.*"
	],
	"scripts": {
		"build": "tsc",
		"dev": "tsc --watch",
		"type-check": "tsc --noEmit",
		"prepack": "publint --strict",
		"test": "vitest run",
		"test:watch": "vitest",
		"lint": "eslint .",
		"lint:types": "eslint . --config eslint.typed.config.js"
	},
	"dependencies": {
		"@selvajs/compute": "workspace:^",
		"@selvajs/notifications": "workspace:^",
		"@selvajs/platform": "workspace:^",
		"@selvajs/schemas": "workspace:^",
		"zod": "catalog:"
	},
	"peerDependencies": {
		"@sentry/node": ">=8",
		"nodemailer": ">=7",
		"pino": ">=9"
	},
	"peerDependenciesMeta": {
		"@sentry/node": {
			"optional": true
		},
		"nodemailer": {
			"optional": true
		},
		"pino": {
			"optional": true
		}
	},
	"devDependencies": {
		"@selvajs/config": "workspace:*",
		"@selvajs/local-provider": "workspace:*",
		"@types/node": "catalog:",
		"@types/nodemailer": "^8.0.1",
		"nodemailer": "^9.0.5",
		"typescript": "catalog:",
		"vitest": "catalog:"
	}
}
