{
	"name": "@selvajs/platform",
	"version": "0.19.0",
	"description": "Pure TypeScript interfaces for Selva platform providers (auth, definitions, compute)",
	"license": "MIT",
	"author": "VektorNode",
	"homepage": "https://github.com/VektorNode/selva#readme",
	"bugs": "https://github.com/VektorNode/selva/issues",
	"keywords": [
		"selva",
		"providers",
		"auth",
		"interfaces",
		"platform"
	],
	"publishConfig": {
		"access": "public"
	},
	"repository": {
		"type": "git",
		"url": "git+https://github.com/VektorNode/selva.git",
		"directory": "packages/platform"
	},
	"engines": {
		"node": ">=24.0.0"
	},
	"type": "module",
	"main": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"exports": {
		".": {
			"selva-source": "./src/index.ts",
			"types": "./dist/index.d.ts",
			"import": "./dist/index.js"
		},
		"./auth": {
			"selva-source": "./src/auth/index.ts",
			"types": "./dist/auth/index.d.ts",
			"import": "./dist/auth/index.js"
		},
		"./data": {
			"selva-source": "./src/data/index.ts",
			"types": "./dist/data/index.d.ts",
			"import": "./dist/data/index.js"
		},
		"./storage": {
			"selva-source": "./src/storage/index.ts",
			"types": "./dist/storage/index.d.ts",
			"import": "./dist/storage/index.js"
		},
		"./permissions": {
			"selva-source": "./src/permissions/index.ts",
			"types": "./dist/permissions/index.d.ts",
			"import": "./dist/permissions/index.js"
		},
		"./userProfile": {
			"selva-source": "./src/userProfile/index.ts",
			"types": "./dist/userProfile/index.d.ts",
			"import": "./dist/userProfile/index.js"
		},
		"./projects": {
			"selva-source": "./src/projects/index.ts",
			"types": "./dist/projects/index.d.ts",
			"import": "./dist/projects/index.js"
		},
		"./platformProjects": {
			"selva-source": "./src/platformProjects/index.ts",
			"types": "./dist/platformProjects/index.d.ts",
			"import": "./dist/platformProjects/index.js"
		},
		"./organizations": {
			"selva-source": "./src/organizations/index.ts",
			"types": "./dist/organizations/index.d.ts",
			"import": "./dist/organizations/index.js"
		},
		"./invites": {
			"selva-source": "./src/invites/index.ts",
			"types": "./dist/invites/index.d.ts",
			"import": "./dist/invites/index.js"
		},
		"./shareLinks": {
			"selva-source": "./src/shareLinks/index.ts",
			"types": "./dist/shareLinks/index.d.ts",
			"import": "./dist/shareLinks/index.js"
		},
		"./definitions": {
			"selva-source": "./src/definitions/index.ts",
			"types": "./dist/definitions/index.d.ts",
			"import": "./dist/definitions/index.js"
		},
		"./computeServer": {
			"selva-source": "./src/computeServer/index.ts",
			"types": "./dist/computeServer/index.d.ts",
			"import": "./dist/computeServer/index.js"
		},
		"./access": {
			"selva-source": "./src/access/index.ts",
			"types": "./dist/access/index.d.ts",
			"import": "./dist/access/index.js"
		},
		"./events": {
			"selva-source": "./src/events/index.ts",
			"types": "./dist/events/index.d.ts",
			"import": "./dist/events/index.js"
		},
		"./utils": {
			"selva-source": "./src/utils/index.ts",
			"types": "./dist/utils/index.d.ts",
			"import": "./dist/utils/index.js"
		},
		"./testing": {
			"selva-source": "./src/testing/index.ts",
			"types": "./dist/testing/index.d.ts",
			"import": "./dist/testing/index.js"
		}
	},
	"files": [
		"dist",
		"!**/__tests__/**",
		"!**/*.test.*",
		"!**/*.spec.*"
	],
	"scripts": {
		"build": "tsc",
		"dev": "tsc --watch",
		"type-check": "tsc --noEmit",
		"prepack": "publint --strict",
		"test": "vitest run",
		"test:watch": "vitest"
	},
	"dependencies": {
		"@selvajs/schemas": "workspace:^",
		"zod": "catalog:"
	},
	"peerDependencies": {
		"sharp": "^0.34.0 || ^0.35.0",
		"vitest": "^3.2.4"
	},
	"peerDependenciesMeta": {
		"sharp": {
			"optional": true
		},
		"vitest": {
			"optional": true
		}
	},
	"devDependencies": {
		"@selvajs/config": "workspace:*",
		"sharp": "catalog:",
		"typescript": "catalog:",
		"vitest": "catalog:"
	}
}
