{
	"name": "@selva/platform",
	"version": "0.1.0",
	"description": "Pure TypeScript interfaces for Selva platform providers (auth, definitions, compute)",
	"license": "MIT",
	"type": "module",
	"main": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"import": "./dist/index.js"
		},
		"./auth": {
			"types": "./dist/auth/index.d.ts",
			"import": "./dist/auth/index.js"
		},
		"./projects": {
			"types": "./dist/projects/index.d.ts",
			"import": "./dist/projects/index.js"
		},
		"./definitions/schemas": {
			"types": "./dist/definitions/schemas.d.ts",
			"import": "./dist/definitions/schemas.js"
		},
		"./storage": {
			"types": "./dist/storage/index.d.ts",
			"import": "./dist/storage/index.js"
		},
		"./computeServer": {
			"types": "./dist/computeServer/index.d.ts",
			"import": "./dist/computeServer/index.js"
		},
		"./testing": {
			"types": "./dist/testing/index.d.ts",
			"import": "./dist/testing/index.js"
		}
	},
	"files": [
		"dist",
		"src"
	],
	"scripts": {
		"build": "tsc",
		"dev": "tsc --watch",
		"type-check": "tsc --noEmit"
	},
	"dependencies": {
		"zod": "^4.3.6"
	},
	"peerDependencies": {
		"sharp": "^0.34.0",
		"vitest": "^2.1.8"
	},
	"peerDependenciesMeta": {
		"sharp": {
			"optional": true
		},
		"vitest": {
			"optional": true
		}
	},
	"devDependencies": {
		"sharp": "^0.34.5",
		"typescript": "catalog:",
		"vitest": "^2.1.8"
	}
}
