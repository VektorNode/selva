{
	"name": "@selvajs/runtime",
	"version": "0.10.3",
	"description": "Self-contained, prebuilt Selva compute-app runtime. Install + point at a selva.config.js to deploy.",
	"license": "MIT",
	"publishConfig": {
		"access": "public"
	},
	"type": "module",
	"main": "./build/index.js",
	"files": [
		"build",
		"templates"
	],
	"scripts": {
		"build": "node ./scripts/build.js",
		"clean": "node -e \"require('node:fs').rmSync('./build',{recursive:true,force:true});require('node:fs').rmSync('./templates',{recursive:true,force:true})\""
	},
	"engines": {
		"node": ">=20.6.0"
	},
	"dependencies": {
		"@selvajs/compute": "catalog:",
		"@selvajs/local-provider": "workspace:*",
		"@selvajs/platform": "workspace:*",
		"@selvajs/supabase-provider": "workspace:*",
		"@supabase/supabase-js": "^2.104.1",
		"@sveltejs/kit": "catalog:",
		"clsx": "catalog:",
		"sharp": "^0.34.5",
		"tailwind-merge": "catalog:",
		"tailwind-variants": "^3.2.2",
		"zod": "^4.3.6"
	},
	"devDependencies": {
		"@selvajs/compute-app": "workspace:*",
		"esbuild": "^0.25.0"
	}
}
