{
	"name": "selva-compute-app",
	"version": "0.9.0",
	"description": "Selva Rhino Compute application for iframe embedding",
	"private": true,
	"type": "module",
	"scripts": {
		"dev": "vite dev",
		"build": "rm -rf build && vite build",
		"preview": "vite preview",
		"start": "node build/index.js",
		"prepare": "svelte-kit sync || echo ''",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"type-check": "tsc --noEmit",
		"lint": "eslint . --ext .js,.ts,.svelte",
		"test": "vitest run",
		"test:watch": "vitest"
	},
	"dependencies": {
		"@lucide/svelte": "catalog:",
		"@selva/platform": "workspace:*",
		"bits-ui": "^2.15.4",
		"selva-shared": "workspace:*",
		"mode-watcher": "catalog:",
		"selva-compute": "catalog:",
		"sharp": "^0.34.5",
		"tailwind-variants": "^3.2.2",
		"three": "catalog:",
		"zod": "^4.3.6"
	},
	"devDependencies": {
		"@selva/config": "workspace:*",
		"@sveltejs/adapter-auto": "catalog:",
		"@sveltejs/adapter-node": "^5.5.1",
		"@types/three": "catalog:",
		"selva-local-provider": "workspace:*",
		"tw-animate-css": "catalog:",
		"vitest": "catalog:"
	}
}
