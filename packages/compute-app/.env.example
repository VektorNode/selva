# ============================================================================
# COMPUTE-APP ENVIRONMENT VARIABLES
# ============================================================================
# These are PRIVATE server-side only variables. Never commit this file!
# They are NOT embedded in the client bundle.
#
# COPY THIS FILE TO `.env` AND UPDATE THE VALUES FOR YOUR DEPLOYMENT
# ============================================================================

# ============================================================================
# REQUIRED: Grasshopper Definition Files
# ============================================================================
# Path to the local directory containing .gh files on the server.
# The server will read files from disk and send them to Rhino Compute.
# This keeps your .gh source code hidden from public access.
#
GH_DEFINITIONS_PATH="./definitions"

# For remote definitions via environment variables, use:
# - Set DEFINITION_SOURCE="environment"
# - Define GH_DEF_* variables as JSON containing metadata and URL:
#   GH_DEF_SOLVER='{"metadata":{"displayName":"Solver","description":"Fast solver"},"url":"https://storage.mycompany.com/solver.gh"}'
#   GH_DEF_ANALYSIS='{"metadata":{"displayName":"Analysis Tool","tags":["analysis"]},"url":"https://storage.mycompany.com/analysis.gh"}'
# - Optionally set GH_DEF_PREFIX to change the variable prefix (defaults to "GH_DEF_")
#   GH_DEF_PREFIX="MY_DEFINITION_"


# ============================================================================
# REQUIRED: Rhino.Compute Server
# ============================================================================
# URL of your Rhino.Compute server where actual Grasshopper solving happens.
#
# Examples:
#   Local (Docker):            http://host.docker.internal:5000
#		Local (Dev) 							 http://localhost:5000
#   Deploy (Network):          https://your-website.com/

#
# NOTE: This URL is resolved on the server and never exposed to the client.
#
COMPUTE_SERVER_URL=http://localhost:5000

# ============================================================================
# OPTIONAL: Rhino.Compute Authentication
# ============================================================================
# API key if your Rhino.Compute server requires authentication.
# Sent as 'RhinoComputeKey' HTTP header to the compute server.
# Leave empty or comment out if no authentication is needed.
#
# COMPUTE_API_KEY=your-api-key-here

# ============================================================================
# OPTIONAL: Server Configuration
# ============================================================================
# Port the application server listens on (default: 3000)
# PORT=3000

# Host/IP address the server binds to (default: 0.0.0.0)
# Use 0.0.0.0 to accept external connections
# Use 127.0.0.1 or localhost for local-only connections
# HOST=0.0.0.0

# Node.js environment mode (default: development)
# Set to 'production' for deployments to hide error stack traces
# NODE_ENV=production
