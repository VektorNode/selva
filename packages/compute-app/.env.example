# Server-side only (NEVER exposed to client)
# These environment variables are used in server-side code only
# and will NOT be embedded in the client bundle

# Rhino Compute Server URL (internal/private)
COMPUTE_SERVER_URL="http://localhost:5000"

# Base URL for Grasshopper definition files
# The app will append the filename from ?gh= parameter to this base URL
GH_DEFINITION_URL="http://localhost:5173/selva_example_0_1_0.gh/"

# Optional API key for Rhino Compute authentication
COMPUTE_API_KEY=""

