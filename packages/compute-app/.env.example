# ============================================================================
# COMPUTE-APP ENVIRONMENT VARIABLES
# ============================================================================
# These are PRIVATE server-side only variables. Never commit this file!
# They are NOT embedded in the client bundle.
#
# COPY THIS FILE TO `.env.local` AND UPDATE THE VALUES FOR YOUR DEPLOYMENT
# ============================================================================

# ============================================================================
# REQUIRED: Grasshopper Definition Files
# ============================================================================
# You must configure at least one of the following:

# OPTION 1: Local Files (Recommended for security)
# Absolute path to the directory containing .gh files on the server.
# The server will read files from disk and send them to Rhino Compute.
# This keeps your .gh source code hidden from public access.
#
# GH_DEFINITIONS_PATH="./definitions"

# OPTION 2: Remote URL (Legacy/External)
# Base URL where your Grasshopper definition files are hosted publicly.
# The app appends the filename from the ?gh=filename query parameter to this URL.
#
# Examples:
#   AWS S3:                    https://s3.amazonaws.com/my-bucket/definitions
#   HTTP Server:               https://storage.mycompany.com/definitions
#
# GH_DEFINITIONS_BASE_URL=http://localhost:3000/definitions


# ============================================================================
# REQUIRED: Rhino.Compute Server
# ============================================================================
# URL of your Rhino.Compute server where actual Grasshopper solving happens.
#
# Examples:
#   Local (Docker):            http://host.docker.internal:5000
#		Local (Dev) 							 http://localhost:5000
#   Deploy (Network):           https://your-website.com/443

#
# NOTE: This URL is resolved on the server and never exposed to the client.
#
COMPUTE_SERVER_URL=http://host.docker.internal:8081

# ============================================================================
# OPTIONAL: Rhino.Compute Authentication
# ============================================================================
# API key if your Rhino.Compute server requires authentication.
# Leave empty or comment out if no authentication is needed.
#
# COMPUTE_API_KEY=your-api-key-here

# ============================================================================
# OPTIONAL: Reverse Proxy Configuration
# ============================================================================
# Only set these if your app is behind a reverse proxy (nginx, load balancer, etc.)
# These headers help SvelteKit reconstruct the correct origin URL for form actions.

# The public URL where your app is accessed (required for form actions behind proxy)
# ORIGIN=https://my-app.com

# Trust these headers from proxy for protocol detection
# PROTOCOL_HEADER=x-forwarded-proto

# Trust these headers from proxy for host detection
# HOST_HEADER=x-forwarded-host

# Trust these headers from proxy for client IP detection
# ADDRESS_HEADER=x-forwarded-for

# Number of trusted proxies in front of your app (for XFF parsing)
# XFF_DEPTH=1

# ============================================================================
# OPTIONAL: Performance Tuning
# ============================================================================
# How many seconds to wait for requests to finish before force-closing on shutdown
# Increase this if you have long-running computations
# SHUTDOWN_TIMEOUT=30
