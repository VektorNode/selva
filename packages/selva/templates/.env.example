# ============================================================================
# SELVA ENVIRONMENT
# ============================================================================
# Server-side only: none of this reaches the browser bundle. Copy to `.env`.
#
# Most deployments set the first two sections and nothing else. Everything
# commented out shows its default. `selva config show` prints what a running
# deployment actually uses; /admin/system shows the same in the browser.


# ============================================================================
# REQUIRED
# ============================================================================
# Two keys, two jobs. Both 32 bytes, stable across restarts. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
#
# SELVA_HMAC_KEY      signs: local session cookies, OAuth client ids and codes
#                     for MCP clients, solve-event tokens.
# SELVA_AT_REST_KEY   encrypts: the stored Rhino.Compute API key.
#
# Rotate with `selva keys rotate hmac` (or `at-rest`): the old key moves to
# <KEY>_PREVIOUS and stays accepted until <KEY>_PREVIOUS_EXPIRES, 30 days out.
# Changing a key by hand without its _PREVIOUS breaks what it protected.
# See docs/self-hosting/deployment/security-and-limits.md.
#
# DATA_PATH           where the local provider keeps users, projects and
#                     uploaded files. Relative paths resolve from
#                     packages/selva/. Use an absolute path in production.
#
# The first admin is created through the setup page on first boot.
DATA_PATH="../../.selva-data"
SELVA_HMAC_KEY=replace-this-with-a-random-32-byte-hex-key
SELVA_AT_REST_KEY=replace-this-with-a-random-32-byte-hex-key


# ============================================================================
# BEHIND A REVERSE PROXY (Caddy, nginx, …)
# ============================================================================
# ORIGIN              the public URL, no trailing slash. Without it, form posts
#                     fail the CSRF check and invite links carry an internal host.
# HOST                bind address. Default 0.0.0.0. Use 127.0.0.1 when a proxy
#                     sits in front, and always under header auth.
# PORT                default 3000.
# ADDRESS_HEADER      header with the real client IP: X-Forwarded-For, or
#                     CF-Connecting-IP behind Cloudflare. Unset behind a proxy,
#                     every client shares one login rate-limit bucket.
# XFF_DEPTH           how many proxies sit in front. Only for X-Forwarded-For,
#                     which callers can prepend to: too high trusts a spoofed
#                     entry, too low reads your own proxy's IP.
# PROTOCOL_HEADER / HOST_HEADER   carry the original protocol and host when
#                     ORIGIN is unset.
#
# Leave ADDRESS_HEADER and XFF_DEPTH unset when nothing sits in front.
#
# ORIGIN=https://your-domain.com
# HOST=0.0.0.0
# PORT=3000
# ADDRESS_HEADER=X-Forwarded-For
# XFF_DEPTH=1
#
# ALLOW_INSECURE_COOKIES   default false. Cookies are Secure in production and
#                     a browser drops them over plain http, so sign-in seems to
#                     work and then doesn't stick. An http:// ORIGIN already
#                     drops the flag; set this only to override.
# ALLOW_INSECURE_COOKIES=true
#
# NODE_ENV            production in deployments: hides stack traces, makes
#                     cookies Secure. Set it in the process manager, not here:
#                     in .env it breaks `vite build` and `vite preview`.
# NODE_ENV=production
#
# BODY_SIZE_LIMIT     largest request adapter-node accepts at all. Must be at
#                     least 256M, the largest solve request (a `file` input
#                     embeds a 150 MB file as base64). Only K/M/G are units:
#                     "256mb" stops boot, "Infinity" removes the cap.
BODY_SIZE_LIMIT=256M


# ============================================================================
# PROVIDERS
# ============================================================================
# SELVA_AUTH_PROVIDER      local | supabase | header       (default: local)
# SELVA_DATA_PROVIDER      local | supabase                (default: local)
# SELVA_STORAGE_PROVIDER   local | supabase                (default: local)
# SELVA_CONFIG_PATH        a .js file exporting defineConfig(), for a provider
#                          not shipped in the box. Replaces the three above.
#
# SELVA_TENANCY            single | multi                  (default: single)
#   single: one org; setup creates it and every user acts inside it.
#   multi:  setup creates only a platform admin; orgs are first-class.


# ============================================================================
# [header] Auth from a trusted reverse proxy (Entra via oauth2-proxy, Authelia, …)
# ============================================================================
# The proxy signs users in and forwards their identity in headers. Selva does
# NO cryptographic check on them: the deployment is the security boundary.
#   1. The app is reachable ONLY through the proxy (HOST=127.0.0.1, firewall).
#   2. The proxy authenticates against the IdP on every request.
#   3. The proxy STRIPS inbound SELVA-* headers before adding its own.
# Caddyfile: docs/self-hosting/providers/header-auth-entra.md. Self-test after
# every deployment change: packages/providers/header-auth/README.md.
#
# There is no Selva logout: sign-out belongs to the proxy and the IdP.
#
# HEADER_AUTH_DATA_DIR             holds header-allowlist.json. Default DATA_PATH.
# HEADER_AUTH_UPN_HEADER           default SELVA-UserPrincipalName
# HEADER_AUTH_EMAIL_HEADER         default SELVA-Email
# HEADER_AUTH_DISPLAY_NAME_HEADER  default SELVA-DisplayName
#   Change the names to match another proxy. oauth2-proxy sends the UPN as
#   X-Auth-Request-Preferred-Username; its X-Auth-Request-User is the OIDC sub.


# ============================================================================
# [supabase] Supabase provider
# ============================================================================
# Local stack: `cd packages/providers/supabase && npx supabase start`, then
# SUPABASE_URL=http://127.0.0.1:54421 and the keys from `npx supabase status`.
# Hosted: SUPABASE_URL=https://<project-ref>.supabase.co, keys under
# Dashboard → Project Settings → API.
#
# SUPABASE_URL=
# SUPABASE_ANON_KEY=              # "Publishable" key (sb_publishable_…)
# SUPABASE_SERVICE_ROLE_KEY=      # "Secret" key (sb_secret_…), server-only
#
# SUPABASE_PUBLIC_BUCKET=selva-public
# SUPABASE_PRIVATE_BUCKET=selva-private
#
# SUPABASE_ENABLE_SELF_SIGNUP      default false: invite-only.
# SUPABASE_ALLOW_EMAIL_LINK_SIGNUP default true. false stops magic links from
#                                  creating accounts for unknown addresses.
# SUPABASE_OAUTH_PROVIDERS         comma-separated: google, github, azure,
#                                  gitlab. Enable each in the Supabase dashboard
#                                  first. The first OAuth sign-in on the setup
#                                  page becomes the instance admin.
# SUPABASE_ENABLE_SELF_SIGNUP=true
# SUPABASE_ALLOW_EMAIL_LINK_SIGNUP=false
# SUPABASE_OAUTH_PROVIDERS=google,github
#
# Sessions are verified locally against the project's signing keys and
# rechecked with Supabase at most once a minute, so a revoked session works
# for up to 60 s more.
#
# API tokens need a key the project trusts: for each token request Selva signs
# a short session for the token's owner. Without one, API tokens answer 503
# and can't be created; browser sign-in is unaffected. /admin/system shows it.
#
# SUPABASE_JWT_SIGNING_KEY   the private ES256 JWK from
#   `supabase gen signing-key --algorithm ES256`, on one line. On hosted
#   Supabase, import it under Settings → JWT signing keys and rotate to it.
#   It can sign a service_role token: guard it like the service role key.
# SUPABASE_JWT_SIGNING_KEY={"kty":"EC","crv":"P-256","kid":"…","x":"…","y":"…","d":"…"}
#
# SUPABASE_JWT_SECRET        the project's legacy HS256 secret. Used only
#   without SUPABASE_JWT_SIGNING_KEY, and only until the project revokes it.
#   The local CLI stack runs on it.
# SUPABASE_JWT_SECRET=


# ============================================================================
# ACCESS
# ============================================================================
# BOOTSTRAP_INSTANCE_ADMIN_EMAIL   while no instance admin exists, only this
#   address may become one. Unset, whoever signs in first wins. Also the
#   recovery path when admin is lost; safe to leave set.
# BOOTSTRAP_INSTANCE_ADMIN_EMAIL=admin@your-domain.com
#
# SIGN_IN_MAX_AGE_DAYS   how long one identity-provider sign-in lasts. Past it,
#   API tokens of owners who haven't signed in again are revoked and browser
#   sessions Selva manages can't refresh. This is what retires the keys of
#   someone disabled at the IdP. Default 0: off. Not a whole number: boot stops.
# SIGN_IN_MAX_AGE_DAYS=7


# ============================================================================
# FEATURES (all off by default; true, 1 or yes turns one on)
# ============================================================================
# SELVA_FLAG_ENABLE_SHARING
#   Anonymous share links per definition. Off: existing links stop resolving.
# SELVA_FLAG_ENABLE_PLATFORM_PROJECTS
#   Projects owned by instance admins and granted to orgs or users. Off: they
#   are hidden everywhere and /admin/projects 404s; the rows are kept.
# SELVA_FLAG_ALLOW_CROSS_ORG_PUBLIC
#   A public project is visible to every signed-in user, not only its org.
#   Only meaningful with SELVA_TENANCY=multi.
# SELVA_FLAG_ALLOW_ORG_COMPUTE_OVERRIDE
#   Orgs configure their own Rhino.Compute server. Under single tenancy this
#   only decides whether /team/compute duplicates /admin/compute.


# ============================================================================
# BRANDING (unset falls back to "Selva" and the default copy)
# ============================================================================
# SELVA_BRAND_NAME=Acme Compute            header, <title>, "this {brand} instance"
# SELVA_BRAND_COPYRIGHT_NAME=Acme Corp.    footer; default SELVA_BRAND_NAME
# SELVA_BRAND_TAGLINE=…                    landing-page subtitle
# SELVA_BRAND_DESCRIPTION=…                <meta name="description">
#
# Favicons and the webmanifest are static: overwrite build/client/favicon/
# after install.


# ============================================================================
# EMAIL (SMTP): sends invitations
# ============================================================================
# Unset, invites still work: the admin copies the link and sends it by hand.
# Any SMTP server works. Set ORIGIN behind a proxy, or the mailed link carries
# an internal host. New domains need SPF and DKIM records or mail lands in spam.
#
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587                    # 587 STARTTLS (default), 465 implicit TLS
# SMTP_USER=apikey                 # the provider's SMTP login: `apikey` (SendGrid), `resend` (Resend)
# SMTP_PASS=<secret>               # omit USER and PASS for an open relay
# SMTP_FROM="Selva <no-reply@your-domain.com>"   # required once SMTP_HOST is set
# SMTP_SECURE=                     # overrides the TLS mode inferred from the port


# ============================================================================
# LOGS AND ERROR TRACKING
# ============================================================================
# Logs are JSON lines on stdout, each with a `requestId`. An inbound
# X-Request-Id is reused so records line up with the proxy's access log.
#
# LOG_LEVEL   debug | info | warn | error. Default info (debug in development).
# LOG_LEVEL=info
#
# SELVA_FLAG_COMPUTE_DEBUG   off (default) | on | verbose. Either implies
#   LOG_LEVEL=debug.
#   on:      a few lines per solve: cache hits and the decode/solve/encode
#            timing. See docs/self-hosting/concepts/caching.md.
#   verbose: adds compute-client request logs and Compute's raw error body on
#            a failed solve. That body can quote what was solved, and erasure
#            can't reach logs: use it only to read an upstream error.
# SELVA_FLAG_COMPUTE_DEBUG=on
#
# SENTRY_DSN   ships unexpected server errors to Sentry (needs the optional
#   @sentry/node package). Handled HTTP errors, failed solves included, are not
#   sent. Unset: off.
# SENTRY_DSN=https://examplePublicKey@o0.ingest.sentry.io/0
# SENTRY_TRACES_SAMPLE_RATE=0      # share of requests traced, 0–1; 0 sends errors only
#
# SELVA_RELEASE   release tag on Sentry events and log records.
# SELVA_RELEASE=


# ============================================================================
# MCP AND API TOKENS
# ============================================================================
# Both are always on: tokens are created at /team/tokens. Requires a stable
# SELVA_HMAC_KEY and, behind a proxy, ORIGIN. On Supabase, API tokens also need
# SUPABASE_JWT_SIGNING_KEY.
#
# MCP_ALLOWED_ORIGINS   browser origins /mcp accepts besides its own,
#   comma-separated (a web MCP inspector). Native clients send no Origin.
# MCP_ALLOWED_ORIGINS=
#
# API_TOKEN_RATE_LIMIT_MAX   requests per API token per minute. 0 turns it off.
# API_TOKEN_RATE_LIMIT_MAX=600


# ============================================================================
# RHINO.COMPUTE
# ============================================================================
# The server URL and API key are set at /admin/compute, not here. A URL is
# fetched server-side, so saving one refuses the link-local range
# (169.254.0.0/16, the cloud metadata service). Loopback and LAN are allowed.
#
# Solve time and request size are set on the compute server, not here:
#   --timeout / RHINO_COMPUTE_TIMEOUT                      default 100 s
#   --max-request-size / RHINO_COMPUTE_MAX_REQUEST_SIZE    default 50 MB
# Selva reads them from each server (the VektorNode build reports them at
# /limits) and holds its solves to them; /admin/compute shows what each server
# reports. A server that can't report gets the defaults above, and Selva
# re-uploads the .gh on every solve because it can't tell whether a cached
# definition pointer is safe there. Solves stop after an hour whatever the
# server allows. Raise your proxy's read timeout with --timeout.
#
# COMPUTE_SERVER_CACHESOLVE   default true. Rhino.Compute caches results of
#   identical solves server-wide. Set false if the server is short on memory.
# COMPUTE_SERVER_CACHESOLVE=true
#
# SELVA_EVENT_CALLBACK_ORIGIN   where the Selva plugin inside Rhino.Compute posts
#   live solve events (<origin>/api/v1/solve-events/<solveId>). Default: the
#   origin the browser's request arrived on. Set it when Compute reaches this
#   server on another address, such as an internal hostname.
#   Compute on another machine in dev: run `pnpm --filter @selvajs/selva dev:lan`
#   and point this at this machine's LAN address (http://192.168.1.50:5199).
#   A non-loopback host must also be listed in RHINO_COMPUTE_EVENT_SINK_HOSTS on
#   the Compute side, or the events are dropped (solves still complete).
# SELVA_EVENT_CALLBACK_ORIGIN=


# ============================================================================
# ADVANCED: limits and caches
# ============================================================================
# The defaults suit interactive use. Change one only when traffic shows a need.
#
# COMPUTE_RATE_LIMIT_MAX   solves per user or share link per 100 s window,
#   per app instance.
# COMPUTE_RATE_LIMIT_MAX=120
#
# MAX_DEFINITION_FILE_SIZE_BYTES   largest .gh upload, and the cap on a remote
#   .gh fetch. Rhino.Compute caps requests at RHINO_COMPUTE_MAX_REQUEST_SIZE
#   (50 MB by default): raise it there too.
# MAX_DEFINITION_FILE_SIZE_BYTES=52428800
#
# Solve queue backpressure. In-flight solves per compute server follow its
# child count (--childcount); excess solves wait in a queue. 0 is unbounded.
# A rejected solve gets 503 with Retry-After. Once you know the pool's
# capacity, ≈ 2–3× the child count and ≈ the server's --timeout are sensible.
# COMPUTE_MAX_QUEUE_DEPTH=0
# COMPUTE_QUEUE_WAIT_MS=0
#
# Cache budgets in MB; 0 turns one off.
# COMPUTE_DEFINITION_CACHE_MB   .gh bytes kept warm, so a solve skips storage.
# COMPUTE_SOLVE_CACHE_MB        solve results kept warm, so a repeat solve
#   skips Rhino. PER warm compute server, up to 16 of them: 16× this in the
#   worst case. Turn it down on a small host with many servers.
# COMPUTE_DEFINITION_CACHE_MB=256
# COMPUTE_SOLVE_CACHE_MB=256
#
# INSTALL_DIR   where the app and update.sh live, for the admin updater.
#   Default: found from the working directory.
# INSTALL_DIR=/var/www/selva-compute
