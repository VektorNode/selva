# Supabase provider against the local Supabase CLI stack.
# Loaded by `pnpm dev:supabase`, which starts the stack first.
#
# Ports come from packages/providers/supabase/supabase/config.toml — API is
# 54421, NOT the 54321 default the Supabase docs use. The keys below are the
# CLI's deterministic local-dev keys (same values as
# packages/providers/supabase/.env.test); they are not secrets.

SELVA_AUTH_PROVIDER=supabase
SELVA_DATA_PROVIDER=supabase
SELVA_STORAGE_PROVIDER=supabase
SELVA_TENANCY=single

# Overrides the base .env, which points at the shared local-provider dir. Nothing
# under Supabase reads it, but leaving it inherited makes it look like this mode
# shares state with dev-local when it does not.
DATA_PATH="../../.selva-data/dev-supabase"

SUPABASE_URL=http://127.0.0.1:54421
SUPABASE_ANON_KEY=sb_publishable_ACJWlzQHlZjBrEguHvfOxg_3BJgxAaH
SUPABASE_SERVICE_ROLE_KEY=sb_secret_N7UND0UgjKTVK-Uodkm0Hg_xSvEMPvz

SUPABASE_PUBLIC_BUCKET=public
SUPABASE_PRIVATE_BUCKET=private
SUPABASE_ENABLE_SELF_SIGNUP=true

# `strict` re-checks the token with GoTrue on every request. Slower than
# `hybrid`, but a user you disable in Studio loses access immediately instead of
# up to SUPABASE_REVALIDATE_MS later — worth it while testing auth behaviour.
SUPABASE_TOKEN_VERIFICATION=strict

# Still required: the compute API key is encrypted at rest regardless of provider.
SELVA_AT_REST_KEY=ffeeddccbbaa99887766554433221100ffeeddccbbaa99887766554433221100
SELVA_HMAC_KEY=00112233445566778899aabbccddeeff00112233445566778899aabbccddeeff

BOOTSTRAP_INSTANCE_ADMIN_EMAIL=admin@dev.local
