{
	"extends": "$app/tsconfig",
	"compilerOptions": {
		"rewriteRelativeImportExtensions": true,
		"sourceMap": true,
		"strict": true,
		// `tsc` reads workspace packages from dist so each package's type errors
		// surface in its own build. Run `pnpm build` (turbo rebuilds only what
		// changed) before `pnpm type-check` after editing a platform rule.
		//
		// @selvajs/ui's published "." entry is the curated public SDK (dist/public);
		// internally we use its full barrel (primitives, layout, toast), so map it
		// to the full declarations. Scoped here for the same reason customConditions
		// is avoided above.
		"paths": {
			"@selvajs/ui": ["../ui/dist/index.d.ts"]
		}
	},
	// playwright.config.ts is here so ESLint's typed-lint project service owns it.
	// The e2e/*.ts specs are covered by e2e/tsconfig.json. `src` alone skips
	// dot-folders, so `.well-known` is listed explicitly.
	"include": [
		"src",
		"src/routes/.well-known/**/*.ts",
		"vite.config.ts",
		"kit.config.ts",
		"playwright.config.ts"
	]
}
