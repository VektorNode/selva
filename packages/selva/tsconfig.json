{
	"extends": "$app/tsconfig",
	"compilerOptions": {
		"rewriteRelativeImportExtensions": true,
		"sourceMap": true,
		"strict": true,
		// NOTE: vitest reads workspace-package source directly via the
		// `"selva-source"` export condition (see vitest.config.ts). `tsc` here
		// continues to read dist so each package's type errors surface in its
		// own build, not re-attributed here. Run `pnpm build` (turbo will only
		// rebuild what changed) before `pnpm type-check` if you've edited a
		// platform rule and need it reflected in type errors.
		//
		// @selvajs/ui's published "." entry is the curated public SDK (dist/public);
		// internally we use its full barrel (primitives, layout, toast), so map it
		// to the full declarations. Scoped here for the same reason customConditions
		// is avoided above.
		"paths": {
			"@selvajs/ui": ["../ui/dist/index.d.ts"]
		}
	},
	// playwright.config.ts is here so ESLint's typed-lint project service owns it.
	// The e2e/*.ts specs are covered by e2e/tsconfig.json.
	"include": ["src", "vite.config.ts", "playwright.config.ts"]
}
