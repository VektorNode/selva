# Header (forward-auth) provider — the code path Entra reaches in production.
# Loaded by `pnpm dev:header`, which also starts a local Caddy that injects the
# identity headers a real oauth2-proxy would.
#
# Entra itself is NOT involved and does not need to be. HeaderAuthProvider does
# no crypto and validates no token: it reads three plain headers and trusts
# them. A Caddy that sets those headers exercises byte-for-byte the same code as
# a production Entra + oauth2-proxy chain.
#
# Auth is `header`; data and storage stay local, because header-auth is an
# auth-only provider with no data layer of its own.

SELVA_AUTH_PROVIDER=header
SELVA_DATA_PROVIDER=local
SELVA_STORAGE_PROVIDER=local
SELVA_TENANCY=single

DATA_PATH="../../.selva-data/dev-header"

# You reach the app through Caddy on :8080, not vite on :5173. SvelteKit rejects
# form POSTs whose Origin doesn't match, so this must be the proxy's address —
# without it, every login/save action fails CSRF while GETs look fine.
ORIGIN=http://localhost:8080

SELVA_HMAC_KEY=00112233445566778899aabbccddeeff00112233445566778899aabbccddeeff
SELVA_AT_REST_KEY=ffeeddccbbaa99887766554433221100ffeeddccbbaa99887766554433221100

# First proxy-authed visitor becomes instance admin unless this names someone.
# Matches the `admin` persona in scripts/dev-personas.json.
BOOTSTRAP_INSTANCE_ADMIN_EMAIL=admin@dev.local
