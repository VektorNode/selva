# ============================================================================
# COMPUTE-APP ENVIRONMENT VARIABLES
# ============================================================================
# These are PRIVATE server-side only variables. Never commit this file!
# They are NOT embedded in the client bundle.
#
# COPY THIS FILE TO `.env` AND UPDATE THE VALUES FOR YOUR DEPLOYMENT
# ============================================================================


# ============================================================================
# PROVIDER & TENANCY
# ============================================================================
# Selva is provider-pluggable. Each of auth / data / storage can be wired to
# a different backend; the three vars below pick which implementation runs.
# Vars xlabeled "[local]" further down are only read by the local provider;
# "[supabase]" only by the Supabase provider.
#
# For a custom provider not shipped in the box, point SELVA_CONFIG_PATH at a
# .js file exporting a defineConfig() result. The defaults below cover the
# three bundled stacks.
#
# SELVA_AUTH_PROVIDER       local | supabase | header    (default: local)
# SELVA_DATA_PROVIDER       local | supabase             (default: local)
# SELVA_STORAGE_PROVIDER    local | supabase             (default: local)
#
# Tenancy mode:
#   single — one org per deployment. Setup creates it; every authenticated
#            user acts inside that org. Right for white-label installs.
#   multi  — orgs are first-class. Setup creates only a platform admin;
#            users create their own orgs. Right for SaaS-style deployments.
#
# SELVA_TENANCY             single | multi      (default: single)


# ============================================================================
# WHITE-LABEL BRANDING
# ============================================================================
# Customer-visible product name, footer copyright, and landing-page copy.
# All optional — anything left unset falls back to "Selva" / the default
# tagline. Use these to rebrand the instance without forking the UI.
#
# SELVA_BRAND_NAME=Acme Compute
#   Shown in the header next to the logo, in <title> tags, and in any copy
#   that refers to "this {brand} instance" / "{brand} staff".
#
# SELVA_BRAND_COPYRIGHT_NAME=Acme Corp.
#   Footer copyright owner. Defaults to SELVA_BRAND_NAME when unset.
#
# SELVA_BRAND_TAGLINE=Acme's parametric design tools, on the web.
#   Subtitle on the unauthenticated landing page.
#
# SELVA_BRAND_DESCRIPTION=Acme's interactive design platform.
#   <meta name="description"> for SEO and social previews.
#
# Favicons + the apple-mobile-web-app-title in app.html are static assets
# bundled into the build. To replace them, overwrite the files in
# build/client/favicon/ after install. The webmanifest can be edited the
# same way.


# ============================================================================
# PLATFORM FEATURE FLAGS (all default to off)
# ============================================================================
# Each flag is opt-in; absence or anything other than "true"/"1"/"yes" means
# off. These are security-relevant — read the comments before flipping.
#
# SELVA_FLAG_ALLOW_ORG_CREATION=true
#   Reserved for self-service org creation, which has not shipped. No route
#   consults it yet, so setting it has no effect. Orgs are created at setup,
#   or by an instance admin.
#
# SELVA_FLAG_ALLOW_CROSS_ORG_PUBLIC=true
#   Changes what `public` projects mean. Off (default): a `public` project is
#   visible only to authenticated members of the publishing org. On: visible
#   to any authenticated user on the instance. Only meaningful with
#   SELVA_TENANCY=multi — with one org, both settings describe the same set.
#
# SELVA_FLAG_ALLOW_ORG_COMPUTE_OVERRIDE=true
#   Lets orgs configure their own Rhino.Compute server (BYO compute) instead
#   of inheriting the instance default. Off by default. Under
#   SELVA_TENANCY=single the org pool and the instance pool are the same one,
#   so this only decides whether /team/compute duplicates /admin/compute.
#
# SELVA_FLAG_ENABLE_SHARING=true
#   Per-definition share links — anonymous external access via tokenized
#   URLs. Off by default. When off, share-link admin routes reject
#   mint/list/revoke and the token-resolution path stops honouring tokens.
#
# SELVA_FLAG_ENABLE_PLATFORM_PROJECTS=true
#   Platform projects — projects owned by instance admins and granted to
#   orgs or individual users without normal membership. Off by default.
#   When off, the /admin/projects surface 404s, the nav entry is hidden,
#   platform-visibility projects are filtered out of every listing, and
#   access rules treat them as inaccessible (instance_admin included).
#   Existing rows are preserved; flipping the flag back on restores them.


# ============================================================================
# DIAGNOSTICS
# ============================================================================
# SELVA_FLAG_COMPUTE_DEBUG=on
#   Three-way: off (default) | on | verbose.
#   on — concise cache/timing logs for the /api/compute route — a couple of
#     short lines per solve, no payloads. Shows whether the Selva in-process
#     cache hit ([Compute/selva-cache]) and the server's decode/solve/encode
#     breakdown with definition-cache and cachesolve verdicts
#     ([Compute/rhino-cache]). Safe to leave on while observing cache
#     behavior. See docs/Caching.md.
#   verbose — everything `on` gives you, PLUS full lib-level request/response
#     logging that dumps the entire solve payload, including base64 geometry.
#     Very noisy; use only when you need to inspect raw request/response
#     bodies (e.g. the upstream error body behind a generic "Server error").
#
#   Was two separate flags. SELVA_FLAG_COMPUTE_DEBUG_VERBOSE=true still works —
#   it's treated as SELVA_FLAG_COMPUTE_DEBUG=verbose, with a boot-time warning
#   telling you to update — but move to the single var above when you can.


# ============================================================================
# Secret keys (all providers) + [local] filesystem storage
# ============================================================================
# Two keys, two jobs. They sound similar but are not interchangeable:
#
#   SELVA_HMAC_KEY     — SIGNS things. HMAC-SHA256 key used for session
#                        cookies and for hashing share-link + invite tokens
#                        at rest: the raw token is generated per record (32
#                        random bytes) and shown to the minter once, while
#                        the store keeps only HMAC(key, token), so a
#                        store-only leak can't be replayed. Rotating it logs
#                        everyone out and invalidates every share link and
#                        pending invite.
#
#   SELVA_AT_REST_KEY  — ENCRYPTS things. AES-256-GCM key used to encrypt the
#                        Rhino.Compute API key at rest — on disk in
#                        compute.config.json (local provider) AND in the
#                        compute_servers.api_key column (Supabase provider).
#                        REQUIRED for BOTH providers. Rotating it makes the
#                        encrypted blob undecryptable — you'd have to re-enter
#                        the API key at /admin/compute.
#
# Both must be 32 bytes, stable across restarts. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
#
# DATA_PATH       — directory where the local provider stores users.json,
#                   orgs/projects/definitions JSON, and uploaded .gh files.
#                   Resolved relative to packages/selva/. The default
#                   points at .selva-data/ at the repo root so user data does
#                   not live inside the package source tree (and is gitignored
#                   there). For production deployments use an absolute path.
#                   Local provider only.
#
# Both keys are required under every provider; only their scope shifts. Under
# supabase, sessions are Supabase JWTs, so SELVA_HMAC_KEY hashes tokens but does
# not sign sessions. DATA_PATH is local-provider only.
#
# Keep the two keys separate. Merging them would reuse one secret for both
# signing and encryption, and would make a routine session-secret rotation also
# take compute offline until someone re-enters the API key. `selva keys rotate`
# rotates one without touching the other — see docs/security-and-limits.md.
#
# The first admin user is created through the in-app setup page on first boot.
#
DATA_PATH="../../.selva-data"
SELVA_HMAC_KEY=replace-this-with-a-random-32-byte-hex-key
SELVA_AT_REST_KEY=replace-this-with-a-random-32-byte-hex-key


# ============================================================================
# [header] Header auth provider — trusts headers from an upstream proxy
# ============================================================================
# Auth-only provider. The deployment authenticates users in a reverse proxy
# (Caddy forward_auth, oauth2-proxy, Authelia, …) and forwards a trusted UPN
# header to Selva. Pair with `local` or `supabase` for data/storage.
#
# ⚠ TRUST BOUNDARY: this provider does NO cryptographic verification of the
# headers. The deployment IS the security boundary. You MUST ensure all of:
#   1. The app process is reachable ONLY through the proxy (bind 127.0.0.1
#      / firewall the port). A direct curl from outside must NOT reach it.
#   2. The proxy authenticates against the IdP on every request.
#   3. The proxy STRIPS any inbound SELVA-* headers before adding its own.
# See packages/providers/header-auth/README.md for a working Caddyfile and a
# curl-based self-test to run after every deployment change.
#
# HEADER_AUTH_DATA_DIR
#   Directory holding header-allowlist.json (the pre-provisioned UPN list).
#   Falls back to DATA_PATH when unset — convenient when pairing with the
#   local data provider.
#
# HEADER_AUTH_UPN_HEADER         (default: SELVA-UserPrincipalName)
# HEADER_AUTH_EMAIL_HEADER       (default: SELVA-Email)
# HEADER_AUTH_DISPLAY_NAME_HEADER (default: SELVA-DisplayName)
#   Header names the proxy sets. Override to match a different proxy
#   (e.g. oauth2-proxy uses X-Auth-Request-User).
#
# Note: there is no Selva-side logout — identity rides on every request via
# the proxy headers, so there's no session to destroy. Sign-out is the
# proxy/IdP's job; Selva does not render a logout button under header-auth.
#
# HEADER_AUTH_DATA_DIR=/var/lib/selva
# HEADER_AUTH_UPN_HEADER=SELVA-UserPrincipalName
# HEADER_AUTH_EMAIL_HEADER=SELVA-Email
# HEADER_AUTH_DISPLAY_NAME_HEADER=SELVA-DisplayName


# ============================================================================
# [supabase] Supabase provider
# ============================================================================
# Local stack (`cd packages/providers/supabase && npx supabase start`):
#   SUPABASE_URL=http://127.0.0.1:54321
#   then read `npx supabase status` for the Publishable + Secret keys.
#
# Hosted project (supabase.com):
#   SUPABASE_URL=https://<project-ref>.supabase.co
#   Dashboard → Project Settings → API
#
# SUPABASE_URL=
# SUPABASE_ANON_KEY=              # "Publishable" on CLI v2.95+ (sb_publishable_…)
# SUPABASE_SERVICE_ROLE_KEY=      # "Secret" on CLI v2.95+ (sb_secret_…) — server-only

# Optional bucket overrides (defaults are selva-public + selva-private).
# SUPABASE_PUBLIC_BUCKET=selva-public
# SUPABASE_PRIVATE_BUCKET=selva-private

# URL prefix the app serves private files at. Default: /api/files
# SUPABASE_PRIVATE_URL_PREFIX=/api/files

# Allow self-service signup via /signup? Default: false (invite-only)
# SUPABASE_ENABLE_SELF_SIGNUP=true

# Allow magic-link sign-in to implicitly create a new account for an
# unrecognized address. Default: true. Set to false to lock down to
# invite-only and reject magic-link signups for new addresses.
# SUPABASE_ALLOW_EMAIL_LINK_SIGNUP=false

# OAuth providers to surface on the login page. Comma-separated; each must be
# enabled in the Supabase dashboard first (Authentication → Providers).
# Supported labels: google, github, azure, gitlab.
# When set, the login page renders "Continue with X" buttons; the setup page
# treats the first OAuth sign-in as the bootstrap admin (granted every
# platform permission). Leave unset for password-only deployments.
# SUPABASE_OAUTH_PROVIDERS=google,github

# How session JWTs are verified on each authenticated request:
#   hybrid (default) — verify the JWT LOCALLY via the SDK's getClaims(). With
#     asymmetric signing keys (Supabase's default since 2025) this needs NO
#     network call; the SDK caches the project's JWKS. A legacy symmetric HS256
#     secret transparently falls back to a network verify. To catch server-side
#     sign-outs and disabled-user flips that happen after a token is issued, the
#     session is additionally re-checked against the Auth server at most once per
#     SUPABASE_REVALIDATE_MS — so revocation lag is bounded to that window.
#   strict — call getUser() on every request (one network round-trip each).
#     Instant revocation, no lag. Use if you can't accept the hybrid recheck
#     window. This was the behavior before local verification was added.
# SUPABASE_TOKEN_VERIFICATION=hybrid
#
# Hybrid recheck window in milliseconds (default 60000 = 60s). Lower = tighter
# revocation latency, more getUser calls; higher = fewer calls, more lag.
# SUPABASE_REVALIDATE_MS=60000


# ============================================================================
# INSTANCE-ADMIN BOOTSTRAP (both providers)
# ============================================================================
# Constrains the "first OAuth sign-in becomes instance_admin" path
# (docs/contributing/permissions.md §2 invariant) to a specific email. Without this set,
# whoever signs in first while no admin exists wins the race — fine for
# fresh self-hosted installs, risky in production.
#
# Setting this also doubles as the break-glass recovery path
# (docs/contributing/permissions.md §12) when admin is lost to manual DB edits, a backup
# restore, or migration drift: configure the env var, the named user
# signs in, admin is restored. The check only runs while *no* admin
# exists, so this is safe to leave permanently set.
#
# BOOTSTRAP_INSTANCE_ADMIN_EMAIL=admin@your-domain.com


# ============================================================================
# Rhino.Compute Server
# ============================================================================
# Server URL and optional API key are configured in the admin dashboard
# (/admin/compute) and stored in the data provider — no env var needed.


# ============================================================================
# OPTIONAL: Server Configuration
# ============================================================================
# Port the application server listens on (default: 3000)
# PORT=3000

# Host/IP address the server binds to (default: 0.0.0.0)
# Use 0.0.0.0 to accept external connections
# Use 127.0.0.1 or localhost for local-only connections
# HOST=0.0.0.0

# Node.js environment mode (default: development)
# Set to 'production' for deployments to hide error stack traces
# NOTE: Do NOT set this in .env during build/preview with Vite as it causes errors
# NODE_ENV=production


# ============================================================================
# OPTIONAL: Request Body Size Limit (Important for NODE deployment)
# ============================================================================
# Global cap enforced by adapter-node for every route. Sized to the largest
# legitimate payload. The binding case is a `file` widget compute input: the
# client allows a 150 MB raw file, base64 inflates it to ~200 MB on the wire,
# so the global cap must clear that. Keep this >= COMPUTE_REQUEST_MAX_BYTES.
#
#   BODY_SIZE_LIMIT=256M
#
# Smaller per-route caps live next to the route handlers (e.g.
# `COMPUTE_REQUEST_MAX_BYTES` in /api/compute) and are enforced via
# `Content-Length` before the body is read. Don't set this to "Infinity" in
# production — every JSON endpoint inherits the global cap, and an
# unbounded body is a DoS vector on every route that doesn't have its own.
#
# Supports a single-letter suffix (K / M / G, case-insensitive) or a raw
# byte count. NOTE: only K/M/G are units, and the rest is parsed with
# `Number` — so "256mb" and "Infinity" are both NaN, and the app throws on
# boot. Use "256M" or the raw byte count "268435456".
#
# NOTE: If you change this value and are using PM2, restart with --update-env:
#   pm2 restart selva-compute --update-env
#
BODY_SIZE_LIMIT=256M


# ============================================================================
# OPTIONAL: Compute limits (single source of truth: lib/server/computeLimits.ts)
# ============================================================================
# All knobs below are read by `computeLimits.ts` on boot. Defaults are sized
# for typical interactive use; tune only when real traffic warrants it.
#
# A compute server URL saved at /admin/compute is fetched server-side on every
# status probe and every solve, so it is validated on save: http/https only,
# and never the link-local range (169.254.0.0/16), which carries the cloud
# metadata service that hands out the host's own IAM credentials. Loopback and
# LAN addresses are allowed — that's the normal self-hosted layout. Nothing to
# configure here; the rule has no knob.
#
# How long one solve may run before it's aborted. Single source of truth:
# the server enforces it on /api/compute, and the same value is forwarded to
# the page so the browser's AbortController matches rather than guessing.
# NOTE: this only bounds the parts of the stack we control. If you raise it
# past your reverse proxy's read_timeout or your hosting platform's function
# cap, requests will 502 at those layers regardless of this value — bump
# those configs in lockstep when targeting long-running definitions.
# Renamed from MAX_SOLVE_DURATION_MS; the old name still works for one minor
# version and logs a warning at boot.
# COMPUTE_SOLVE_DEADLINE_MS=100000
#
# Max in-flight solves this app instance sends to ONE compute server; excess
# solves wait in a FIFO queue. Not operator-configurable — Selva always reads
# the compute server's actual compute.geometry child count and re-probes
# periodically, falling back to 1 if the server's count can't be read. To
# change it, resize the pool on the compute server itself (--childcount).
#
# Backpressure for the per-server solve queue (audit B7). By default both are 0
# = unbounded / no deadline (the queue grows without limit — prior behavior).
# Turn them on once you know your Rhino pool's real capacity: a rejected solve
# fails fast with HTTP 503 + Retry-After (the client backs off), which beats a
# request hanging behind a saturated queue.
#   COMPUTE_MAX_QUEUE_DEPTH — max solves allowed to WAIT (excludes the in-flight
#     cap, auto-detected from the compute server's child count); a solve
#     arriving to a full queue is rejected with 503. A sensible tuned value is
#     ≈ 2–3× the compute server's child count.
#   COMPUTE_QUEUE_WAIT_MS — max ms a solve may sit queued before executing; still
#     waiting past this it's rejected with 503 (the scheduler's solve deadline clock
#     starts at execution, so without this the total wait is unbounded). A
#     sensible tuned value is ≈ COMPUTE_SOLVE_DEADLINE_MS.
# COMPUTE_MAX_QUEUE_DEPTH=0
# COMPUTE_QUEUE_WAIT_MS=0
#
# Per-key rate limit on /api/compute (fixed window, in-process Map). Keyed by
# user OR share-link, so anonymous link consumers don't share a bucket with
# the link's owner. Default 120 / 100_000ms ≈ 1.2 solves/sec sustained — well
# above what a slider scrub produces with the client-side throttle.
#
# Buckets self-evict (expired ones are swept about once per window, plus a
# 100k-key memory backstop), so the Map stays bounded with no knob to set.
# Note the limiter is per-instance: run N instances behind a load balancer and
# each key gets N× the rate below until the limiter moves to a shared store.
# COMPUTE_RATE_LIMIT_WINDOW_MS=100000
# COMPUTE_RATE_LIMIT_MAX=120
#
# ---------------------------------------------------------------------------
# BEHIND A REVERSE PROXY: SET THESE, OR EVERY USER SHARES ONE RATE-LIMIT BUCKET
# ---------------------------------------------------------------------------
# Read by `@sveltejs/adapter-node`, not by Selva — but Selva's login and
# email-sign-in limiters key on `getClientAddress()`, which returns the socket
# peer. Behind a proxy that is the proxy's own IP for every request, so one
# noisy client can lock out the whole deployment and no per-IP limit means
# anything. This matters most under header-auth, where a proxy is mandatory.
#
# ADDRESS_HEADER — the header carrying the real client IP (`X-Forwarded-For`
#   for most proxies, `CF-Connecting-IP` behind Cloudflare).
# XFF_DEPTH — how many proxies you run, counted from the outside in. Only
#   meaningful for `X-Forwarded-For`, which is a client-appendable list: a
#   caller can prepend fake entries, so the adapter counts from the right.
#   Set it to your actual proxy count — too high trusts a spoofed value, too
#   low reads your own proxy's IP and changes nothing.
#
# Leave both unset when the app is reachable only on loopback with no proxy in
# front; the socket peer is then already the truth.
# ADDRESS_HEADER=X-Forwarded-For
# XFF_DEPTH=1
#
# Upload caps (.gh and cover image). REMOTE_DEFINITION_MAX_BYTES tracks
# MAX_DEFINITION_FILE_SIZE_BYTES so a remote URL can't smuggle past the upload cap.
# MAX_DEFINITION_FILE_SIZE_BYTES=52428800  # 50 MB
# MAX_IMAGE_FILE_SIZE_BYTES=10485760    # 10 MB
#
# /api/compute JSON *request* body cap (inputs + values, NOT the .gh). A `file`
# widget input embeds the uploaded geometry as base64 in `values`, and the
# client file cap is 150 MB raw (~200 MB base64) — so this is sized to clear
# that plus JSON envelope slack. Must stay <= BODY_SIZE_LIMIT above.
# COMPUTE_REQUEST_MAX_BYTES=268435456   # 256 MB
#
# /api/compute JSON *response* body cap. A `file`-typed output (e.g. an
# exported .3dm) is base64-embedded in the solve response. Defensive backstop:
# turns an opaque crash (V8's ~512 MB string wall / browser OOM) into a clear
# 413. Sized above any legitimate inline payload, below the V8 string wall.
# COMPUTE_RESPONSE_MAX_BYTES=314572800  # 300 MB
#
# Remote-definition fetch deadline + cache TTL. The TTL bounds only REMOTE-URL
# fetches: whoever owns the URL can swap the file underneath you, so those bytes
# need a freshness bound. Uploaded definitions do not — see the Caching section.
# REMOTE_DEFINITION_FETCH_TIMEOUT_MS=30000
# REMOTE_DEFINITION_CACHE_TTL_MS=300000   # 5 minutes
#
# ── Caching ────────────────────────────────────────────────────────────────
# Two knobs, both sizes in MB. Every value here is a budget, never an on/off
# gate: both caches are ON by default, and `0` turns one off. There is no
# provider to pick and no combination to get right.
#
# Definition cache — how much .gh data to keep warm. A warm entry lets a solve
# skip reading the file from storage; a pointer-known re-solve moves zero bytes.
# Byte-budgeted rather than entry-counted because definitions span KB→hundreds
# of MB. No TTL: entries are keyed on an immutable version id, so they cannot go
# stale (expiring them could only throw away valid work).
# COMPUTE_DEFINITION_CACHE_MB=256
#
# Solve cache — how many solve results to keep warm, so re-solving the same
# inputs returns without calling Rhino at all. This is what makes dragging a
# slider back to a previous value free.
#
# NOTE: this budget is PER warm compute server. Selva keeps up to 16 servers
# warm, so the worst-case total is 16 × this value (4 GB at the default). Most
# deployments run 1–2 servers, which is why the default is comfortable — but if
# you fan out across many servers on a small VPS, this is the knob to turn down.
# COMPUTE_SOLVE_CACHE_MB=256


# ============================================================================
# Rhino.Compute server
# ============================================================================
#
# These configure the REMOTE Rhino.Compute server's own features, not Selva's
# caches. They are flags sent along with each solve.
#
# Reuse the server's cached definition by pointer instead of re-uploading the
# full .gh binary on every solve (big win for large definitions on a live UI).
# On a stale-pointer miss the client transparently re-uploads — but that recovery
# requires a Rhino.Compute server that signals the miss (VektorNode fork, which
# returns `code: "definition_not_cached"`, or any fork that throws on a missing
# pointer). Set to false if you point Selva at a standard / unknown rhino.compute
# whose stale-pointer behavior you can't vouch for, to avoid empty geometry after
# a compute restart. Default: true.
# COMPUTE_REUSE_DEFINITION_CACHE=true
#
# Server-side solve-result cache. When true, Rhino.Compute caches solve results
# (keyed on definition + inputs) and returns them on identical repeats, skipping
# the solve — server-wide, so it survives Selva restarts and is shared across
# instances. Only helps when the SAME definition is solved with the SAME inputs
# (a changed slider always misses). Adds server memory/disk pressure. Default:
# true. Set to false if the compute server is memory-constrained or definitions
# emit large outputs.
# COMPUTE_SERVER_CACHESOLVE=true
#
# Opt-in: also cache solves that reported Grasshopper errors. By default an
# errored solve is never cached (it re-solves every time), but many definitions
# throw GH errors BY DESIGN (a guarded Python component, a filtered branch) while
# still producing correct geometry. Enable this only when you know your
# definitions' errors are benign. Requires COMPUTE_SERVER_CACHESOLVE and a compute
# server that honors the flag (VektorNode fork). Default: false.
# COMPUTE_CACHE_ERRORED_SOLVES=false


# ============================================================================
# REQUIRED when behind a reverse proxy (Caddy, nginx, etc.)
# ============================================================================
# SvelteKit's CSRF protection compares the request Origin header against this
# value. Without it, form submissions through a proxy fail with
# "Cross-site POST form submissions are forbidden".
#
# Set this to the public-facing URL of the app (no trailing slash):
#   ORIGIN=https://your-domain.com
#   ORIGIN=http://your-server-ip
#
# ORIGIN=https://your-domain.com


# ============================================================================
# OPTIONAL: Installation Directory for Updates
# ============================================================================
# Directory where the application is installed and where update.sh is located.
# Used by the admin dashboard when triggering updates.
# Defaults to current working directory if not set.
#
# INSTALL_DIR=/var/www/selva-compute


# ============================================================================
# OPTIONAL: Error tracking (Sentry)
# ============================================================================
# When set, unexpected server errors (uncaught exceptions, unhandled promise
# rejections, and errors that reach SvelteKit's handleError) are shipped to
# Sentry for triage. Leave unset to disable — no error-tracking dependency is
# loaded, and errors are still written to the log (see LOG_LEVEL below).
# Sentry is for off-box triage; the log is what an operator reads on stdout.
#
# Requires the optional @sentry/node package. It ships as an optionalDependency,
# so `pnpm install` normally pulls it; if your install skipped optionals, add it
# with `pnpm add @sentry/node`. A set DSN with the package missing logs a
# warning and degrades to no-op (boot is never blocked).
#
# NOTE: Handled HTTP errors are NOT reported — including failed Grasshopper
# solves, which the compute route returns as HTTP 500 responses, not crashes.
# Only genuinely unexpected errors reach Sentry.
#
# SENTRY_DSN=https://examplePublicKey@o0.ingest.sentry.io/0
#
# Optional: tag events with a release identifier (e.g. the app version or git
# SHA) so Sentry can group regressions by deploy. NODE_ENV is used as the
# Sentry "environment" automatically. Also stamped on every log record.
# SELVA_RELEASE=4.6.0

# ============================================================================
# OPTIONAL: Logging
# ============================================================================
# Server logs are structured, one JSON object per line, written to stdout for
# your collector to ingest. Every record on a request path carries a
# `requestId`, so one id reconstructs that request's whole story.
#
# LOG_LEVEL — minimum severity written. One of: debug | info | warn | error.
# Defaults to `info` (`debug` when NODE_ENV=development). An unrecognized value
# falls back to the default rather than failing boot.
# LOG_LEVEL=info
#
# Turning on SELVA_FLAG_COMPUTE_DEBUG (or _VERBOSE) implies LOG_LEVEL=debug —
# those flags emit at debug, and an operator who set one has asked for the
# output in so many words.
#
# Request correlation: an inbound `X-Request-Id` header is REUSED when present,
# so records line up with your reverse proxy's own access logs; otherwise an id
# is generated. It's echoed back on every response (including 401/503), so a
# user reporting "request X failed" hands you the exact key to grep for. The id
# is a correlation hint only — never an auth or uniqueness input — and inbound
# values are sanitized (charset-restricted, truncated) so a caller can't forge
# log lines with it.
#
# JSON formatting comes from the optional `pino` package, which ships with the
# app. Without it, logging degrades to readable console output — still
# structured and still correlated, but not machine-parseable, and WITHOUT field
# redaction (see below). Nothing else changes; no call site cares.
#
# Redaction: pino scrubs known-sensitive field names (token, sessionToken,
# refreshToken, apiKey, password, authorization, cookie, and one-level nestings
# of those) to `[redacted]`. That is defense-in-depth for the case where a whole
# object gets spread into log fields and happens to carry a credential — call
# sites are still required not to log secrets in the first place.


# ============================================================================
# OPTIONAL: Email (SMTP) — sends invitations for you
# ============================================================================
# With SMTP_HOST unset, invites still work: minting one returns a link the
# admin copies and sends by hand. Set these and Selva mails the link to the
# invitee directly.
#
# Any SMTP server works — a transactional provider (SES, Postmark, Mailgun,
# Resend, Brevo), your own relay, or Gmail/M365 with an app password.
#
#   SMTP_HOST=smtp.example.com
#   SMTP_PORT=587                     # 587 STARTTLS (default), 465 implicit TLS
#   SMTP_USER=apikey
#   SMTP_PASS=<secret>                # omit both USER and PASS for an open relay
#   SMTP_FROM="Selva <no-reply@your-domain.com>"   # required once SMTP_HOST is set
#   SMTP_SECURE=                      # override TLS mode; inferred from the port
#
# The link in the mail is built from the request origin, so set ORIGIN above if
# you are behind a proxy — otherwise invitees get an internal hostname.
#
# Deliverability: mail from a new domain lands in spam without SPF and DKIM
# DNS records. That is a one-time setup on your domain, not something Selva
# can do for you.
#
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASS=
# SMTP_FROM=
