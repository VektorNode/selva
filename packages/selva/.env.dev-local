# Local provider — filesystem JSON, password auth.
# Loaded by `pnpm dev:local` (vite --mode dev-local).
#
# Each dev provider gets its own DATA_PATH so switching providers never
# half-migrates one store into another's shape.

SELVA_AUTH_PROVIDER=local
SELVA_DATA_PROVIDER=local
SELVA_STORAGE_PROVIDER=local
SELVA_TENANCY=single

# Only used if you run vite directly. `pnpm dev:local` passes an absolute
# DATA_PATH in the environment, which wins over this file — the path here is
# CWD-relative, and vite's CWD differs depending on how it was launched.
DATA_PATH="../../.selva-data/dev-local"

# Dev-only keys. Never reuse these anywhere real.
SELVA_HMAC_KEY=00112233445566778899aabbccddeeff00112233445566778899aabbccddeeff
SELVA_AT_REST_KEY=ffeeddccbbaa99887766554433221100ffeeddccbbaa99887766554433221100

BOOTSTRAP_INSTANCE_ADMIN_EMAIL=admin@dev.local
SELVA_BRAND_NAME=Local
