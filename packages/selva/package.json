{
	"name": "@selvajs/selva",
	"version": "4.7.2",
	"description": "Selva — self-contained Grasshopper-driven web app. Install, configure via .env, deploy.",
	"license": "MIT",
	"author": "VektorNode",
	"homepage": "https://github.com/VektorNode/selva#readme",
	"bugs": "https://github.com/VektorNode/selva/issues",
	"keywords": [
		"grasshopper",
		"rhino",
		"rhino-compute",
		"parametric-design",
		"web-app",
		"sveltekit"
	],
	"publishConfig": {
		"access": "public"
	},
	"repository": {
		"type": "git",
		"url": "git+https://github.com/VektorNode/selva.git",
		"directory": "packages/selva"
	},
	"type": "module",
	"main": "./build/index.js",
	"files": [
		"build",
		"templates"
	],
	"engines": {
		"node": ">=22.0.0"
	},
	"scripts": {
		"dev": "vite dev",
		"build": "rimraf build && vite build && node ./scripts/generate-templates.js",
		"preview": "vite preview",
		"start": "node build/index.js",
		"clean": "rimraf build templates",
		"prepare": "svelte-kit sync || echo ''",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"type-check": "tsc --noEmit",
		"test": "vitest run",
		"test:watch": "vitest",
		"test:e2e": "playwright test"
	},
	"dependencies": {
		"@lucide/svelte": "catalog:",
		"@supabase/supabase-js": "^2.111.0",
		"@sveltejs/kit": "catalog:",
		"bits-ui": "^2.18.0",
		"clsx": "catalog:",
		"mode-watcher": "catalog:",
		"pino": "^10.3.1",
		"rhino3dm": "8.32.1",
		"sharp": "^0.35.3",
		"tailwind-merge": "catalog:",
		"tailwind-variants": "^3.3.0",
		"three": "catalog:",
		"zod": "^4.3.6"
	},
	"optionalDependencies": {
		"@sentry/node": "^10.69.0"
	},
	"devDependencies": {
		"@playwright/test": "catalog:",
		"@selvajs/compute": "workspace:*",
		"@selvajs/config": "workspace:*",
		"@selvajs/header-auth-provider": "workspace:*",
		"@selvajs/local-provider": "workspace:*",
		"@selvajs/platform": "workspace:*",
		"@selvajs/schemas": "workspace:*",
		"@selvajs/server": "workspace:*",
		"@selvajs/supabase-provider": "workspace:*",
		"@selvajs/ui": "workspace:*",
		"@sveltejs/adapter-node": "^5.5.4",
		"@types/three": "catalog:",
		"rimraf": "catalog:",
		"tw-animate-css": "catalog:",
		"vitest": "catalog:"
	}
}
