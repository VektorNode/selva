{
	"name": "@selvajs/selva",
	"version": "4.6.13",
	"description": "Selva — self-contained Grasshopper-driven web app. Install, configure via .env, deploy.",
	"license": "MIT",
	"publishConfig": {
		"access": "public"
	},
	"type": "module",
	"main": "./build/index.js",
	"files": [
		"build",
		"templates"
	],
	"engines": {
		"node": ">=20.6.0"
	},
	"scripts": {
		"dev": "vite dev",
		"build": "rimraf build && vite build && node ./scripts/generate-templates.js",
		"preview": "vite preview",
		"start": "node build/index.js",
		"clean": "rimraf build templates",
		"prepare": "svelte-kit sync || echo ''",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"type-check": "tsc --noEmit",
		"test": "vitest run",
		"test:watch": "vitest",
		"test:e2e": "playwright test"
	},
	"dependencies": {
		"@lucide/svelte": "catalog:",
		"@selvajs/compute": "catalog:",
		"@supabase/supabase-js": "^2.104.1",
		"@sveltejs/kit": "catalog:",
		"bits-ui": "^2.18.0",
		"clsx": "catalog:",
		"mode-watcher": "catalog:",
		"rhino3dm": "8.17.0",
		"sharp": "^0.34.5",
		"tailwind-merge": "catalog:",
		"tailwind-variants": "^3.2.2",
		"three": "catalog:",
		"zod": "^4.3.6"
	},
	"devDependencies": {
		"@selvajs/config": "workspace:*",
		"@selvajs/header-auth-provider": "workspace:*",
		"@selvajs/local-provider": "workspace:*",
		"@selvajs/platform": "workspace:*",
		"@selvajs/schemas": "workspace:*",
		"@selvajs/supabase-provider": "workspace:*",
		"@selvajs/ui": "workspace:*",
		"@playwright/test": "catalog:",
		"@sveltejs/adapter-node": "^5.5.4",
		"@types/three": "catalog:",
		"rimraf": "catalog:",
		"tw-animate-css": "catalog:",
		"vitest": "catalog:"
	}
}
