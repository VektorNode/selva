{
	"name": "@selvajs/schemas",
	"version": "1.1.1",
	"description": "Schema definitions, generated TypeScript types, and code generators for Selva",
	"license": "MIT",
	"publishConfig": {
		"access": "public"
	},
	"type": "module",
	"main": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"exports": {
		".": {
			"source": "./src/index.ts",
			"types": "./dist/index.d.ts",
			"import": "./dist/index.js"
		}
	},
	"files": [
		"dist",
		"src",
		"ui-schema.json",
		"preset-schema.json"
	],
	"scripts": {
		"build": "tsc",
		"dev": "tsc --watch",
		"type-check": "tsc --noEmit",
		"generate:ts": "node generate-typescript.js",
		"generate:cs": "node generate-csharp.js",
		"generate:all": "pnpm run generate:ts && pnpm run generate:cs"
	},
	"devDependencies": {
		"json-schema-to-typescript": "^15.0.4",
		"typescript": "catalog:"
	}
}
