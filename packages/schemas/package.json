{
	"name": "@selvajs/schemas",
	"version": "4.7.0",
	"description": "Schema definitions, generated TypeScript types, and code generators for Selva",
	"license": "MIT",
	"author": "VektorNode",
	"homepage": "https://github.com/VektorNode/selva#readme",
	"bugs": "https://github.com/VektorNode/selva/issues",
	"keywords": [
		"json-schema",
		"codegen",
		"typescript",
		"csharp",
		"selva"
	],
	"publishConfig": {
		"access": "public"
	},
	"repository": {
		"type": "git",
		"url": "git+https://github.com/VektorNode/selva.git",
		"directory": "packages/schemas"
	},
	"engines": {
		"node": ">=22.0.0"
	},
	"type": "module",
	"main": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"exports": {
		".": {
			"source": "./src/index.ts",
			"types": "./dist/index.d.ts",
			"import": "./dist/index.js"
		}
	},
	"files": [
		"dist",
		"src",
		"ui-schema.json",
		"preset-schema.json"
	],
	"scripts": {
		"build": "tsc",
		"dev": "tsc --watch",
		"type-check": "tsc --noEmit",
		"prepack": "node ../../scripts/prepack.js",
		"postpack": "node ../../scripts/prepack.js --restore",
		"generate": "pnpm run generate:ts && pnpm run generate:cs",
		"generate:ts": "node scripts/generate-typescript.js",
		"generate:cs": "node scripts/generate-csharp.js",
		"generate:all": "pnpm run generate"
	},
	"devDependencies": {
		"json-schema-to-typescript": "^15.0.4",
		"prettier": "catalog:",
		"typescript": "catalog:"
	}
}
