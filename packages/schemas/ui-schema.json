{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://selva.dev/schemas/ui-schema.json",
  "title": "Selva UI Schema",
  "description": "Schema definitions for Selva UI configuration",
  "definitions": {
    "GrasshopperParamType": {
      "type": "string",
      "enum": ["number", "integer", "boolean", "text", "valueList", "generic"],
      "description": "Grasshopper contextual parameter data types"
    },
    "InputParamSchema": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "description": "Grasshopper parameter instance GUID"
        },
        "nickname": {
          "type": "string"
        },
        "paramType": {
          "$ref": "#/definitions/GrasshopperParamType"
        },
        "description": {
          "type": "string"
        },
        "default": {}
      },
      "required": ["id", "name", "nickname", "paramType"],
      "additionalProperties": false
    },
    "OutputParamSchema": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "description": "Grasshopper parameter instance GUID"
        },
        "nickname": {
          "type": "string"
        },
        "paramType": {
          "$ref": "#/definitions/GrasshopperParamType"
        },
        "description": {
          "type": "string"
        }
      },
      "required": ["id", "name", "nickname", "paramType"],
      "additionalProperties": false
    },
    "AvailableInput": {
      "type": "object",
      "description": "Input parameter discovered in Grasshopper document",
      "properties": {
        "id": {
          "type": "string",
          "description": "Grasshopper parameter instance GUID"
        },
        "name": {
          "type": "string"
        },
        "nickname": {
          "type": "string"
        },
        "description": {
          "type": "string"
        },
        "type": {
          "$ref": "#/definitions/GrasshopperParamType"
        },
        "default": {},
        "minimum": {
          "type": "number"
        },
        "maximum": {
          "type": "number"
        },
        "stepSize": {
          "type": "number"
        },
        "atLeast": {
          "type": "integer",
          "default": 1
        },
        "atMost": {
          "type": "integer",
          "default": 1
        },
        "treeAccess": {
          "type": "boolean",
          "default": false
        },
        "options": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          },
          "description": "Key-value pairs for dropdown/selection options"
        }
      },
      "required": ["id", "name", "nickname", "description", "type"]
    },
    "AvailableOutput": {
      "type": "object",
      "description": "Output component discovered in Grasshopper document",
      "properties": {
        "id": {
          "type": "string",
          "description": "Grasshopper component instance GUID"
        },
        "nickname": {
          "type": "string"
        },
        "description": {
          "type": "string"
        },
        "type": {
          "type": "string",
          "enum": ["text", "number", "file"],
          "description": "Output display type in UI: 'text' for text/console output, 'number' for numeric output, 'file' for downloadable files"
        }
      },
      "required": ["id", "nickname", "type"],
      "additionalProperties": false
    },
    "AvailableParameters": {
      "type": "object",
      "description": "Collection of input and output parameters discovered in the current Grasshopper document",
      "properties": {
        "sessionId": {
          "type": "string"
        },
        "timestamp": {
          "type": "string",
          "format": "date-time"
        },
        "inputs": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/AvailableInput"
          },
          "description": "List of input parameters available for UI building"
        },
        "outputs": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/AvailableOutput"
          },
          "description": "List of output components available for UI building"
        }
      },
      "required": ["sessionId", "timestamp", "inputs", "outputs"]
    },
    "NumberWidgetConfig": {
      "type": "object",
      "properties": {
        "minimum": {
          "type": "number"
        },
        "maximum": {
          "type": "number"
        },
        "stepSize": {
          "type": "number"
        },
        "placeholder": {
          "type": "string"
        },
        "renderAsSlider": {
          "type": "boolean"
        }
      },
      "additionalProperties": false
    },
    "TextWidgetConfig": {
      "type": "object",
      "properties": {
        "placeholder": {
          "type": "string"
        },
        "required": {
          "type": "boolean"
        }
      },
      "additionalProperties": false
    },
    "DropdownWidgetConfig": {
      "type": "object",
      "properties": {
        "options": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          },
          "description": "Key-value pairs for dropdown options"
        },
        "required": {
          "type": "boolean"
        }
      },
      "required": ["options"],
      "additionalProperties": false
    },
    "CheckboxWidgetConfig": {
      "type": "object",
      "properties": {},
      "additionalProperties": false
    },
    "InputNumberLayoutItem": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string"
        },
        "paramId": {
          "type": "string",
          "description": "References the Grasshopper component InstanceGuid"
        },
        "displayName": {
          "type": "string"
        },
        "description": {
          "type": "string"
        },
        "order": {
          "type": "integer",
          "default": 0
        },
        "span": {
          "type": "integer",
          "default": 1
        },
        "type": {
          "type": "string",
          "const": "input"
        },
        "widgetType": {
          "type": "string",
          "const": "number"
        },
        "config": {
          "$ref": "#/definitions/NumberWidgetConfig"
        }
      },
      "required": ["id", "paramId", "type", "widgetType", "config"]
    },
    "InputTextLayoutItem": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string"
        },
        "paramId": {
          "type": "string",
          "description": "References the Grasshopper component InstanceGuid"
        },
        "displayName": {
          "type": "string"
        },
        "description": {
          "type": "string"
        },
        "order": {
          "type": "integer",
          "default": 0
        },
        "span": {
          "type": "integer",
          "default": 1
        },
        "type": {
          "type": "string",
          "const": "input"
        },
        "widgetType": {
          "type": "string",
          "const": "text"
        },
        "config": {
          "$ref": "#/definitions/TextWidgetConfig"
        }
      },
      "required": ["id", "paramId", "type", "widgetType", "config"]
    },
    "InputDropdownLayoutItem": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string"
        },
        "paramId": {
          "type": "string",
          "description": "References the Grasshopper component InstanceGuid"
        },
        "displayName": {
          "type": "string"
        },
        "description": {
          "type": "string"
        },
        "order": {
          "type": "integer",
          "default": 0
        },
        "span": {
          "type": "integer",
          "default": 1
        },
        "type": {
          "type": "string",
          "const": "input"
        },
        "widgetType": {
          "type": "string",
          "const": "dropdown"
        },
        "config": {
          "$ref": "#/definitions/DropdownWidgetConfig"
        }
      },
      "required": ["id", "paramId", "type", "widgetType", "config"]
    },
    "InputCheckboxLayoutItem": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string"
        },
        "paramId": {
          "type": "string",
          "description": "References the Grasshopper component InstanceGuid"
        },
        "displayName": {
          "type": "string"
        },
        "description": {
          "type": "string"
        },
        "order": {
          "type": "integer",
          "default": 0
        },
        "span": {
          "type": "integer",
          "default": 1
        },
        "type": {
          "type": "string",
          "const": "input"
        },
        "widgetType": {
          "type": "string",
          "const": "checkbox"
        },
        "config": {
          "$ref": "#/definitions/CheckboxWidgetConfig"
        }
      },
      "required": ["id", "paramId", "type", "widgetType"]
    },
    "OutputTextLayoutItem": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string"
        },
        "paramId": {
          "type": "string",
          "description": "References the Grasshopper component InstanceGuid"
        },
        "displayName": {
          "type": "string"
        },
        "description": {
          "type": "string"
        },
        "order": {
          "type": "integer",
          "default": 0
        },
        "span": {
          "type": "integer",
          "default": 1
        },
        "type": {
          "type": "string",
          "const": "output"
        },
        "widgetType": {
          "type": "string",
          "const": "text"
        }
      },
      "required": ["id", "paramId", "type", "widgetType"]
    },
    "OutputNumberLayoutItem": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string"
        },
        "paramId": {
          "type": "string",
          "description": "References the Grasshopper component InstanceGuid"
        },
        "displayName": {
          "type": "string"
        },
        "description": {
          "type": "string"
        },
        "order": {
          "type": "integer",
          "default": 0
        },
        "span": {
          "type": "integer",
          "default": 1
        },
        "type": {
          "type": "string",
          "const": "output"
        },
        "widgetType": {
          "type": "string",
          "const": "number"
        }
      },
      "required": ["id", "paramId", "type", "widgetType"]
    },
    "OutputFileLayoutItem": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string"
        },
        "paramId": {
          "type": "string",
          "description": "References the ContextBake component InstanceGuid for file download"
        },
        "displayName": {
          "type": "string"
        },
        "description": {
          "type": "string"
        },
        "order": {
          "type": "integer",
          "default": 0
        },
        "span": {
          "type": "integer",
          "default": 1
        },
        "type": {
          "type": "string",
          "const": "output"
        },
        "widgetType": {
          "type": "string",
          "const": "file"
        },
        "config": {
          "type": "object",
          "properties": {
            "buttonLabel": {
              "type": "string",
              "default": "Download"
            },
            "fileFormat": {
              "type": "string",
              "description": "File format hint (e.g., 'zip', '3dm')"
            }
          },
          "additionalProperties": false
        }
      },
      "required": ["id", "paramId", "type", "widgetType"]
    },
    "LayoutItem": {
      "oneOf": [
        {
          "$ref": "#/definitions/InputNumberLayoutItem"
        },
        {
          "$ref": "#/definitions/InputTextLayoutItem"
        },
        {
          "$ref": "#/definitions/InputDropdownLayoutItem"
        },
        {
          "$ref": "#/definitions/InputCheckboxLayoutItem"
        },
        {
          "$ref": "#/definitions/OutputTextLayoutItem"
        },
        {
          "$ref": "#/definitions/OutputNumberLayoutItem"
        },
        {
          "$ref": "#/definitions/OutputFileLayoutItem"
        }
      ]
    },
    "GroupConfig": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string"
        },
        "label": {
          "type": "string"
        },
        "description": {
          "type": "string"
        },
        "order": {
          "type": "integer",
          "default": 0
        },
        "collapsed": {
          "type": "boolean",
          "default": false
        },
        "columns": {
          "type": "integer",
          "default": 1
        },
        "items": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/LayoutItem"
          }
        }
      },
      "required": ["id", "label", "items"],
      "additionalProperties": false
    },
    "TabConfig": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string"
        },
        "label": {
          "type": "string"
        },
        "icon": {
          "type": "string"
        },
        "order": {
          "type": "integer",
          "default": 0
        },
        "groups": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/GroupConfig"
          }
        },
        "position": {
          "type": "string",
          "enum": ["left", "center", "right"],
          "default": "center",
          "description": "Horizontal region where this tab should be positioned in multi-column layouts"
        }
      },
      "required": ["id", "label", "groups"],
      "additionalProperties": false
    },
    "LayoutConfig": {
      "type": "object",
      "properties": {
        "type": {
          "type": "string",
          "enum": ["tabbed", "flat"],
          "default": "tabbed"
        },
        "gap": {
          "type": "integer",
          "default": 16
        },
        "tabs": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/TabConfig"
          }
        }
      },
      "additionalProperties": false
    },
    "SessionState": {
      "type": "object",
      "properties": {
        "sessionId": {
          "type": "string"
        },
        "active": {
          "type": "boolean"
        },
        "lastUpdate": {
          "type": "string",
          "format": "date-time"
        },
        "mode": {
          "type": "string",
          "enum": ["builder", "preview"]
        }
      },
      "required": ["sessionId", "active", "lastUpdate", "mode"]
    },
    "RuntimeValues": {
      "type": "object",
      "properties": {
        "timestamp": {
          "type": "string",
          "format": "date-time"
        },
        "values": {
          "type": "object",
          "additionalProperties": {}
        }
      },
      "required": ["timestamp", "values"]
    },
    "ViewerOptions": {
      "type": "object",
      "description": "Configuration options for the 3D viewer",
      "properties": {
        "enableLocal": {
          "type": "boolean",
          "default": false,
          "description": "If true, display mesh data is sent to the web preview for local rendering"
        },
        "enableRemote": {
          "type": "boolean",
          "default": false,
          "description": "If true, enables remote rendering via Rhino Compute"
        },
        "backgroundColor": {
          "type": "string",
          "pattern": "^#[0-9A-Fa-f]{6}$",
          "default": "#ffffff",
          "description": "Background color for the 3D viewer as hex string (e.g., '#ffffff')"
        }
      },
      "additionalProperties": false
    },
    "UISchema": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string"
        },
        "name": {
          "type": "string"
        },
        "description": {
          "type": "string"
        },
        "projectFileName": {
          "type": "string",
          "description": "Grasshopper document file name (e.g., 'myfile.gh')"
        },
        "documentId": {
          "type": "string",
          "description": "Grasshopper document unique identifier (GUID)"
        },
        "pluginVersion": {
          "type": "string",
          "description": "Version of Selva plugin that created/last modified this schema"
        },
        "tags": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "User-defined tags for organizing schemas (e.g., ['architecture', 'facade'])"
        },
        "author": {
          "type": "string",
          "description": "User or organization who created the schema"
        },
        "organization": {
          "type": "string",
          "description": "Organization/company name"
        },
        "schemaVersion": {
          "type": "string",
          "pattern": "^\\d+\\.\\d+\\.\\d+$",
          "default": "1.0.0",
          "description": "Semantic version of the schema format (MAJOR.MINOR.PATCH)"
        },
        "minPluginVersion": {
          "type": "string",
          "pattern": "^\\d+\\.\\d+\\.\\d+$",
          "description": "Minimum plugin version required to load this schema"
        },
        "created": {
          "type": "string",
          "format": "date-time"
        },
        "lastModified": {
          "type": "string",
          "format": "date-time",
          "description": "Last modification timestamp"
        },
        "viewerOptions": {
          "$ref": "#/definitions/ViewerOptions",
          "description": "Configuration for the 3D viewer"
        },
        "instanceSolve": {
          "type": "boolean",
          "default": true,
          "description": "If true, changes trigger immediate solving. If false, user must press Calculate button."
        },
        "inputs": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/InputParamSchema"
          }
        },
        "outputs": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/AvailableOutput"
          },
          "description": "All output components (print, bake, file download)"
        },
        "layout": {
          "$ref": "#/definitions/LayoutConfig"
        }
      },
      "required": ["id", "name", "inputs", "outputs", "layout"],
      "additionalProperties": false
    },
    "ParameterState": {
      "type": "object",
      "description": "Saved state for a single parameter",
      "properties": {
        "paramId": {
          "type": "string",
          "description": "Parameter GUID - primary reference"
        },
        "nickname": {
          "type": "string",
          "description": "Parameter nickname for validation"
        },
        "displayName": {
          "type": "string",
          "description": "Display name for validation"
        },
        "paramType": {
          "type": "string",
          "description": "Parameter type for validation"
        },
        "value": {},
        "groupName": {
          "type": "string",
          "description": "Group name for validation (optional)"
        }
      },
      "required": ["paramId", "nickname", "paramType", "value"],
      "additionalProperties": false
    },
    "ValidationIssue": {
      "type": "object",
      "description": "Validation warning or error for a parameter",
      "properties": {
        "paramId": {
          "type": "string"
        },
        "severity": {
          "type": "string",
          "enum": ["warning", "error"],
          "description": "warning = can still load, error = cannot load"
        },
        "message": {
          "type": "string"
        },
        "details": {
          "type": "object",
          "properties": {
            "expected": {
              "type": "string"
            },
            "actual": {
              "type": "string"
            }
          }
        }
      },
      "required": ["paramId", "severity", "message"],
      "additionalProperties": false
    },
    "SavedState": {
      "type": "object",
      "description": "Saved parameter state for a Grasshopper document",
      "properties": {
        "id": {
          "type": "string",
          "description": "Unique identifier for this saved state"
        },
        "name": {
          "type": "string",
          "description": "User-friendly state name"
        },
        "description": {
          "type": "string",
          "description": "Optional description of this state"
        },
        "timestamp": {
          "type": "string",
          "format": "date-time",
          "description": "When this state was saved"
        },
        "schemaId": {
          "type": "string",
          "description": "References UISchema.id"
        },
        "documentId": {
          "type": "string",
          "description": "Must match UISchema.documentId for validation"
        },
        "projectFileName": {
          "type": "string",
          "description": "Document file name for reference"
        },
        "pluginVersion": {
          "type": "string",
          "description": "Plugin version when state was saved"
        },
        "author": {
          "type": "string",
          "description": "Who saved this state"
        },
        "tags": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "Tags for organizing states"
        },
        "parameters": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/ParameterState"
          },
          "description": "All parameter values"
        }
      },
      "required": ["id", "name", "timestamp", "documentId", "schemaId", "parameters"],
      "additionalProperties": false
    }
  },
  "$ref": "#/definitions/UISchema"
}
