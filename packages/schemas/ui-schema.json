{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://selva.dev/schemas/ui-schema.json",
  "title": "Selva UI Schema",
  "description": "Schema definitions for Selva UI configuration",

  "definitions": {
    "GrasshopperParamType": {
      "type": "string",
      "enum": ["Number", "Integer", "Boolean", "Text", "ValueList", "Generic"],
      "description": "Grasshopper parameter types"
    },

    "InputParamSchema": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "description": "Grasshopper parameter instance GUID"
        },
        "nickname": { "type": "string" },
        "paramType": { "$ref": "#/definitions/GrasshopperParamType" },
        "description": { "type": "string" },
        "default": {}
      },
      "required": ["id", "name", "nickname", "paramType"],
      "additionalProperties": false
    },

    "OutputParamSchema": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "description": "Grasshopper parameter instance GUID"
        },
        "nickname": { "type": "string" },
        "paramType": { "$ref": "#/definitions/GrasshopperParamType" },
        "description": { "type": "string" }
      },
      "required": ["id", "name", "nickname", "paramType"],
      "additionalProperties": false
    },

    "AvailableParameter": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "description": "Grasshopper parameter instance GUID"
        },
        "name": { "type": "string" },
        "nickname": { "type": "string" },
        "description": { "type": "string" },
        "category": {
          "type": "string",
          "enum": ["input", "output"]
        },
        "paramType": { "$ref": "#/definitions/GrasshopperParamType" },
        "default": {},
        "minimum": { "type": "number" },
        "maximum": { "type": "number" },
        "stepSize": { "type": "number" },
        "atLeast": { "type": "integer", "default": 1 },
        "atMost": { "type": "integer", "default": 1 },
        "treeAccess": { "type": "boolean", "default": false },
        "options": {
          "type": "object",
          "additionalProperties": { "type": "string" },
          "description": "Key-value pairs for dropdown options"
        }
      },
      "required": ["id", "name", "nickname", "description", "category", "paramType"]
    },

    "AvailableParameters": {
      "type": "object",
      "properties": {
        "sessionId": { "type": "string" },
        "timestamp": { "type": "string", "format": "date-time" },
        "parameters": {
          "type": "array",
          "items": { "$ref": "#/definitions/AvailableParameter" }
        }
      },
      "required": ["sessionId", "timestamp", "parameters"]
    },

    "NumberWidgetConfig": {
      "type": "object",
      "properties": {
        "minimum": { "type": "number" },
        "maximum": { "type": "number" },
        "stepSize": { "type": "number" },
        "placeholder": { "type": "string" },
        "renderAsSlider": { "type": "boolean" }
      },
      "additionalProperties": false
    },

    "TextWidgetConfig": {
      "type": "object",
      "properties": {
        "placeholder": { "type": "string" },
        "required": { "type": "boolean" }
      },
      "additionalProperties": false
    },

    "DropdownWidgetConfig": {
      "type": "object",
      "properties": {
        "options": {
          "type": "object",
          "additionalProperties": { "type": "string" },
          "description": "Key-value pairs for dropdown options"
        },
        "required": { "type": "boolean" }
      },
      "required": ["options"],
      "additionalProperties": false
    },

    "CheckboxWidgetConfig": {
      "type": "object",
      "properties": {},
      "additionalProperties": false
    },

    "InputNumberLayoutItem": {
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "paramId": {
          "type": "string",
          "description": "References the Grasshopper component InstanceGuid"
        },
        "displayName": { "type": "string" },
        "description": { "type": "string" },
        "order": { "type": "integer", "default": 0 },
        "span": { "type": "integer", "default": 1 },
        "type": { "type": "string", "const": "input" },
        "widgetType": { "type": "string", "const": "number" },
        "config": { "$ref": "#/definitions/NumberWidgetConfig" }
      },
      "required": ["id", "paramId", "type", "widgetType", "config"]
    },

    "InputTextLayoutItem": {
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "paramId": {
          "type": "string",
          "description": "References the Grasshopper component InstanceGuid"
        },
        "displayName": { "type": "string" },
        "description": { "type": "string" },
        "order": { "type": "integer", "default": 0 },
        "span": { "type": "integer", "default": 1 },
        "type": { "type": "string", "const": "input" },
        "widgetType": { "type": "string", "const": "text" },
        "config": { "$ref": "#/definitions/TextWidgetConfig" }
      },
      "required": ["id", "paramId", "type", "widgetType", "config"]
    },

    "InputDropdownLayoutItem": {
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "paramId": {
          "type": "string",
          "description": "References the Grasshopper component InstanceGuid"
        },
        "displayName": { "type": "string" },
        "description": { "type": "string" },
        "order": { "type": "integer", "default": 0 },
        "span": { "type": "integer", "default": 1 },
        "type": { "type": "string", "const": "input" },
        "widgetType": { "type": "string", "const": "dropdown" },
        "config": { "$ref": "#/definitions/DropdownWidgetConfig" }
      },
      "required": ["id", "paramId", "type", "widgetType", "config"]
    },

    "InputCheckboxLayoutItem": {
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "paramId": {
          "type": "string",
          "description": "References the Grasshopper component InstanceGuid"
        },
        "displayName": { "type": "string" },
        "description": { "type": "string" },
        "order": { "type": "integer", "default": 0 },
        "span": { "type": "integer", "default": 1 },
        "type": { "type": "string", "const": "input" },
        "widgetType": { "type": "string", "const": "checkbox" },
        "config": { "$ref": "#/definitions/CheckboxWidgetConfig" }
      },
      "required": ["id", "paramId", "type", "widgetType"]
    },

    "OutputTextLayoutItem": {
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "paramId": {
          "type": "string",
          "description": "References the Grasshopper component InstanceGuid"
        },
        "displayName": { "type": "string" },
        "description": { "type": "string" },
        "order": { "type": "integer", "default": 0 },
        "span": { "type": "integer", "default": 1 },
        "type": { "type": "string", "const": "output" },
        "widgetType": { "type": "string", "const": "text" }
      },
      "required": ["id", "paramId", "type", "widgetType"]
    },

    "OutputNumberLayoutItem": {
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "paramId": {
          "type": "string",
          "description": "References the Grasshopper component InstanceGuid"
        },
        "displayName": { "type": "string" },
        "description": { "type": "string" },
        "order": { "type": "integer", "default": 0 },
        "span": { "type": "integer", "default": 1 },
        "type": { "type": "string", "const": "output" },
        "widgetType": { "type": "string", "const": "number" }
      },
      "required": ["id", "paramId", "type", "widgetType"]
    },

    "OutputFileLayoutItem": {
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "paramId": {
          "type": "string",
          "description": "References the ContextBake component InstanceGuid for file download"
        },
        "displayName": { "type": "string" },
        "description": { "type": "string" },
        "order": { "type": "integer", "default": 0 },
        "span": { "type": "integer", "default": 1 },
        "type": { "type": "string", "const": "output" },
        "widgetType": { "type": "string", "const": "file" },
        "config": {
          "type": "object",
          "properties": {
            "buttonLabel": { "type": "string", "default": "Download" },
            "fileFormat": {
              "type": "string",
              "description": "File format hint (e.g., 'zip', '3dm')"
            }
          },
          "additionalProperties": false
        }
      },
      "required": ["id", "paramId", "type", "widgetType"]
    },

    "LayoutItem": {
      "oneOf": [
        { "$ref": "#/definitions/InputNumberLayoutItem" },
        { "$ref": "#/definitions/InputTextLayoutItem" },
        { "$ref": "#/definitions/InputDropdownLayoutItem" },
        { "$ref": "#/definitions/InputCheckboxLayoutItem" },
        { "$ref": "#/definitions/OutputTextLayoutItem" },
        { "$ref": "#/definitions/OutputNumberLayoutItem" },
        { "$ref": "#/definitions/OutputFileLayoutItem" }
      ]
    },

    "GroupConfig": {
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "label": { "type": "string" },
        "description": { "type": "string" },
        "order": { "type": "integer", "default": 0 },
        "collapsed": { "type": "boolean", "default": false },
        "columns": { "type": "integer", "default": 1 },
        "items": {
          "type": "array",
          "items": { "$ref": "#/definitions/LayoutItem" }
        }
      },
      "required": ["id", "label", "items"],
      "additionalProperties": false
    },

    "TabConfig": {
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "label": { "type": "string" },
        "icon": { "type": "string" },
        "order": { "type": "integer", "default": 0 },
        "groups": {
          "type": "array",
          "items": { "$ref": "#/definitions/GroupConfig" }
        }
      },
      "required": ["id", "label", "groups"],
      "additionalProperties": false
    },

    "LayoutConfig": {
      "type": "object",
      "properties": {
        "type": {
          "type": "string",
          "enum": ["tabbed", "flat"],
          "default": "tabbed"
        },
        "gap": { "type": "integer", "default": 16 },
        "tabs": {
          "type": "array",
          "items": { "$ref": "#/definitions/TabConfig" }
        }
      },
      "additionalProperties": false
    },

    "SessionState": {
      "type": "object",
      "properties": {
        "sessionId": { "type": "string" },
        "active": { "type": "boolean" },
        "lastUpdate": { "type": "string", "format": "date-time" },
        "mode": {
          "type": "string",
          "enum": ["builder", "preview"]
        }
      },
      "required": ["sessionId", "active", "lastUpdate", "mode"]
    },

    "RuntimeValues": {
      "type": "object",
      "properties": {
        "timestamp": { "type": "string", "format": "date-time" },
        "values": {
          "type": "object",
          "additionalProperties": {}
        }
      },
      "required": ["timestamp", "values"]
    },

    "DownloadableComponent": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "description": "Grasshopper component InstanceGuid"
        },
        "nickname": {
          "type": "string",
          "description": "Component nickname for display"
        }
      },
      "required": ["id", "nickname"],
      "additionalProperties": false
    },

    "DownloadingConfig": {
      "type": "object",
      "properties": {
        "enabled": {
          "type": "boolean",
          "default": false,
          "description": "Whether downloadable outputs are available"
        },
        "components": {
          "type": "array",
          "items": { "$ref": "#/definitions/DownloadableComponent" },
          "description": "Array of ContextBake components with downloadable FileData outputs"
        }
      },
      "required": ["enabled"],
      "additionalProperties": false
    },

    "UISchema": {
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "description": { "type": "string" },
        "schemaVersion": {
          "type": "string",
          "pattern": "^\\d+\\.\\d+\\.\\d+$",
          "default": "1.0.0",
          "description": "Semantic version of the schema format (MAJOR.MINOR.PATCH)"
        },
        "minPluginVersion": {
          "type": "string",
          "pattern": "^\\d+\\.\\d+\\.\\d+$",
          "description": "Minimum plugin version required to load this schema"
        },
        "created": { "type": "string", "format": "date-time" },
        "lastModified": {
          "type": "string",
          "format": "date-time",
          "description": "Last modification timestamp"
        },
        "enable3dViewer": { "type": "boolean", "default": false },
        "downloading": { "$ref": "#/definitions/DownloadingConfig" },
        "instanceSolve": {
          "type": "boolean",
          "default": true,
          "description": "If true, changes trigger immediate solving. If false, user must press Calculate button."
        },
        "inputs": {
          "type": "array",
          "items": { "$ref": "#/definitions/InputParamSchema" }
        },
        "outputs": {
          "type": "array",
          "items": { "$ref": "#/definitions/OutputParamSchema" }
        },
        "layout": { "$ref": "#/definitions/LayoutConfig" }
      },
      "required": ["id", "name", "inputs", "outputs", "layout"],
      "additionalProperties": false
    }
  },

  "$ref": "#/definitions/UISchema"
}
