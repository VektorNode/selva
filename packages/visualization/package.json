{
	"name": "@selvajs/visualization",
	"version": "0.1.0",
	"description": "Headless, extensible viewer core for Selva — parse, scene, render and session layers over Three.js",
	"author": "VektorNode",
	"license": "MIT",
	"homepage": "https://github.com/VektorNode/selva#readme",
	"bugs": "https://github.com/VektorNode/selva/issues",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/VektorNode/selva.git",
		"directory": "packages/visualization"
	},
	"type": "module",
	"keywords": [
		"three",
		"threejs",
		"viewer",
		"cad",
		"geometry",
		"rhino",
		"grasshopper",
		"visualization",
		"webgl"
	],
	"main": "./dist/index.cjs",
	"module": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"exports": {
		".": {
			"import": {
				"types": "./dist/index.d.ts",
				"default": "./dist/index.js"
			},
			"require": {
				"types": "./dist/index.d.cts",
				"default": "./dist/index.cjs"
			}
		},
		"./shared": {
			"import": {
				"types": "./dist/shared.d.ts",
				"default": "./dist/shared.js"
			},
			"require": {
				"types": "./dist/shared.d.cts",
				"default": "./dist/shared.cjs"
			}
		},
		"./parse": {
			"import": {
				"types": "./dist/parse.d.ts",
				"default": "./dist/parse.js"
			},
			"require": {
				"types": "./dist/parse.d.cts",
				"default": "./dist/parse.cjs"
			}
		},
		"./render": {
			"import": {
				"types": "./dist/render.d.ts",
				"default": "./dist/render.js"
			},
			"require": {
				"types": "./dist/render.d.cts",
				"default": "./dist/render.cjs"
			}
		},
		"./session": {
			"import": {
				"types": "./dist/session.d.ts",
				"default": "./dist/session.js"
			},
			"require": {
				"types": "./dist/session.d.cts",
				"default": "./dist/session.cjs"
			}
		}
	},
	"files": [
		"dist",
		"README.md"
	],
	"sideEffects": false,
	"scripts": {
		"build": "pnpm type-check && pnpm clean && tsup",
		"dev": "tsup --watch",
		"clean": "node --input-type=module -e \"import fs from 'fs'; fs.rmSync('dist', { recursive: true, force: true })\"",
		"lint": "eslint .",
		"lint:fix": "eslint . --fix",
		"format": "prettier --write .",
		"format:check": "prettier --check .",
		"test": "vitest run",
		"test:watch": "vitest watch",
		"bench": "vitest bench --run",
		"type-check": "tsc --noEmit",
		"prepublishOnly": "pnpm build"
	},
	"dependencies": {
		"@selvajs/compute": "workspace:*",
		"@selvajs/schemas": "workspace:*",
		"fflate": "^0.8.2",
		"rhino3dm": "8.17.0"
	},
	"peerDependencies": {
		"three": ">=0.179.0"
	},
	"devDependencies": {
		"@eslint/js": "^10.0.1",
		"@types/node": "catalog:",
		"@types/three": "catalog:",
		"@vitest/coverage-v8": "^3.2.6",
		"eslint": "catalog:",
		"eslint-config-prettier": "^10.1.8",
		"globals": "^17.5.0",
		"prettier": "catalog:",
		"three": "catalog:",
		"tsup": "^8.5.1",
		"typescript": "catalog:",
		"vite": "catalog:",
		"vitest": "catalog:"
	},
	"engines": {
		"node": ">=22.0.0"
	}
}
