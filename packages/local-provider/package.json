{
	"name": "selva-local-provider",
	"version": "0.1.0",
	"description": "Local filesystem, JSON, and HMAC implementations of @selva/platform interfaces",
	"private": true,
	"type": "module",
	"main": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"import": "./dist/index.js"
		},
		"./auth": {
			"types": "./dist/auth/index.d.ts",
			"import": "./dist/auth/index.js"
		},
		"./organizations": {
			"types": "./dist/organizations/index.d.ts",
			"import": "./dist/organizations/index.js"
		},
		"./projects": {
			"types": "./dist/projects/index.d.ts",
			"import": "./dist/projects/index.js"
		},
		"./definitions": {
			"types": "./dist/definitions/index.d.ts",
			"import": "./dist/definitions/index.js"
		},
		"./storage": {
			"types": "./dist/storage/index.d.ts",
			"import": "./dist/storage/index.js"
		},
		"./computeServer": {
			"types": "./dist/computeServer/index.d.ts",
			"import": "./dist/computeServer/index.js"
		},
		"./data": {
			"types": "./dist/data/index.d.ts",
			"import": "./dist/data/index.js"
		}
	},
	"files": [
		"dist",
		"src"
	],
	"scripts": {
		"build": "tsc",
		"dev": "tsc --watch",
		"type-check": "tsc --noEmit",
		"test": "vitest run",
		"test:watch": "vitest"
	},
	"dependencies": {
		"@selva/platform": "workspace:*",
		"sharp": "^0.34.5",
		"zod": "^4.3.6"
	},
	"devDependencies": {
		"@types/node": "catalog:",
		"typescript": "catalog:",
		"vitest": "^2.1.8"
	}
}
