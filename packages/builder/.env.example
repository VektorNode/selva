# Runtime Mode Configuration
# Set to 'local' for development with Grasshopper WebSocket
# Set to 'compute' for production with Rhino Compute server
VITE_MODE=local

# Rhino Compute Server Configuration (for production/compute mode)
# URL of your Rhino Compute server
VITE_COMPUTE_SERVER_URL=http://localhost:5000

# Path to Grasshopper definition on the compute server
# This can be:
# - A URL to a .gh/.ghx file
# - A file path on the server
# - An uploaded file ID
VITE_GH_DEFINITION=

# Optional API key for Rhino Compute authentication
VITE_COMPUTE_API_KEY=""

# WebSocket Configuration (for local mode)
# Port for local Grasshopper WebSocket server
VITE_WEBSOCKET_PORT=8765
