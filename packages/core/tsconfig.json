{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    // Build output
    "outDir": "dist",

    // Build optimization
    "incremental": true,
    "tsBuildInfoFile": "./dist/.tsbuildinfo",

    // Path aliases - Use @/ for all internal imports
    "baseUrl": ".",
    "paths": {
      "@/*": ["./src/*"],
      "@tests/*": ["./tests/*"]
    }
  },
  "include": [
    "src/**/*",
    "tests/**/*",
    "../svelte-ui/src/lib/utils/input-grouping.ts",
    "../svelte-ui/src/lib/utils/input-grouping.test.ts"
  ],
  "exclude": ["node_modules", "dist"]
}
