{
  "name": "@computebuilder/core",
  "version": "1.0.3",
  "description": "TypeScript library for Rhino Compute Server - Grasshopper and RhinoCommon",
  "author": "VektorNode felix@vektornode.com",
  "license": "MIT",
  "type": "module",
  "keywords": [
    "compute",
    "rhino",
    "grasshopper",
    "geometry",
    "3d",
    "cad",
    "parametric",
    "modeling",
    "rhino3dm",
    "automation",
    "geometry-processing",
    "design",
    "cloud",
    "gh",
    "rhino.compute",
    "computational-design"
  ],
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./grasshopper": {
      "types": "./dist/grasshopper.d.ts",
      "import": "./dist/grasshopper.js",
      "require": "./dist/grasshopper.cjs"
    },
    "./visualization": {
      "types": "./dist/visualization.d.ts",
      "import": "./dist/visualization.js",
      "require": "./dist/visualization.cjs"
    },
    "./files": {
      "types": "./dist/files.d.ts",
      "import": "./dist/files.js",
      "require": "./dist/files.cjs"
    },
    "./core": {
      "types": "./dist/core.d.ts",
      "import": "./dist/core.js",
      "require": "./dist/core.cjs"
    },
    "./geometry": {
      "types": "./dist/geometry.d.ts",
      "import": "./dist/geometry.js",
      "require": "./dist/geometry.cjs"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE.md"
  ],
  "engines": {
    "node": ">=16"
  },
  "sideEffects": false,
  "scripts": {
    "build": " pnpm type-check && pnpm clean && tsup",
    "dev": "tsup --watch",
    "clean": "node -e \"require('fs').rmSync('dist', { recursive: true, force: true })\"",
    "test": "vitest",
    "test:watch": "vitest watch",
    "type-check": "tsc --noEmit",
    "gen:types": "node ./scripts/generate-types-from-rst.js",
    "playground": "pnpm exec tsx scripts/playground.ts"
  },
  "dependencies": {
    "compute-rhino3d": "0.13.0-beta",
    "fflate": "^0.8.2",
    "rhino3dm": "8.9.0"
  },
  "peerDependencies": {
    "three": ">=0.160.0"
  },
  "peerDependenciesMeta": {
    "three": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/node": "^22.18.10",
    "@types/three": "^0.179.0",
    "esbuild-plugin-file-path-extensions": "^2.1.4",
    "three": "^0.179.1",
    "tsup": "^8.5.0",
    "typescript": "^5.9.3",
    "vitest": "^3.2.4"
  }
}
