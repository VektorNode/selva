{
	"name": "@selvajs/compute",
	"version": "5.0.0-beta.10",
	"description": "TypeScript library for Rhino Compute Server - Grasshopper and RhinoCommon",
	"author": "VektorNode",
	"license": "MIT",
	"homepage": "https://selva.dev",
	"bugs": "https://github.com/VektorNode/selva/issues",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/VektorNode/selva.git",
		"directory": "packages/compute"
	},
	"type": "module",
	"keywords": [
		"compute",
		"rhino",
		"rhino-compute",
		"rhino.compute",
		"grasshopper",
		"parametric",
		"computational-design",
		"typescript"
	],
	"exports": {
		"./grasshopper": {
			"types": "./dist/grasshopper.d.ts",
			"default": "./dist/grasshopper.js"
		},
		"./core": {
			"types": "./dist/core.d.ts",
			"default": "./dist/core.js"
		}
	},
	"files": [
		"dist",
		"README.md",
		"LICENSE"
	],
	"engines": {
		"node": ">=24.0.0"
	},
	"publishConfig": {
		"access": "public"
	},
	"sideEffects": false,
	"scripts": {
		"build": "tsdown",
		"dev": "tsdown --watch",
		"lint": "eslint .",
		"lint:types": "eslint . --config eslint.typed.config.js",
		"test": "vitest run",
		"test:watch": "vitest",
		"test:live": "vitest run live.test",
		"type-check": "tsc --noEmit",
		"prepack": "publint --strict"
	},
	"dependencies": {
		"fflate": "catalog:"
	},
	"devDependencies": {
		"@selvajs/config": "workspace:*",
		"@types/node": "catalog:",
		"fast-check": "catalog:",
		"rhino3dm": "catalog:",
		"tsdown": "catalog:",
		"typedoc": "catalog:",
		"typescript": "catalog:",
		"vitest": "catalog:"
	}
}
