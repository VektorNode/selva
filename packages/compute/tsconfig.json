{
	"extends": "../../tsconfig.base.json",
	"compilerOptions": {
		"target": "ES2022",
		"lib": ["ES2022", "DOM", "DOM.Iterable"],
		"verbatimModuleSyntax": true,
		"paths": {
			"@/*": ["./src/*"],
			"@tests/*": ["./tests/*"]
		},
		"types": ["node"]
	},
	"include": ["src/**/*", "tests/**/*", "examples/**/*"]
}
