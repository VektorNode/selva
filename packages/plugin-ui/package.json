{
	"name": "@selvajs/plugin-ui",
	"description": "Selva Grasshopper plugin UI (schema builder + preview), embedded into Selva.gha",
	"private": true,
	"version": "0.10.0",
	"type": "module",
	"scripts": {
		"predev": "node ../../scripts/sync-shared-assets.js",
		"dev": "vite dev",
		"prebuild": "node ../../scripts/sync-shared-assets.js",
		"build": "vite build",
		"preview": "vite preview",
		"prepare": "svelte-kit sync || echo ''",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"type-check": "tsc --noEmit",
		"test": "vitest run",
		"test:watch": "vitest",
		"test:e2e": "playwright test"
	},
	"devDependencies": {
		"@lucide/svelte": "catalog:",
		"@playwright/test": "catalog:",
		"@selvajs/config": "workspace:*",
		"@sveltejs/adapter-static": "^3.0.10",
		"@types/three": "catalog:",
		"@types/ws": "catalog:",
		"tw-animate-css": "catalog:",
		"vitest": "catalog:",
		"ws": "catalog:"
	},
	"dependencies": {
		"@iconify/svelte": "catalog:",
		"@selvajs/compute": "workspace:^",
		"@selvajs/schemas": "workspace:*",
		"@selvajs/ui": "workspace:*",
		"bits-ui": "^2.18.0",
		"mode-watcher": "catalog:",
		"rhino3dm": "8.32.1",
		"svelte-dnd-action": "^0.9.78",
		"tailwind-variants": "^3.3.1",
		"three": "catalog:",
		"zod": "^4.3.6"
	}
}
