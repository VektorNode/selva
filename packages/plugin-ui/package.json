{
	"name": "@selvajs/plugin-ui",
	"description": "Selva Grasshopper plugin UI (schema builder + preview), embedded into Selva.gha",
	"private": true,
	"version": "0.10.0",
	"type": "module",
	"scripts": {
		"predev": "node ../../scripts/sync-shared-assets.js",
		"dev": "vite dev",
		"prebuild": "node ../../scripts/sync-shared-assets.js",
		"build": "vite build",
		"preview": "vite preview",
		"prepare": "svelte-kit sync || echo ''",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"test": "vitest run",
		"test:watch": "vitest",
		"test:e2e": "playwright test",
		"lint": "eslint .",
		"lint:types": "eslint . --config eslint.typed.config.js"
	},
	"devDependencies": {
		"@lucide/svelte": "catalog:",
		"@playwright/test": "catalog:",
		"@selvajs/config": "workspace:*",
		"@sveltejs/adapter-static": "^3.0.10",
		"@sveltejs/kit": "catalog:",
		"svelte-check": "catalog:",
		"@types/three": "catalog:",
		"@types/ws": "catalog:",
		"tw-animate-css": "catalog:",
		"vitest": "catalog:",
		"ws": "catalog:"
	},
	"dependencies": {
		"@iconify/svelte": "catalog:",
		"@selvajs/schemas": "workspace:*",
		"@selvajs/ui": "workspace:*",
		"@selvajs/visualization": "workspace:^",
		"bits-ui": "catalog:",
		"mode-watcher": "catalog:",
		"svelte-dnd-action": "^0.9.79",
		"tailwind-variants": "catalog:",
		"three": "catalog:",
		"zod": "catalog:"
	}
}
