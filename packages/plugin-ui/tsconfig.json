{
	"extends": "$app/tsconfig",
	"compilerOptions": {
		"rewriteRelativeImportExtensions": true,
		"sourceMap": true,
		"strict": true,
		// @selvajs/ui's published "." entry is the curated public SDK (dist/public).
		// Inside the monorepo we still use its full barrel — primitives, layout,
		// toast — so point type resolution at the full declarations. Scoped via
		// `paths` (not `customConditions: ["selva-source"]`, which would resolve every
		// workspace dep to raw source and re-attribute its type errors here).
		"paths": {
			"@selvajs/ui": ["../ui/dist/index.d.ts"]
		}
	},
	"include": ["src", "vite.config.ts"]
}
